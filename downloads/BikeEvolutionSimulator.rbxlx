      <Item class="ModuleScript" referent="192">
        <Properties>
          <string name="Name">EconomyController</string>
          <string name="Source"><![CDATA[--!strict
local Catalog=require(script.Parent.Catalog)
local Content=require(script.Parent.World1Content)
local PetRules=require(script.Parent.PetRules)
local Config=require(script.Parent.Config)
local Numbers=require(script.Parent.Numbers)
local E:any={};E.__index=E
function E.new(data:any,clock:()->number,random:()->number,guid:()->string,feedback:(any,any)->(),log:((any,string,string)->())?):any
 return setmetatable({Data=data,Clock=clock,Random=random,Guid=guid,Feedback=feedback,Log=log or function() end,Requests={},LastHatch={}},E)
end
function E.handle(self:any,player:any,payload:any): (boolean,string?)
 if type(payload)~="table" or type(payload.RequestId)~="number" or not Numbers.validRebirth(payload.RequestId) or payload.RequestId<1 then return false,"BadRequest" end
 if payload.RequestId<=(self.Requests[player] or 0) then return false,"DuplicateRequest" end
 self.Requests[player]=payload.RequestId
 local kind=payload.Action
 if kind=="Hatch" and self.Clock()-(self.LastHatch[player] or -math.huge)<1 then return false,"Cooldown" end
 if kind=="Hatch" then self.LastHatch[player]=self.Clock() end
 local result:any=nil
 local rejection="Unavailable"
 local species,instanceId=nil,nil
 if kind=="Hatch" then
  local generated,roll,id=pcall(function() return self.Random(),self.Guid() end)
  if not generated or type(roll)~="number" or type(id)~="string" or #id<1 or #id>64 then self.Log(player,"HatchGenerationFailed",if generated then "InvalidResult" else tostring(roll));return false,"ServiceUnavailable" end
  species=PetRules.roll(payload.EggId,roll);instanceId=id
  if not species then self.Log(player,"HatchGenerationFailed","InvalidRoll");return false,"ServiceUnavailable" end
 end
 local ok,reason=self.Data.change(player,function(data:any):boolean
  if kind=="BuyVehicle" then
   local v=Catalog.Vehicles[payload.VehicleId]
   if not v or not v.Playable or table.find(data.OwnedVehicles,payload.VehicleId) then rejection="AlreadyOwned";return false end
   if data.Cash<v.CashCost then rejection="NotEnoughCash";return false end
   data.Cash-=v.CashCost;table.insert(data.OwnedVehicles,payload.VehicleId)
  elseif kind=="EquipVehicle" then
   if not table.find(data.OwnedVehicles,payload.VehicleId) or not Content.Vehicles[payload.VehicleId] then return false end
   data.ActiveVehicle=payload.VehicleId
  elseif kind=="Hatch" then
   local egg=Catalog.Eggs[payload.EggId]
   if not egg or not egg.Playable or not table.find(data.OwnedWorlds,egg.WorldId) then return false end
   local count=0;for _ in pairs(data.Pets) do count+=1 end
   if count>=Config.Data.MaxPets then rejection="InventoryFull";return false end
   if data.Cash<egg.CashCost then rejection="NotEnoughCash";return false end
   if not species or not instanceId or data.Pets[instanceId] then return false end
   data.Cash-=egg.CashCost;data.Pets[instanceId]={SpeciesId=species,Variant="Normal"}
   if not table.find(data.DiscoveredPets,species) then table.insert(data.DiscoveredPets,species) end
   PetRules.equipHatched(data,instanceId)
   result={Kind="Hatched",SpeciesId=species,PetId=instanceId,EggId=payload.EggId}
  elseif kind=="EquipPet" then
   if not PetRules.stats(data.Pets[payload.PetId]) then rejection="PetUnavailable";return false end
   if table.find(data.EquippedPets,payload.PetId) then return false end
   if #data.EquippedPets>=Config.Rules.EquipSlots then rejection="EquipLimit";return false end
   table.insert(data.EquippedPets,payload.PetId)
  elseif kind=="EquipBest" or kind=="UnequipAll" then
   data.EquippedPets=if kind=="EquipBest" then PetRules.best(data) else {}
   result={Kind="PetEquipmentChanged",Action=kind,EquippedCount=#data.EquippedPets}
  elseif kind=="UnequipPet" then
   local index=table.find(data.EquippedPets,payload.PetId);if not index then return false end
   table.remove(data.EquippedPets,index)
  else return false end
  return true
 end,true)
 if ok then self.Feedback(player,result or {Kind="Purchase",Action=kind}) end
 return ok,if reason=="Rejected" then rejection else reason
end
function E.remove(self:any,player:any) self.Requests[player]=nil;self.LastHatch[player]=nil end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="193">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
local Format = {}
local suffixes={"","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc"}
function Format.number(value: number): string
 if value~=value or math.abs(value)==math.huge then return "—" end
 local sign=if value<0 then "-" else ""
 value=math.abs(value)
 local group=if value<1000 then 0 else math.floor(math.log10(value)/3)
 if group>=#suffixes then return sign..string.format("%.2e",value) end
 local scaled=value/10^(group*3)
 scaled=math.floor(scaled*10+0.5)/10
 if scaled>=1000 then scaled=1;group+=1 end
 if group>=#suffixes then return sign..string.format("%.2e",value) end
 local text=if scaled%1==0 then string.format("%.0f",scaled) else string.format("%.1f",scaled)
 return sign..text..suffixes[group+1]
end
function Format.multiplier(value:number):string
 if value~=value or math.abs(value)==math.huge then return "—" end
 if math.abs(value)>=1000 then return Format.number(value) end
 local text=string.format("%.3f",value)
 text=string.gsub(text,"0+$","");text=string.gsub(text,"%.$","")
 return text
end
return table.freeze(Format)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="194">
        <Properties>
          <string name="Name">Numbers</string>
          <string name="Source"><![CDATA[--!strict
local Numbers = {}
Numbers.Max = 1e300
Numbers.MaxRebirths = 9007199254740991 -- largest consecutive safe integer (2^53 - 1)
function Numbers.valid(value: number): boolean
 return value == value and value >= 0 and value <= Numbers.Max
end
function Numbers.validRebirth(value: number): boolean
 return Numbers.valid(value) and value <= Numbers.MaxRebirths and value % 1 == 0
end
function Numbers.multiply(a: number, b: number): number
 assert(Numbers.valid(a) and Numbers.valid(b), "Invalid numeric operand")
 if a == 0 or b == 0 then return 0 end
 return if a > Numbers.Max / b then Numbers.Max else math.min(a * b, Numbers.Max)
end
function Numbers.add(a: number, b: number): number
 assert(Numbers.valid(a) and Numbers.valid(b), "Invalid numeric operand")
 return if a > Numbers.Max - b then Numbers.Max else math.min(a + b, Numbers.Max)
end
function Numbers.power(base: number, exponent: number): number
 assert(Numbers.valid(base) and exponent >= 0 and exponent % 1 == 0 and exponent <= 1024, "Invalid power")
 local result = 1
 for _ = 1, exponent do result = Numbers.multiply(result, base) end
 return result
end
return table.freeze(Numbers)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="195">
        <Properties>
          <string name="Name">PetRules</string>
          <string name="Source"><![CDATA[--!strict
local Content=require(script.Parent.World1Content)
local Catalog=require(script.Parent.Catalog)
local Numbers=require(script.Parent.Numbers)
local Config=require(script.Parent.Config)
local Rules=require(script.Parent.Rules)
local Premium=require(script.Parent.PremiumConfig)
local Pets={}
function Pets.definition(pet:any):any
 return if pet.ExclusiveId then Premium.Exclusives[pet.ExclusiveId] else Catalog.Pets[pet.SpeciesId]
end
type Candidate={Id:string,Score:number,EquippedRank:number}
-- A pending catalogue species is locked, not an invented balancing value.
function Pets.stats(pet:any):{Energy:number,Cash:number,Score:number}?
 if type(pet)~="table" or type(pet.SpeciesId)~="number" or pet.SpeciesId%1~=0 then return nil end
 local definition=Pets.definition(pet)
 local factor=Content.Variants[pet.Variant]
 if not definition or not definition.Playable or not factor then return nil end
 local energy=Numbers.add(1,Numbers.multiply(definition.EnergyMultiplier-1,factor))
 local cash=Numbers.add(1,Numbers.multiply(definition.CashMultiplier-1,factor))
 return {Energy=energy,Cash=cash,Score=Numbers.add((energy-1)/2,(cash-1)/2)}
end
function Pets.bonus(data:any,kind:string):number
 local total=1
 for _,id in ipairs(data.EquippedPets) do
  local stats=Pets.stats(data.Pets[id])
  if stats then total=Numbers.add(total,(if kind=="Energy" then stats.Energy else stats.Cash)-1) end
 end
 return total
end
function Pets.best(data:any):{string}
 local candidates:{Candidate}={}
 for id,pet in pairs(data.Pets) do
  local stats=Pets.stats(pet)
  if stats then table.insert(candidates,{Id=id,Score=stats.Score,EquippedRank=table.find(data.EquippedPets,id) or Config.Rules.EquipSlots+1}) end
 end
 table.sort(candidates,function(a:Candidate,b:Candidate):boolean
  if a.Score~=b.Score then return a.Score>b.Score end
  if a.EquippedRank~=b.EquippedRank then return a.EquippedRank<b.EquippedRank end
  return a.Id<b.Id
 end)
 local ids={}
 for i=1,math.min(Config.Rules.EquipSlots,#candidates) do table.insert(ids,candidates[i].Id) end
 return ids
end
-- Only called inside the same transaction that grants a genuinely new hatch.
function Pets.equipHatched(data:any,id:string):boolean
 if #data.EquippedPets>=Config.Rules.EquipSlots or table.find(data.EquippedPets,id) or not Pets.stats(data.Pets[id]) then return false end
 table.insert(data.EquippedPets,id);return true
end
-- Server-only integration helper for the existing future fusion recipes; no new machine/remote.
-- Invoke on a transaction candidate with InventoryRevision incremented, never on live shared data.
function Pets.fuse(data:any,ids:{string},newId:string):boolean
 if type(newId)~="string" or #newId<1 or #newId>64 or data.Pets[newId] then return false end
 local result=Rules.fusion(data.Pets,ids)
 if not result or not Pets.stats(result) or not table.find(data.OwnedWorlds,Content.FusionWorlds[result.Variant]) then return false end
 local consumed:{[string]:boolean}={};for _,id in ipairs(ids) do consumed[id]=true end
 local equipped={};local replacement=false
 for _,id in ipairs(data.EquippedPets) do
  if consumed[id] then
   if not replacement then table.insert(equipped,newId);replacement=true end
  else table.insert(equipped,id) end
 end
 for _,id in ipairs(ids) do data.Pets[id]=nil end
 data.Pets[newId]=result;data.EquippedPets=equipped
 return true
end
function Pets.roll(eggId:number,roll:number):number?
 local egg=Catalog.Eggs[eggId]
 if not egg or not egg.Playable or roll%1~=0 or roll<1 or roll>10000 then return nil end
 local sum=0
 for i,weight in ipairs(egg.Weights :: {number}) do sum+=weight;if roll<=sum then return egg.Species[i] end end
 return nil
end
return table.freeze(Pets)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="196">
        <Properties>
          <string name="Name">PremiumConfig</string>
          <string name="Source"><![CDATA[--!strict
-- IDs must be supplied by the experience owner. Zero disables purchase prompts.
local C:any={ReceiptLimit=2000,MaxBoostSeconds=86400,
 Passes={Energy={Id=0,Name="2× Energy",SuggestedRobux=149},Cash={Id=0,Name="2× Cash",SuggestedRobux=149},VIP={Id=0,Name="VIP • zukünftiger Inhalt",SuggestedRobux=399,Unavailable=true}},
 Products={
  Small={Id=0,Name="5.000 Cash",Category="Cash Bundles",Cash=5000,SuggestedRobux=29},
  Medium={Id=0,Name="25.000 Cash",Category="Cash Bundles",Cash=25000,SuggestedRobux=99},
  Large={Id=0,Name="150.000 Cash",Category="Cash Bundles",Cash=150000,SuggestedRobux=299},
  EnergyPotion={Id=0,Name="2× Energy • 5 Minuten",Category="Boost Potions",Boost="Energy",Seconds=300,SuggestedRobux=19},
  CashPotion={Id=0,Name="2× Cash • 5 Minuten",Category="Boost Potions",Boost="Cash",Seconds=300,SuggestedRobux=19},
  PrismRay={Id=0,Name="Prism Ray",Category="Exclusive Pets",ExclusiveId="PrismRay",SuggestedRobux=299},
  Sunfox={Id=0,Name="Solar Sunfox",Category="Exclusive Pets",ExclusiveId="Sunfox",SuggestedRobux=299},
 },
 Exclusives={PrismRay={Name="Prism Ray",Rarity="Exclusive",EnergyMultiplier=2.8,CashMultiplier=3.2,Model="ExclusivePrismRay",Playable=true},Sunfox={Name="Solar Sunfox",Rarity="Exclusive",EnergyMultiplier=3,CashMultiplier=2.8,Model="ExclusiveSunfox",Playable=true}},
}
local function freeze(t:any):any for _,v in pairs(t) do if type(v)=="table" then freeze(v) end end;return table.freeze(t) end
return freeze(C)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="197">
        <Properties>
          <string name="Name">PremiumRules</string>
          <string name="Source"><![CDATA[--!strict
local Config=require(script.Parent.PremiumConfig)
local Numbers=require(script.Parent.Numbers)
local Pets=require(script.Parent.PetRules)
local Rules={}
function Rules.registryValid(config:any):boolean
 for _,group in ipairs({config.Products,config.Passes}) do
  local seen={}
  for _,def in pairs(group) do
   if type(def.Id)~="number" or def.Id%1~=0 or def.Id<0 or def.Id>9007199254740991 then return false end
   if def.Id>0 and seen[def.Id] then return false end
   if def.Id>0 then seen[def.Id]=true end
  end
 end
 return true
end
function Rules.product(id:number):any
 if type(id)~="number" or id%1~=0 or id<=0 then return nil end
 for _,p in pairs(Config.Products) do if p.Id==id then return p end end
 return nil
end
function Rules.bonus(data:any,kind:string,pass:boolean?):number
 return (if pass then 2 else 1)*(if data.Boosts and (data.Boosts[kind] or 0)>0 then 2 else 1)
end
function Rules.grant(data:any,receipt:string,productId:number,definition:any,petId:string):boolean
 if type(receipt)~="string" or #receipt==0 or #receipt>128 or type(productId)~="number" or productId<=0 or productId%1~=0 then return false end
 if data.Receipts[receipt] then return data.Receipts[receipt]==productId end
 local count=0;for _ in pairs(data.Receipts) do count+=1 end
 if count>=Config.ReceiptLimit then return false end
 if definition.Cash then
  if data.Cash>Numbers.Max-definition.Cash then return false end
  local after=Numbers.add(data.Cash,definition.Cash)
  if after-data.Cash~=definition.Cash then return false end
  data.Cash=after
 elseif definition.Boost then
  local current=data.Boosts[definition.Boost]
  if not current or current+definition.Seconds>Config.MaxBoostSeconds then return false end
  data.Boosts[definition.Boost]=current+definition.Seconds
 elseif definition.ExclusiveId then
  local n=0;for _ in pairs(data.Pets) do n+=1 end
  if n>=500 or data.Pets[petId] or #petId==0 or #petId>64 or not Config.Exclusives[definition.ExclusiveId] then return false end
  data.Pets[petId]={SpeciesId=0,ExclusiveId=definition.ExclusiveId,Variant="Normal"};Pets.equipHatched(data,petId)
 else return false end
 data.Receipts[receipt]=productId
 return true
end
return table.freeze(Rules)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="198">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[--!strict
local Catalog=require(script.Parent.Catalog)
local Rules=require(script.Parent.Rules)
local Config=require(script.Parent.Config)
local P={}
function P.training(snapshot: any): any
 local selected=snapshot.SelectedTreadmill or 0
 local nextId=if selected==0 then 1 else selected+1
 local nextT=Catalog.Treadmills[nextId]
 if nextId>5 then return {Current=selected,Gain=snapshot.ImpulseGain or 0,Complete=true,Ratio=1,Missing=0,Next=0,RebirthRequirement=0} end
 local rebirthReady=snapshot.Rebirths>=nextT.RebirthRequirement
 return {Current=selected,Gain=snapshot.ImpulseGain or 0,Complete=false,Next=nextId,
  Missing=math.max(0,nextT.EnergyRequirement-snapshot.Energy),RebirthRequirement=nextT.RebirthRequirement,
  Ratio=if rebirthReady or nextT.EnergyRequirement==0 then 1 else math.clamp(snapshot.Energy/nextT.EnergyRequirement,0,1)}
end
function P.rebirth(snapshot: any): any
 local requirement=Rules.rebirthRequirement(snapshot.Rebirths)
 return {Current=snapshot.Rebirths,Multiplier=Rules.trainingGain(snapshot.Rebirths),NextMultiplier=Rules.trainingGain(snapshot.Rebirths)+0.5,
  Requirement=requirement,Ratio=math.clamp(snapshot.Energy/requirement,0,1),Allowed=snapshot.Rebirths<Config.Numbers.MaxRebirths and snapshot.Energy>=requirement}
end
return table.freeze(P)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="199">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Config)
local Numbers = require(script.Parent.Numbers)
local Premium=require(script.Parent.PremiumConfig)
local Profile = {}
export type Snapshot = { Energy: number, Cash: number, Rebirths: number }
export type Pet = { SpeciesId: number, Variant: string, ExclusiveId: string? }
export type Data = {
 SchemaVersion: number, Energy: number, Cash: number, Rebirths: number,
 OwnedWorlds: {number}, OwnedVehicles: {number}, Pets: {[string]: Pet}, EquippedPets: {string}, ActiveVehicle: number, DiscoveredPets: {number}, LastRaceReward: string, Boosts: {[string]:number}, Receipts: {[string]:number},
}
local function numberIn(value: any, maximum: number, integer: boolean)
 return type(value) == "number" and value == value and value >= 0 and value <= maximum and (not integer or value % 1 == 0)
end
local function arrayValid(value: any, maximum: number, predicate: (any) -> boolean)
 if type(value) ~= "table" or #value > maximum then return false end
 local count, seen = 0, {}
 for key, item in pairs(value) do
  count += 1
  if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #value or seen[item] or not predicate(item) then return false end
  seen[item] = true
 end
 return count == #value
end
function Profile.new(): Data
 return { SchemaVersion = Config.Data.SchemaVersion, Energy = 0, Cash = 0, Rebirths = 0,
  OwnedWorlds = {1}, OwnedVehicles = {1}, Pets = {}, EquippedPets = {}, ActiveVehicle = 1, DiscoveredPets = {}, LastRaceReward = "", Boosts={Energy=0,Cash=0}, Receipts={} }
end
local function validate(data: any, legacy: boolean): boolean
 if type(data) ~= "table" or data.SchemaVersion ~= (if legacy then 1 else Config.Data.SchemaVersion) then return false end
 if not numberIn(data.Energy, Config.Numbers.MaxBalance, false) or not numberIn(data.Cash, Config.Numbers.MaxBalance, false) or (type(data.Rebirths) ~= "number" or not Numbers.validRebirth(data.Rebirths)) then return false end
 if not arrayValid(data.OwnedWorlds, 8, function(id: any) return numberIn(id, 8, true) and id >= 1 end) then return false end
 if not arrayValid(data.OwnedVehicles, 40, function(id: any) return numberIn(id, 40, true) and id >= 1 end) then return false end
 if not table.find(data.OwnedWorlds, 1) or not table.find(data.OwnedVehicles, 1) or type(data.Pets) ~= "table" then return false end
 local count = 0
 for id, raw in pairs(data.Pets) do
  local pet: any = raw
  count += 1
  if count > Config.Data.MaxPets or type(id) ~= "string" or #id == 0 or #id > 64 or type(pet) ~= "table" then return false end
  if pet.ExclusiveId~=nil then
   if legacy or pet.SpeciesId~=0 or type(pet.ExclusiveId)~="string" or not Premium.Exclusives[pet.ExclusiveId] then return false end
  elseif not numberIn(pet.SpeciesId, 96, true) or pet.SpeciesId < 1 then return false end
  if pet.Variant ~= "Normal" and pet.Variant ~= "Golden" and pet.Variant ~= "Rainbow" then return false end
 end
 if not legacy then
  if type(data.LastRaceReward)~="string" or #data.LastRaceReward>100 then return false end
  if not numberIn(data.ActiveVehicle,40,true) or not table.find(data.OwnedVehicles,data.ActiveVehicle) then return false end
  if not arrayValid(data.DiscoveredPets,96,function(id:any) return numberIn(id,96,true) and id>=1 end) then return false end
  local discovered: {[number]:boolean}={}
  for _,id in ipairs(data.DiscoveredPets :: {number}) do discovered[id]=true end
  for _,rawPet in pairs(data.Pets) do local pet:any=rawPet;if not pet.ExclusiveId and not discovered[pet.SpeciesId] then return false end end
 end
 return arrayValid(data.EquippedPets, Config.Rules.EquipSlots, function(id) return type(id) == "string" and data.Pets[id] ~= nil end)
end
function Profile.validate(data: any): boolean
 if not validate(data,false) then return false end
 if type(data.Boosts)~="table" or type(data.Receipts)~="table" then return false end
 for k in pairs(data.Boosts) do if k~="Energy" and k~="Cash" then return false end end
 for _,k in ipairs({"Energy","Cash"}) do if not numberIn(data.Boosts[k],Premium.MaxBoostSeconds,false) then return false end end
 local count=0
 for id,product in pairs(data.Receipts) do
  count+=1
  if count>Premium.ReceiptLimit or type(id)~="string" or #id<1 or #id>128 or not numberIn(product,9007199254740991,true) or product==0 then return false end
 end
 return true
end
function Profile.copy(data: Data): Data
 local pets = {}
 for id, pet in pairs(data.Pets) do pets[id] = { SpeciesId = pet.SpeciesId, Variant = pet.Variant, ExclusiveId=pet.ExclusiveId } end
 return { SchemaVersion = data.SchemaVersion, Energy = data.Energy, Cash = data.Cash, Rebirths = data.Rebirths,
  OwnedWorlds = table.clone(data.OwnedWorlds), OwnedVehicles = table.clone(data.OwnedVehicles),
  Pets = pets, EquippedPets = table.clone(data.EquippedPets), ActiveVehicle = data.ActiveVehicle, DiscoveredPets = table.clone(data.DiscoveredPets), LastRaceReward = data.LastRaceReward, Boosts=table.clone(data.Boosts), Receipts=table.clone(data.Receipts) }
end
function Profile.migrate(raw: any): Data?
 if type(raw)~="table" then return nil end
 if raw.SchemaVersion==Config.Data.SchemaVersion then return if Profile.validate(raw) then Profile.copy(raw) else nil end
 if raw.SchemaVersion==2 then
  local prior:any=table.clone(raw);prior.SchemaVersion=Config.Data.SchemaVersion
  if not validate(prior,false) then return nil end
  -- Schema 2 never accepted premium pets. Do not accept malformed old records.
  for _,rawPet in pairs(raw.Pets) do local pet:any=rawPet;if pet.ExclusiveId~=nil then return nil end end
  prior.Boosts={Energy=0,Cash=0};prior.Receipts={}
  return if Profile.validate(prior) then Profile.copy(prior) else nil
 end
 if not validate(raw,true) then return nil end
 local enriched:any=table.clone(raw)
 enriched.SchemaVersion=Config.Data.SchemaVersion;enriched.ActiveVehicle=1;enriched.DiscoveredPets={};enriched.LastRaceReward="";enriched.Boosts={Energy=0,Cash=0};enriched.Receipts={}
 for _,rawPet in pairs(raw.Pets) do local pet:any=rawPet;if not table.find(enriched.DiscoveredPets,pet.SpeciesId) then table.insert(enriched.DiscoveredPets,pet.SpeciesId) end end
 table.sort(enriched.DiscoveredPets)
 return Profile.copy(enriched)
end
function Profile.snapshot(data: Data): Snapshot
 return { Energy = data.Energy, Cash = data.Cash, Rebirths = data.Rebirths }
end
return table.freeze(Profile)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="200">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
local Config=require(script.Parent.Config)
local Numbers=require(script.Parent.Numbers)
local P={}
-- Fourfold difficulty is applied ONCE, not exponentially to an already exponential curve.
-- Growing per-tier dwell time, matched to doubling training output. Baseline 9.55h to belt 40.
function P.energy(id:number):number
 if id==1 then return 0 end
 return Numbers.multiply(Config.Treadmills.Difficulty,Numbers.multiply(Config.Treadmills.EnergyBase,Numbers.multiply(id-1,Numbers.power(2,id-2))))
end
function P.islandSpeed(energy:number,vehicle:number,slow:boolean):number
 if not Numbers.valid(energy) or not Numbers.valid(vehicle) then return Config.Bike.BaseSpeed end
 local speed=math.min(Config.Bike.MaxSpeed,(Config.Bike.BaseSpeed+math.min(14,math.log10(1+energy)*2.2))*math.sqrt(vehicle))
 return if slow then math.min(12,speed) else speed
end
return table.freeze(P)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="201">
        <Properties>
          <string name="Name">Protocol</string>
          <string name="Source"><![CDATA[--!strict
local Protocol = {}
-- Clients send intents only. Amounts, positions, identity and timing are server-owned.
Protocol.Remotes = table.freeze({ Drive = "RemoteEvent", DriveState = "RemoteEvent", GetSnapshot = "RemoteFunction", SnapshotChanged = "RemoteEvent", Action = "RemoteEvent", ActionResult = "RemoteEvent", Feedback = "RemoteEvent" })
function Protocol.validRequest(payload: any): boolean
 if type(payload) ~= "table" or payload.Version ~= 1 then return false end
 local count = 0
 for _ in pairs(payload) do
  count += 1
  if count > 1 then return false end
 end
 return count == 1
end
local function integer(value:any,max:number):boolean
 return type(value)=="number" and value%1==0 and value>=1 and value<=max
end
function Protocol.validAction(payload:any):boolean
 if type(payload)~="table" or payload.Version~=1 then return false end
 if payload.Action=="Automation" then
  local allowed={Version=true,Action=true,Setting=true,Enabled=true,Difficulty=true}
  for key in pairs(payload) do if not allowed[key] then return false end end
  return (payload.Setting=="AutoTrain" or payload.Setting=="AutoRace" or payload.Setting=="SlowMode") and type(payload.Enabled)=="boolean" and (payload.Difficulty==nil or payload.Difficulty=="Easy" or payload.Difficulty=="Medium" or payload.Difficulty=="Hard")
 end
 if payload.Action=="Premium" then
  local n=0;for key in pairs(payload) do n+=1;if key~="Version" and key~="Action" and key~="Offer" then return false end end
  return n==3 and type(payload.Offer)=="string" and #payload.Offer<=32
 end
 local specifications:any={Select={TreadmillId=5},BuyVehicle={VehicleId=10},EquipVehicle={VehicleId=10},Hatch={EggId=3},EquipPet={PetId=true},UnequipPet={PetId=true},EquipBest={},UnequipAll={}}
 local spec=specifications[payload.Action]
 local economic=payload.Action=="BuyVehicle" or payload.Action=="EquipVehicle" or payload.Action=="Hatch" or payload.Action=="EquipPet" or payload.Action=="UnequipPet" or payload.Action=="EquipBest" or payload.Action=="UnequipAll"
 local allowed:any={Version=true,Action=true}
 if spec then for key,max in pairs(spec) do
  allowed[key]=true
  if max==true then if type(payload[key])~="string" or #payload[key]<1 or #payload[key]>64 then return false end
  elseif not integer(payload[key],max :: number) then return false end
 end end
 if economic then allowed.RequestId=true;if not integer(payload.RequestId,9007199254740991) then return false end end
 if payload.Action=="StartRace" then allowed.Difficulty=true;if payload.Difficulty~=nil and payload.Difficulty~="Easy" and payload.Difficulty~="Medium" and payload.Difficulty~="Hard" then return false end end
 if not spec and payload.Action~="Click" and payload.Action~="Stop" and payload.Action~="Rebirth" and payload.Action~="StartRace" and payload.Action~="AbortRace" then return false end
 local count=0
 for key in pairs(payload) do count+=1;if count>4 or not allowed[key] then return false end end
 return true
end
function Protocol.validDrive(payload:any):boolean
 if type(payload)~="table" or payload.Version~=1 or not integer(payload.Sequence,9007199254740991) or type(payload.Brake)~="boolean" then return false end
 for _,key in ipairs({"Throttle","Steer"}) do
  local v=payload[key];if type(v)~="number" or v~=v or math.abs(v)>1 then return false end
 end
 if payload.JumpId~=nil and (type(payload.JumpId)~="number" or payload.JumpId%1~=0 or payload.JumpId<0 or payload.JumpId>9007199254740991) then return false end
 if payload.Epoch~=nil and not integer(payload.Epoch,9007199254740991) then return false end
 local allowed={Version=true,Sequence=true,Throttle=true,Steer=true,Brake=true,JumpId=true,Epoch=true}
 for key in pairs(payload) do if not allowed[key] then return false end end
 return true
end
function Protocol.validSnapshot(payload: any): boolean
 if type(payload) ~= "table" then return false end
 for _, key in ipairs({ "Energy", "Cash", "Rebirths" }) do
  local value = payload[key]
  if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then return false end
 end
 return true
end
return table.freeze(Protocol)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="202">
        <Properties>
          <string name="Name">RaceController</string>
          <string name="Source"><![CDATA[--!strict
local Course=require(script.Parent.RaceCourse)
local Numbers=require(script.Parent.Numbers)
local Config=require(script.Parent.Config)
local Test=Config.Race.Test
local Content=require(script.Parent.World1Content)
local RaceRules=require(script.Parent.RaceRules)
local Controller:any={};Controller.__index=Controller
function Controller.speed(energy: number): number
 assert(Numbers.valid(energy),"Invalid race energy")
 -- Bounded logarithmic curve: no huge-number overflow, no client speed input.
 return Test.BaseSpeed+math.min(Test.SpeedBonusCap,math.log10(1+energy)*Test.EnergyFactor)
end
function Controller.new(adapter: any,clock: () -> number): any
 return setmetatable({Adapter=adapter,Clock=clock,States={},Cooldowns={},Sequence=0},Controller)
end
function Controller.finish(self:any,player:any,reason:string)
 local state=self.States[player];if not state then return end
 self.States[player]=nil;self.Cooldowns[player]=self.Clock()+2
 local ok,err=pcall(self.Adapter.cleanup,player,state,reason)
 if not ok then self.Adapter.log("RaceCleanupFailed",tostring(err)) end
end
function Controller.start(self:any,player:any,difficulty:string?): (boolean,string?)
 if self.States[player] then return false,"AlreadyRacing" end
 if (self.Cooldowns[player] or 0)>self.Clock() then return false,"Cooldown" end
 local data=self.Adapter.profile(player)
 if not data or type(data.Energy)~="number" or not Numbers.valid(data.Energy) or not self.Adapter.nearStart(player) or not table.find(data.OwnedVehicles,data.ActiveVehicle or 1) or not Content.Vehicles[data.ActiveVehicle or 1] then return false,"RaceUnavailable" end
 if difficulty~=nil and not Content.Difficulties[difficulty] then return false,"BadRequest" end
 self.Sequence+=1
 local state={Id=self.Sequence,Started=self.Clock(),Last=self.Clock(),Distance=0,Speed=0,Target=Controller.speed(data.Energy)*(if Content.Vehicles[data.ActiveVehicle or 1] then Content.Vehicles[data.ActiveVehicle or 1].Speed else 1),Phase="Countdown",WorldId=1,Difficulty=difficulty or "Test",Bots={},VehicleId=data.ActiveVehicle or 1,Reward=0}
 if difficulty then for i,speed in ipairs(Content.Difficulties[difficulty].Speeds) do table.insert(state.Bots,{Id=i,Speed=speed,Distance=0}) end end
 self.States[player]=state -- reserve before spawning anything; simultaneous starts are refused
 local ok,err=pcall(self.Adapter.begin,player,state)
 if not ok then self:finish(player,"Error");self.Adapter.log("RaceBeginFailed",tostring(err));return false,"RaceUnavailable" end
 return true,nil
end
function Controller.tick(self:any)
 for player,state in pairs(self.States) do
  local now=self.Clock()
  -- Count only the elapsed portion after GO; a delayed tick cannot grant a head start.
  local rideStart=state.Started+Test.Countdown
  local dt=math.clamp(now-math.max(state.Last,rideStart),0,0.25);state.Last=now
  local checked,valid=pcall(self.Adapter.valid,player,state)
  if not checked or not valid then
   if not checked then self.Adapter.log("RaceValidationFailed",tostring(valid)) end
   self:finish(player,"Aborted");continue
  end
  if now-state.Started>Test.Timeout then self:finish(player,"Timeout");continue end
  if now-state.Started>=Test.Countdown then
   for _,bot in ipairs(state.Bots) do
    if not bot.FinishedAt then
     local previous=bot.Distance
     bot.Distance=math.min(Course.Length,bot.Distance+bot.Speed*dt)
     if bot.Distance>=Course.Length then bot.FinishedAt=now-dt+(Course.Length-previous)/bot.Speed end
    end
   end
  end
  if state.FinishedAt then
   state.Speed=0;state.Phase="Arrived"
  elseif now-state.Started>=Test.Countdown then
   state.Phase="Riding"
   local target=math.min(state.Target,math.max(6,(Course.Length-state.Distance)*1.8))
   if state.Speed<target then state.Speed=math.min(target,state.Speed+dt*12) else state.Speed=math.max(target,state.Speed-dt*18) end
   local previous=state.Distance
   state.Distance=math.min(Course.Length,state.Distance+state.Speed*dt)
   if state.Distance>=Course.Length then state.FinishedAt=now-dt+(Course.Length-previous)/math.max(state.Speed,0.001);state.Place=RaceRules.position(state);state.Speed=0;state.Phase="Arrived" end
  end
  local ok,err=pcall(self.Adapter.move,player,state,Course.sample(state.Distance))
  if not ok then self:finish(player,"Error");self.Adapter.log("RaceMoveFailed",tostring(err))
  elseif state.FinishedAt and now-state.FinishedAt>=0.6 then
   if state.Difficulty=="Test" then self:finish(player,"Finished")
   elseif not state.LastPayAttempt or now-state.LastPayAttempt>=0.5 then
    state.LastPayAttempt=now
    local paid,accepted,amount=pcall(self.Adapter.reward,player,state)
    if paid and accepted then state.Reward=amount;self:finish(player,"Finished")
    else
     if not state.RewardFailureLogged then
      state.RewardFailureLogged=true;self.Adapter.log("RaceRewardRetry",if paid then "Profile transaction unavailable" else tostring(accepted))
     end
     if now-state.FinishedAt>10 then self.Adapter.log("RaceRewardUnavailable",tostring(state.RewardId));self:finish(player,"RewardUnavailable") end
    end
   end
  end
 end
end
function Controller.remove(self:any,player:any) self:finish(player,"Disconnect");self.Cooldowns[player]=nil end
return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">RaceCourse</string>
          <string name="Source"><![CDATA[--!strict
local points=require(script.Parent.CourseData)
local Course={Points=points,Length=0}
local lengths={0}
for i=2,#points do
 local a,b=points[i-1],points[i]
 Course.Length+=math.sqrt((b.X-a.X)^2+(b.Y-a.Y)^2+(b.Z-a.Z)^2)
 lengths[i]=Course.Length
end
function Course.sample(distance: number): any
 distance=math.clamp(distance,0,Course.Length)
 local low,high=2,#points
 while low<high do local middle=math.floor((low+high)/2);if lengths[middle]<distance then low=middle+1 else high=middle end end
 local a,b=points[low-1],points[low]
 local segment=lengths[low]-lengths[low-1];local t=(distance-lengths[low-1])/segment
 return {X=a.X+(b.X-a.X)*t,Y=a.Y+(b.Y-a.Y)*t,Z=a.Z+(b.Z-a.Z)*t,DX=(b.X-a.X)/segment,DY=(b.Y-a.Y)/segment,DZ=(b.Z-a.Z)/segment}
end
return table.freeze(Course)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="204">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--!strict
local Content=require(script.Parent.World1Content)
local PetRules=require(script.Parent.PetRules)
local Numbers=require(script.Parent.Numbers)
local Premium=require(script.Parent.PremiumRules)
local Rules={}
function Rules.position(state:any):number
 local rank=1
 for _,bot in ipairs(state.Bots) do
  if state.FinishedAt then
   if bot.FinishedAt and bot.FinishedAt<=state.FinishedAt then rank+=1 end
  elseif bot.Distance>state.Distance then rank+=1 end
 end
 return rank
end
function Rules.reward(data:any,state:any):number
 local world=Content.RaceWorlds[state.WorldId or 1]
 if not world or not world.Playable then return 0 end
 local tier=Content.Difficulties[state.Difficulty]
 if not tier or not state.FinishedAt then return 0 end
 local base=tier.Rewards[state.Place]
 if not base then return 0 end
 return Numbers.multiply(Numbers.multiply(base,world.RewardMultiplier),Numbers.multiply(PetRules.bonus(data,"Cash"),Premium.bonus(data,"Cash",state.CashPass)))
end
function Rules.pay(data:any,state:any): (boolean,number)
 if type(state.RewardId)~="string" or #state.RewardId==0 or #state.RewardId>100 then return false,0 end
 local amount=Rules.reward(data,state)
 if amount<=0 then return false,0 end
 if data.LastRaceReward==state.RewardId then return true,0 end
 local before=data.Cash
 data.Cash=Numbers.add(before,amount);data.LastRaceReward=state.RewardId
 -- At the finite currency cap, report only what was actually credited.
 return true,data.Cash-before
end
return table.freeze(Rules)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="205">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict
local Limiter: any = {}
Limiter.__index = Limiter
function Limiter.new(capacity: number, refill: number, clock: () -> number): any
 return setmetatable({Capacity=capacity, Refill=refill, Clock=clock, Buckets={}}, Limiter)
end
function Limiter.allow(self: any, key: any): boolean
 local now = self.Clock()
 local bucket = self.Buckets[key] or {Tokens=self.Capacity, At=now}
 self.Buckets[key] = bucket
 bucket.Tokens = math.min(self.Capacity, bucket.Tokens + math.max(0, now-bucket.At)*self.Refill)
 bucket.At = now
 if bucket.Tokens < 1 then return false end
 bucket.Tokens -= 1
 return true
end
function Limiter.remove(self: any, key: any) self.Buckets[key] = nil end
return Limiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="206">
        <Properties>
          <string name="Name">RideReconciliation</string>
          <string name="Source"><![CDATA[--!strict
local Config=require(script.Parent.Config)
local Sim=require(script.Parent.RideSimulation)
local Reconcile={}
function Reconcile.new():any return {Epoch=0,Ack=0,Sequence=0,Pending={},State=nil} end
function Reconcile.command(r:any,sequence:number,input:any,maxSpeed:number,scene:any)
 if not r.State then return end
 table.insert(r.Pending,{Sequence=sequence,Input=table.clone(input)})
 if #r.Pending>Config.Bike.PendingLimit then table.remove(r.Pending,1) end
 r.State=Sim.command(r.State,input,maxSpeed,scene)
end
function Reconcile.valid(message:any):boolean
 if type(message)~="table" or not Sim.valid(message.State) or type(message.Epoch)~="number" or message.Epoch%1~=0 or message.Epoch<1 or type(message.Ack)~="number" or message.Ack%1~=0 or message.Ack<1 or type(message.Sequence)~="number" or message.Sequence%1~=0 or message.Sequence<0 or type(message.MaxSpeed)~="number" or message.MaxSpeed<1 or message.MaxSpeed>Config.Bike.MaxSpeed then return false end
 return message.Mode=="Manual" or message.Mode=="Race"
end
function Reconcile.accept(r:any,message:any,scene:any):boolean
 if not Reconcile.valid(message) then return false end
 if message.Epoch<r.Epoch or message.Epoch==r.Epoch and (message.Ack<=r.Ack or message.Sequence<r.Sequence) then return false end
 if message.Epoch~=r.Epoch then r.Pending={} end
 r.Epoch=message.Epoch;r.Ack=message.Ack;r.Sequence=message.Sequence
 local pending={};local state=table.clone(message.State)
 for _,command in ipairs(r.Pending) do
  if command.Sequence>message.Sequence then table.insert(pending,command);state=Sim.command(state,command.Input,message.MaxSpeed,scene) end
 end
 r.Pending=pending;r.State=state
 return true
end
return table.freeze(Reconcile)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="207">
        <Properties>
          <string name="Name">RideSimulation</string>
          <string name="Source"><![CDATA[--!strict
-- Shared deterministic kinematics. Only server state grants access, rewards or training.
local Config=require(script.Parent.Config)
local Motion=require(script.Parent.BikeMotion)
local Sim={}
export type State={X:number,Y:number,Z:number,Yaw:number,Speed:number,VY:number,Grounded:boolean,JumpId:number,JumpCooldown:number,Distance:number}
function Sim.new(x:number,y:number,z:number,yaw:number):State
 return {X=x,Y=y,Z=z,Yaw=yaw,Speed=0,VY=0,Grounded=true,JumpId=0,JumpCooldown=0,Distance=0}
end
function Sim.step(old:State,input:any,dt:number,maxSpeed:number,scene:any):State
 local s:State=table.clone(old);local cfg=Config.Bike
 dt=math.clamp(dt,0,cfg.Tick)
 local motion=Motion.step(s.Speed,s.Yaw,input.Throttle,input.Steer,input.Brake,dt,maxSpeed)
 s.Speed=motion.Speed;s.Yaw=motion.Yaw;s.JumpCooldown=math.max(0,s.JumpCooldown-dt)
 local floor=scene.floor(s.X,s.Y,s.Z)
 local contact=floor~=nil and math.abs(s.Y-(floor+.05))<=cfg.GroundTolerance
 if s.Grounded and not contact then s.Grounded=false end
 local jump=input.JumpId or 0
 if jump>s.JumpId then
  s.JumpId=jump
  if s.Grounded and contact and s.JumpCooldown==0 then
   s.VY=cfg.JumpVelocity;s.Grounded=false;s.JumpCooldown=cfg.JumpCooldown
  end
 end
 local x,z=s.X+motion.DX,s.Z+motion.DZ
 local nextFloor,normal=scene.floor(x,s.Y,z)
 local supported=nextFloor~=nil
 local target=if nextFloor then nextFloor+.05 else s.Y
 local canStep=supported and math.abs(target-s.Y)<=cfg.StepHeight and (normal or 1)>=cfg.MinGroundNormal
 local y=s.Y
 if s.Grounded and canStep then y=target;s.VY=0
 else
  s.Grounded=false
  y=s.Y+s.VY*dt-.5*cfg.Gravity*dt*dt;s.VY-=cfg.Gravity*dt
  if s.VY<=0 and supported and s.Y>=target-cfg.GroundTolerance and y<=target and (normal or 1)>=cfg.MinGroundNormal then
   y=target;s.VY=0;s.Grounded=true
  end
 end
 -- Lift grounded body casts above traversable tire/step geometry. Floor queries still enforce height/slope.
 local bottom=if old.Grounded and s.Grounded then math.max(old.Y,y)+cfg.StepHeight+.05 else old.Y+.25
 local hit=scene.block(s.X,bottom,s.Z,s.Yaw,motion.DX,y-old.Y,motion.DZ,old.Y,old.Grounded and s.Grounded)
 if hit or (old.Grounded and supported and not canStep and s.VY<=0 and target>old.Y+cfg.StepHeight) then
  x=old.X;z=old.Z;s.Speed=0
  if y>old.Y and not s.Grounded then y=old.Y;s.VY=math.min(0,s.VY) end
 end
 s.X=x;s.Y=y;s.Z=z
 s.Distance+=math.sqrt((x-old.X)^2+(z-old.Z)^2)
 return s
end
function Sim.command(state:any,input:any,maxSpeed:number,scene:any):any
 for _=1,Config.Bike.CommandSteps do state=Sim.step(state,input,Config.Bike.Tick,maxSpeed,scene) end
 return state
end
function Sim.onBelt(state:any,cx:number,cy:number,cz:number,width:number,depth:number):boolean
 if not state or not state.Grounded or math.abs(state.Y-cy)>.4 then return false end
 for _,wheel in ipairs({-2.6,2.6}) do
  local x=state.X-math.sin(state.Yaw)*wheel-cx
  local z=state.Z-math.cos(state.Yaw)*wheel-cz
  if math.abs(x)>width/2-1 or math.abs(z)>depth/2-.3 then return false end
 end
 return true
end
function Sim.valid(state:any):boolean
 if type(state)~="table" or type(state.Grounded)~="boolean" then return false end
 for _,key in ipairs({"X","Y","Z","Yaw","Speed","VY","Distance","JumpId","JumpCooldown"}) do
  local v=state[key];if type(v)~="number" or v~=v or math.abs(v)>(if key=="JumpId" then 9007199254740991 else 1e9) then return false end
 end
 return state.JumpId>=0 and state.JumpId%1==0 and state.Distance>=0 and state.JumpCooldown>=0
end
return table.freeze(Sim)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">RiderMount</string>
          <string name="Source"><![CDATA[--!strict
-- Offsets come from authored saddle geometry and actual avatar pelvis dimensions.
local Mount={}
function Mount.offset(bike:Model,character:Model):CFrame
 local root=character:FindFirstChild("HumanoidRootPart") :: BasePart
 local frame=bike:FindFirstChild("Frame") :: Model
 local saddle=frame:FindFirstChild("Saddle") :: BasePart
 local base=bike:FindFirstChild("Root") :: BasePart
 assert(root and saddle and base,"Rider geometry missing")
 local localSeat=base.CFrame:ToObjectSpace(saddle.CFrame)
 local pelvis=character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
 local support=root.Size.Y*.5
 local pelvisX,pelvisZ=0,0
 if pelvis and pelvis:IsA("BasePart") then
  -- Use bind-pose Motor6D offsets, not an animated/world-space pelvis sample.
  support=pelvis.Size.Y*.5
  for _,joint in ipairs(root:GetChildren()) do
   if joint:IsA("Motor6D") and joint.Part1==pelvis then
    local bind:CFrame=(joint:GetAttribute("RiderBaseC0") :: CFrame?) or joint.C0
    local delta=(bind*joint.C1:Inverse()).Position
    support-=delta.Y;pelvisX=delta.X;pelvisZ=delta.Z
    break
   end
  end
 end
 return CFrame.new(localSeat.Position.X-pelvisX,localSeat.Position.Y+saddle.Size.Y*.5+support,localSeat.Position.Z-pelvisZ)
end
function Mount.place(rig:any,cf:CFrame)
 -- PrimaryPart pivots may contain a nonzero PivotOffset. Preserve that relation explicitly.
 local model=rig.Root.Parent :: Model
 local rootToPivot=rig.Root.CFrame:ToObjectSpace(model:GetPivot())
 model:PivotTo(cf*rootToPivot)
end
return table.freeze(Mount)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="209">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Config)
local Numbers = require(script.Parent.Numbers)
local Catalog = require(script.Parent.Catalog)
local Rules = {}
function Rules.trainingGain(rebirths: number, treadmillMultiplier: number?): number
 assert(Numbers.validRebirth(rebirths), "Invalid rebirth count")
 return Numbers.multiply(Numbers.multiply(Config.Rules.BaseTraining, Numbers.add(1, Numbers.multiply(rebirths, Config.Rules.RebirthBonus))), treadmillMultiplier or 1)
end
function Rules.rebirthRequirement(rebirths: number): number
 assert(Numbers.validRebirth(rebirths), "Invalid rebirth count")
 return Numbers.multiply(Numbers.multiply(Config.Economy.RebirthBaseEnergy, Numbers.add(rebirths, 1)), if rebirths >= Config.Economy.RebirthHardFrom then Config.Economy.RebirthHardFactor else 1)
end
function Rules.withinTrainingZone(dx: number, dy: number, dz: number, width: number, depth: number): boolean
 -- Reject NaN/infinite transforms, including malformed client-owned character motion.
 for _, value in ipairs({dx, dy, dz, width, depth}) do
  if value ~= value or math.abs(value) == math.huge then return false end
 end
 return width > 0 and depth > 0 and math.abs(dx) <= width/2+1 and math.abs(dz) <= depth/2+1
  and math.abs(dy) <= Config.Training.MaxVerticalDistance
end
function Rules.canUseTreadmill(id: number, energy: number, rebirths: number, ownedWorlds: {number}): boolean
 if not Numbers.valid(id) or id % 1 ~= 0 or not Numbers.valid(energy) or not Numbers.validRebirth(rebirths) then return false end
 local treadmill = Catalog.Treadmills[id]
 return treadmill ~= nil and table.find(ownedWorlds, treadmill.WorldId) ~= nil
  and (energy >= treadmill.EnergyRequirement or rebirths >= treadmill.RebirthRequirement)
end
function Rules.rebirth(energy: number, rebirths: number): { Energy: number, Rebirths: number }?
 if not Numbers.valid(energy) or not Numbers.validRebirth(rebirths) or rebirths >= Numbers.MaxRebirths or energy < Rules.rebirthRequirement(rebirths) then return nil end
 return { Energy = 0, Rebirths = rebirths + 1 }
end
function Rules.canBuyWorld(cash: number, worldId: number, owned: {number}): boolean
 if worldId % 1 ~= 0 or worldId < 2 or worldId > Config.Rules.WorldCount then return false end
 return not table.find(owned, worldId) and cash >= Config.Economy.WorldBaseCash * (worldId - 1)
end
-- No world argument: vehicle ownership is independent of world progress.
function Rules.canBuyVehicle(cash: number, vehicleId: number, owned: {number}): boolean
 return vehicleId % 1 == 0 and vehicleId >= 1 and vehicleId <= Config.Rules.VehicleCount
  and not table.find(owned, vehicleId) and cash >= Catalog.Vehicles[vehicleId].CashCost
end
function Rules.fusion(pets: {[string]: {SpeciesId: number, Variant: string}}, ids: {string}): { SpeciesId: number, Variant: string }?
 if #ids == 0 then return nil end
 local first = pets[ids[1]]
 if not first then return nil end
 local count = if first.Variant == "Normal" then Config.Rules.GoldenIngredients elseif first.Variant == "Golden" then Config.Rules.RainbowIngredients else 0
 if #ids ~= count then return nil end
 local seen = {}
 for _, id in ipairs(ids) do
  local pet = pets[id]
  if seen[id] or not pet or pet.SpeciesId ~= first.SpeciesId or pet.Variant ~= first.Variant then return nil end
  seen[id] = true
 end
 return { SpeciesId = first.SpeciesId, Variant = if first.Variant == "Normal" then "Golden" else "Rainbow" }
end
function Rules.raceEnergy(energy: number): number return energy end
return table.freeze(Rules)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="210">
        <Properties>
          <string name="Name">RuntimeContract</string>
          <string name="Source"><![CDATA[--!strict
-- Single contract for startup and build-level integration checks.
local Contract={}
Contract.Paths={
 {"ReplicatedStorage","PetModels","ExclusiveSunfox"},{"ReplicatedStorage","PetModels","ExclusivePrismRay"},
 {"Workspace","World1","IslandSpawn"},{"Workspace","World1","Training"},
 {"Workspace","World1","GaragePreview","Platform"},{"Workspace","World1","GaragePreview","EntryZone"},{"Workspace","World1","RacePreview","Platform"},
 {"Workspace","TestCourse","Road_0","AsphaltTriangle"},{"Workspace","World1","ShopArea","Platform"},{"Workspace","World1","WorldPreview","Platform"},
}
for id=1,5 do table.insert(Contract.Paths,{"Workspace","World1","Training","Treadmill_"..id,"Zone"}) end
for id=1,3 do table.insert(Contract.Paths,{"Workspace","World1","EggStation_"..id,"Egg"}) end
for id=1,10 do
 local name=if id==1 then "Mountainbike" else "Vehicle"..id
 for _,group in ipairs({"Root","Frame","Steering","FrontWheel","RearWheel"}) do
  table.insert(Contract.Paths,{"ReplicatedStorage","Vehicles",name,group})
  if group~="Root" then table.insert(Contract.Paths,{"ReplicatedStorage","Vehicles",name,group,"Pivot"}) end
 end
 if id<=6 then table.insert(Contract.Paths,{"ReplicatedStorage","Vehicles",name,"Crank","Pivot"}) end
end
for id=1,12 do table.insert(Contract.Paths,{"ReplicatedStorage","PetModels","Pet"..id}) end
function Contract.inspect(root:any):{string}
 local errors={}
 for _,path in ipairs(Contract.Paths) do
  local current=root
  for _,name in ipairs(path) do current=current:FindFirstChild(name);if not current then break end end
  if not current then table.insert(errors,table.concat(path,"/"))
  elseif table.find({"Zone","Root","Pivot","Platform","Egg","AsphaltTriangle","IslandSpawn"},path[#path]) and not current:IsA("BasePart") then
   table.insert(errors,table.concat(path,"/").." is not a BasePart")
  end
 end
 return errors
end
return table.freeze(Contract)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">TrainingController</string>
          <string name="Source"><![CDATA[--!strict
-- Pure controller: identity, clock, live position checks and profile transactions are injected.
local Config = require(script.Parent.Config)
local Rules = require(script.Parent.Rules)
local Numbers = require(script.Parent.Numbers)
local PremiumRules=require(script.Parent.PremiumRules)
local PetRules=require(script.Parent.PetRules)
local Catalog = require(script.Parent.Catalog)
local Controller: any = {}
Controller.__index = Controller
function Controller.new(data: any, clock: () -> number, near: (any, number) -> boolean, feedback: ((any, any) -> ())?): any
 return setmetatable({ Data = data, Clock = clock, Near = near, States = {}, Feedback = feedback or function() end }, Controller)
end
function Controller.state(self: any, player: any): any
 if not self.States[player] then self.States[player] = { Selected = 0, LastAuto = self.Clock(), LastClick = -math.huge, LastSelect = -math.huge, LastRebirth = -math.huge } end
 return self.States[player]
end
function Controller.select(self: any, player: any, id: number): (boolean, string?)
 local state, now = self:state(player), self.Clock()
 if now - state.LastSelect < Config.Training.SelectCooldown then return false, "Cooldown" end
 state.LastSelect = now
 if id % 1 ~= 0 or id < 1 or id > Config.Rules.TreadmillCount or not self.Near(player, id) then return false, "TooFar" end
 local allowed = false
 local ok, reason = self.Data.change(player, function(data: any): boolean
  allowed = Rules.canUseTreadmill(id, data.Energy, data.Rebirths, data.OwnedWorlds)
  return allowed
 end)
 if not ok then return false, if reason == "Rejected" then "Locked" else reason end
 if state.Selected ~= id then state.Selected = id; state.LastAuto = now; self.Feedback(player,{Kind="Selected",TreadmillId=id}) end
 return true, nil
end
function Controller.stop(self: any, player: any)
 local state = self:state(player); state.Selected = 0
end
function Controller.impulse(self: any, player: any, click: boolean): (boolean, string?)
 local state, now = self:state(player), self.Clock()
 local id = state.Selected
 if id == 0 then return false, "NoTreadmill" end
 if not self.Near(player, id) then state.Selected = 0; return false, "TooFar" end
 if click then
  if now - state.LastClick < Config.Training.ClickCooldown then return false, "Cooldown" end
  state.LastClick = now
 else
  if now - state.LastAuto < Config.Training.AutoSeconds then return false, "Cooldown" end
  state.LastAuto = now -- no accumulated offline/catch-up impulses
 end
 local allowed = false
 local gain=0
 local ok, reason = self.Data.change(player, function(data: any): boolean
  allowed = Rules.canUseTreadmill(id, data.Energy, data.Rebirths, data.OwnedWorlds)
  if not allowed then return false end
  local before=data.Energy
  data.Energy = Numbers.add(data.Energy, Numbers.multiply(Rules.trainingGain(data.Rebirths, Catalog.Treadmills[id].TrainingMultiplier),Numbers.multiply(PetRules.bonus(data,"Energy"),if self.Premium then (self.Premium :: any)(player,data,"Energy") else PremiumRules.bonus(data,"Energy"))))
  gain=data.Energy-before
  return true
 end)
 if ok and gain>0 then self.Feedback(player,{Kind="Training",Amount=gain}) end
 if not allowed and reason == "Rejected" then state.Selected = 0 end
 return ok, if not allowed and reason == "Rejected" then "Locked" else reason
end
function Controller.rebirth(self: any, player: any): (boolean, string?)
 local state, now = self:state(player), self.Clock()
 if now - state.LastRebirth < Config.Training.RebirthCooldown then return false, "Cooldown" end
 state.LastRebirth = now
 local rebirths=0
 local ok, reason = self.Data.change(player, function(data: any): boolean
  local result = Rules.rebirth(data.Energy, data.Rebirths)
  if not result then return false end
  data.Energy, data.Rebirths = result.Energy, result.Rebirths
  rebirths=result.Rebirths
  if state.Selected ~= 0 and not Rules.canUseTreadmill(state.Selected, data.Energy, data.Rebirths, data.OwnedWorlds) then state.Selected = 0 end
  return true
 end)
 if ok then self.Feedback(player,{Kind="Rebirth",Rebirths=rebirths}) end
 return ok, if reason == "Rejected" then "NotEnoughEnergy" else reason
end
function Controller.tick(self: any)
 for player, state in pairs(self.States) do
  if state.Selected ~= 0 then self:impulse(player, false) end
 end
end
function Controller.selection(self: any, player: any): number
 local state = self.States[player]
 return if state then state.Selected else 0
end
function Controller.remove(self: any, player: any) self.States[player] = nil end
return Controller
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="212">
        <Properties>
          <string name="Name">TrainingTap</string>
          <string name="Source"><![CDATA[--!strict
local Config=require(script.Parent.Config)
local Tap={};Tap.__index=Tap
function Tap.new(clock:()->number):any return setmetatable({Clock=clock,Last=-math.huge,Touch=-math.huge},Tap) end
function Tap.accept(self:any,kind:string,processed:boolean,snapshot:any,menuOpen:boolean):boolean
 local now=self.Clock()
 if kind=="Touch" then self.Touch=now
 elseif kind~="Mouse" or now-self.Touch<0.35 then return false end
 if processed or menuOpen or not snapshot or (snapshot.SelectedTreadmill or 0)==0 or snapshot.Race and snapshot.Race.Phase~="Idle" then return false end
 if now-self.Last<Config.Training.ClickCooldown then return false end
 self.Last=now;return true
end
return Tap
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="213">
        <Properties>
          <string name="Name">World1Content</string>
          <string name="Source"><![CDATA[--!strict
-- All economy numbers below are provisional World-1 balancing, not a 9-hour endgame guarantee.
local C:any={}
C.Vehicles={
 {Name="Mountainbike",Price=0,Speed=1,Model="Mountainbike"},
 {Name="City Bike",Price=250,Speed=1.06,Model="Vehicle2"},
 {Name="BMX",Price=750,Speed=1.12,Model="Vehicle3"},
 {Name="Road Bike",Price=2000,Speed=1.2,Model="Vehicle4"},
 {Name="Racing Bicycle",Price=5000,Speed=1.3,Model="Vehicle5"},
 {Name="Carbon Bike",Price=12000,Speed=1.42,Model="Vehicle6"},
 {Name="Classic Moped",Price=25000,Speed=1.55,Model="Vehicle7"},
 {Name="City Scooter",Price=50000,Speed=1.7,Model="Vehicle8"},
 {Name="Sport Moped",Price=100000,Speed=1.9,Model="Vehicle9"},
 {Name="Racing Moped",Price=200000,Speed=2.1,Model="Vehicle10"},
}
C.Eggs={{Name="Tropical Egg",Price=100},{Name="Jungle Egg",Price=750},{Name="Waterfall Egg",Price=4000}}
C.Pets={
 {Name="Coconut Buddy",Energy=1.1,Cash=1.05},{Name="Sunny Chick",Energy=1.18,Cash=1.1},
 {Name="Beach Turtle",Energy=1.35,Cash=1.18},{Name="Tropical Parrot",Energy=1.6,Cash=1.3},
 {Name="Jungle Monkey",Energy=1.2,Cash=1.12},{Name="Leaf Frog",Energy=1.35,Cash=1.25},
 {Name="Emerald Snake",Energy=1.6,Cash=1.4},{Name="Jungle Tiger",Energy=2,Cash=1.65},
 {Name="Water Sprite",Energy=1.4,Cash=1.3},{Name="Blue Axolotl",Energy=1.65,Cash=1.5},
 {Name="Crystal Fish",Energy=2,Cash=1.8},{Name="Water Dragon",Energy=2.6,Cash=2.2},
}
C.Rarities={"Common","Uncommon","Rare","Legendary"}
C.Weights={5500,2800,1400,300}
C.Difficulties={
 Easy={Speeds={22,24,26,28,30},Rewards={200,150,110,80,60,40}},
 Medium={Speeds={34,37,40,43,46},Rewards={700,450,250,130,75,45}},
 Hard={Speeds={55,59,63,67,71},Rewards={2400,1500,600,200,90,50}},
}
local raceWorlds:{[number]:{Length:number,Playable:boolean,RewardMultiplier:number?}}={[1]={Length=800,RewardMultiplier=1,Playable=true},[2]={Length=1100,Playable=false},[3]={Length=1400,Playable=false},[4]={Length=1800,Playable=false},[5]={Length=2200,Playable=false},[6]={Length=2800,Playable=false},[7]={Length=3500,Playable=false},[8]={Length=4500,Playable=false}}
C.RaceWorlds=raceWorlds
C.Variants={Normal=1,Golden=2,Rainbow=4}
C.FusionWorlds={Golden=4,Rainbow=5}
local function freeze(t:any):any for _,v in pairs(t) do if type(v)=="table" then freeze(v) end end;return table.freeze(t) end
return freeze(C)
]]></string>
