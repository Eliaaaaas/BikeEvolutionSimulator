      <Item class="LocalScript" referent="976">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- This dependency-free ribbon survives an error in any application module.
local player=game:GetService("Players").LocalPlayer
local gui=Instance.new("ScreenGui");gui.Name="BikeDiagnostics";gui.ResetOnSpawn=false
 gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets;gui.DisplayOrder=100;gui.Parent=player:WaitForChild("PlayerGui")
local label=Instance.new("TextLabel");label.Size=UDim2.new(0.65,0,0,74);label.Position=UDim2.new(0.35,0,0,88)
label.BackgroundColor3=Color3.fromRGB(21,63,83);label.BackgroundTransparency=0.12
label.TextColor3=Color3.fromRGB(255,231,147);label.Font=Enum.Font.GothamBold;label.TextSize=12
label.TextWrapped=true;label.Text="CLIENT STARTET • warte auf Server";label.Parent=gui
local runtime=game:GetService("ReplicatedStorage"):WaitForChild("BikeRuntime",15)
local clientStage="Starte Anwendung"
local failed=false
local function refresh()
 if not runtime then label.Text="SERVER FEHLT • BikeRuntime wurde nicht erzeugt. Output und Server-Script prüfen.";return end
 local state=runtime:GetAttribute("State")
 label.Visible=failed or runtime:GetAttribute("Diagnostics")==true or state~="Ready" or runtime:GetAttribute("BikeState")=="Failed"
 label.Text=tostring(runtime:GetAttribute("DataMode")).."\nSERVER "..tostring(state).." / "..tostring(runtime:GetAttribute("Stage")).." • CLIENT "..clientStage.."\n"..tostring(runtime:GetAttribute("BikeError") or runtime:GetAttribute("SignError") or runtime:GetAttribute("Error") or "")
end
if runtime then runtime.AttributeChanged:Connect(refresh) end
refresh()
local ok,err=pcall(function()
 require(script.ClientApp).start(function(stage:string) clientStage=stage;refresh() end)
end)
if not ok then failed=true;clientStage="FEHLER: "..tostring(err);warn("[BikeClient]",err);refresh() end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="977">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Packaged Roblox audio names verified in Roblox-Client-Tracker rbxManifest.txt.
-- No asset IDs, network audio, permissions or paid uploads required.
local SoundService=game:GetService("SoundService")
local Audio={}
local cues={Button="volume_slider.ogg",Training="action_jump.mp3",Selected="action_jump_land.mp3",
 Unlock="action_get_up.mp3",Rebirth="action_get_up.mp3",Success="volume_slider.ogg"}
function Audio.new(settings:any):any
 local pool={};local last: {[string]:number}={}
 local api={}
 function api.play(cue:string)
  if not settings.Sound or settings.Volume<=0 or not cues[cue] then return end
  if os.clock()-(last[cue] or -math.huge)<(if cue=="Training" then 0.18 else 0.08) then return end
  last[cue]=os.clock()
  if #pool>=6 then local oldest=table.remove(pool,1);if oldest then oldest:Destroy() end end
  local sound=Instance.new("Sound");sound.SoundId="rbxasset://sounds/"..cues[cue];sound:SetAttribute("CueLevel",if cue=="Training" then 0.12 else 0.3);sound.Volume=settings.Volume*(sound:GetAttribute("CueLevel") or 0.3)
  sound.PlaybackSpeed=if cue=="Training" then 1.7 elseif cue=="Rebirth" then 1.25 else 1
  sound.Parent=SoundService;table.insert(pool,sound);sound:Play()
  task.delay(3,function() local index=table.find(pool,sound);if index then table.remove(pool,index);sound:Destroy() end end)
 end
 function api.refresh()
  for _,sound in ipairs(pool) do sound.Volume=if settings.Sound then settings.Volume*(sound:GetAttribute("CueLevel") or 0.3) else 0 end
 end
 return api
end
return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="978">
          <Properties>
            <string name="Name">AvatarPose</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural R15 hand/foot IK; R6 uses joint posing. No uploaded animation IDs.
local Pose={}
function Pose.new(character:Model,bike:Model?):any
 local hum=character:FindFirstChildOfClass("Humanoid");if not hum then return nil end
 local record:any={Character=character,Motors={},IK={},Attachments={},Tracks={},Connections={},Dirty=false}
 local animator=hum:FindFirstChildOfClass("Animator")
 if animator then for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end end
 local animate=character:FindFirstChild("Animate")
 if animate and animate:IsA("LocalScript") then record.Animate=animate;record.Disabled=animate.Disabled;animate.Disabled=true end
 for _,motor in ipairs(character:GetDescendants()) do
  if motor:IsA("Motor6D") then record.Motors[motor]={C0=motor:GetAttribute("RiderBaseC0") or motor.C0,RestoreC0=motor.C0,Transform=motor.Transform} end
 end
 if bike and hum.RigType==Enum.HumanoidRigType.R15 then
  local frame=bike:FindFirstChild("Frame")
  local frameRoot=if frame then frame:FindFirstChild("Pivot") else nil
  if not frameRoot or not frameRoot:IsA("BasePart") then return record end
  local function contact(group:Instance?,name:string,side:number):BasePart?
   if not group then return nil end
   for _,part in ipairs(group:GetDescendants()) do
    if part:IsA("BasePart") and part.Name==name and frameRoot.CFrame:PointToObjectSpace(part.Position).X*side>0 then return part end
   end
   return nil
  end
  local function ik(side:string,limb:string,tip:string,part:BasePart?,sign:number)
   local a=character:FindFirstChild(side..limb);local b=character:FindFirstChild(side..tip)
   if not a or not b or not a:IsA("BasePart") or not b:IsA("BasePart") or not part then return end
   local target=Instance.new("Attachment");target.Name="LocalRiderTarget"
   target.Position=Vector3.new(0,part.Size.Y/2+.035,0);target.Parent=part;table.insert(record.Attachments,target)
   local pole=Instance.new("Attachment");pole.Name="LocalRiderPole"
   -- Pole remains on its anatomical side, outside the frame. It does NOT rotate with the crank.
   local arm=tip=="Hand"
   pole.Position=Vector3.new(sign*(if arm then 2.2 else math.max(1.3,b.Size.X+1)),if arm then 3.7 else 2.4,if arm then -1 else -1.5)
   pole.Parent=frameRoot;table.insert(record.Attachments,pole)
   local control=Instance.new("IKControl");control.Name="ProceduralBikeIK";control.Type=Enum.IKControlType.Position
   control.ChainRoot=a;control.EndEffector=b;control.Target=target;control.Pole=pole
   -- Solve the palm/sole contact rather than the center of the hand or foot.
   control.EndEffectorOffset=CFrame.new(0,-b.Size.Y*.45,0)
   control.Weight=1;control.SmoothTime=0;control.Priority=10;control.Parent=hum;table.insert(record.IK,control)
  end
  local steering=bike:FindFirstChild("Steering");local crank=bike:FindFirstChild("Crank")
  for _,side in ipairs({"Left","Right"}) do
   local sign=if side=="Left" then -1 else 1
   ik(side,"UpperArm","Hand",contact(steering,"Grip",sign),sign)
   ik(side,"UpperLeg","Foot",contact(crank or frame,if crank then "Pedal" else "FootRest",sign),sign)
  end
 end
 -- CharacterAdded may precede streamed limbs/appearance sizing. Rebuild rather than keeping incomplete IK forever.
 table.insert(record.Connections,character.DescendantAdded:Connect(function() record.Dirty=true end))
 for _,part in ipairs(character:GetChildren()) do
  if part:IsA("BasePart") then table.insert(record.Connections,part:GetPropertyChangedSignal("Size"):Connect(function() record.Dirty=true end)) end
 end
 return record
end
function Pose.update(record:any,phase:number,riding:boolean,weight:number)
 for _,control in ipairs(record.IK) do control.Weight=math.min(1,control.Weight+weight) end
 for motor,base in pairs(record.Motors) do
  if not motor.Parent then continue end
  local name=motor.Name;local angle=0
  if riding and #record.IK>0 and (string.find(name,"Hip") or string.find(name,"Shoulder") or string.find(name,"Knee") or string.find(name,"Elbow") or string.find(name,"Ankle") or string.find(name,"Wrist")) then motor.C0=base.C0;motor.Transform=CFrame.identity;continue end
  if string.find(name,"Hip") then angle=if riding then -0.6+math.sin(phase+(if string.find(name,"Left") then 0 else math.pi))*0.6 else math.sin(phase+(if string.find(name,"Left") then 0 else math.pi))*0.55 end
  if string.find(name,"Shoulder") then angle=if riding then -0.95 else math.sin(phase+(if string.find(name,"Left") then math.pi else 0))*0.25 end
  if name=="Waist" then angle=if riding then -0.4 else -0.08 end
  motor.C0=motor.C0:Lerp(base.C0*CFrame.Angles(angle,0,0),weight)
  motor.Transform=CFrame.identity
 end
end
function Pose.fade(record:any,weight:number)
 for motor,base in pairs(record.Motors) do if motor.Parent then motor.C0=motor.C0:Lerp(base.RestoreC0,weight) end end
 for _,control in ipairs(record.IK) do control.Weight=math.max(0,control.Weight-weight) end
end
function Pose.destroy(record:any)
 for _,connection in ipairs(record.Connections) do connection:Disconnect() end
 for motor,base in pairs(record.Motors) do if motor.Parent then motor.C0=base.RestoreC0;motor.Transform=base.Transform end end
 for _,control in ipairs(record.IK) do control:Destroy() end
 for _,target in ipairs(record.Attachments) do target:Destroy() end
 if record.Animate and record.Animate.Parent then record.Animate.Disabled=record.Disabled end
end
return Pose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="979">
          <Properties>
            <string name="Name">BikeInput</string>
            <string name="Source"><![CDATA[--!strict
-- Roblox PlayerModule supplies both WASD/arrows and the native mobile thumbstick.
local Players=game:GetService("Players")
local Input=game:GetService("UserInputService")
local Actions=game:GetService("ContextActionService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Prediction=require(script.Parent.RidePrediction)
local Driver={}
function Driver.new(ui:any,remote:RemoteEvent,stateRemote:RemoteEvent)
 local player=Players.LocalPlayer
 -- PlayerModule is inserted by Roblox at runtime and is absent from the Rojo sourcemap.
 local loadPlayerModule:(Instance)->any=require
 local controls=loadPlayerModule(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
 -- Keep controller input collection active, but remove its default Player:Move dispatcher.
 -- Disable() would also disable the native touch thumbstick and GetMoveVector().
 local originalMove=controls.moveFunction
 assert(type(originalMove)=="function","Unsupported Roblox ControlModule: moveFunction missing")
 local suppressMove=function()
  local hum=if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
  if hum then hum:Move(Vector3.zero,false);hum.Jump=false;hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false) end
 end
 controls.moveFunction=suppressMove
 local function stopWalking(character:Model?)
  local hum=if character then character:FindFirstChildOfClass("Humanoid") else nil
  if hum then hum:Move(Vector3.zero,false);hum.Jump=false;hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false) end
 end
 stopWalking(player.Character)
 local spawned=player.CharacterAdded:Connect(stopWalking)
 local prediction=Prediction.new(ui,stateRemote);ui.Prediction=prediction
 local sequence=player:GetAttribute("DriveSequence") or 0
 local jumpId=player:GetAttribute("DriveJumpId") or 0
 local brake=false;local focused=true
 Actions:BindActionAtPriority("BikeBrake",function(_,state)
  brake=state==Enum.UserInputState.Begin or state==Enum.UserInputState.Change
  return Enum.ContextActionResult.Sink
 end,true,3001,Enum.KeyCode.LeftShift)
 Actions:SetTitle("BikeBrake","BREMSE")
 Actions:SetPosition("BikeBrake",UDim2.fromScale(.32,.68))
 Actions:BindActionAtPriority("BikeJump",function(_,state)
  if state==Enum.UserInputState.Begin and focused and not ui.isMenuOpen() and player:GetAttribute("Racing")~=true and player:GetAttribute("AutoDriving")~=true and ui.Snapshot then jumpId+=1 end
  return Enum.ContextActionResult.Sink
 end,true,3001,Enum.KeyCode.Space)
 Actions:SetTitle("BikeJump","SPRUNG");Actions:SetPosition("BikeJump",UDim2.new(1,-90,1,-220))
 local lost=Input.WindowFocusReleased:Connect(function() focused=false;brake=true end)
 local gained=Input.WindowFocused:Connect(function() focused=true;brake=false end)
 task.spawn(function()
  while ui.Gui.Parent do
   controls.moveFunction=suppressMove
   local move=controls:GetMoveVector()
   local blocked=not focused or ui.isMenuOpen() or Input:GetFocusedTextBox()~=nil or player:GetAttribute("Racing")==true or not ui.Snapshot or player:GetAttribute("AutoDriving")==true
   sequence=math.max(sequence,prediction.Sequence or 0)+1;jumpId=math.max(jumpId,prediction.JumpId or 0)
   local intent={Throttle=if blocked then 0 else math.clamp(-move.Z,-1,1),Steer=if blocked then 0 else math.clamp(move.X,-1,1),Brake=blocked or brake,JumpId=jumpId}
   prediction.intent(intent);prediction.command(sequence,intent)
   remote:FireServer({Version=1,Sequence=sequence,Epoch=player:GetAttribute("DriveEpoch"),Throttle=intent.Throttle,Steer=intent.Steer,Brake=intent.Brake,JumpId=jumpId})
   task.wait(Config.Bike.InputInterval)
  end
  sequence+=1;remote:FireServer({Version=1,Sequence=sequence,Throttle=0,Steer=0,Brake=true})
  spawned:Disconnect();lost:Disconnect();gained:Disconnect()
  if controls.moveFunction==suppressMove then controls.moveFunction=originalMove end
  Actions:UnbindAction("BikeBrake");Actions:UnbindAction("BikeJump")
 end)
end
return Driver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="980">
          <Properties>
            <string name="Name">ClientApp</string>
            <string name="Source"><![CDATA[--!strict
local App={}
function App.start(progress:(string)->())
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local UserInputService=game:GetService("UserInputService")
local Shared=ReplicatedStorage:WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Protocol=require(Shared:WaitForChild("Protocol"))
local Presentation=require(Shared:WaitForChild("Presentation"))
local State=require(Shared:WaitForChild("ClientState"))
local UI=require(script.Parent.UI)
local Audio=require(script.Parent.Audio)
local Effects=require(script.Parent.Effects)
local camera=workspace.CurrentCamera
local size=if camera then camera.ViewportSize else Vector2.new(800,600)
local settings=State.new(UserInputService.TouchEnabled and math.min(size.X,size.Y)<700)
local audio=Audio.new(settings)
local ui=UI.new(Players.LocalPlayer:WaitForChild("PlayerGui"),settings,audio)
local effects=Effects.new(ui.Gui,settings)
local visuals:any={refresh=function() end}
progress("UI bereit; verbinde Remotes")
ui.OnSetting=function() audio.refresh();effects.refresh();ui.refreshSettings();visuals.refresh() end
local remotes=ReplicatedStorage:WaitForChild(Config.Network.Folder)
local action=remotes:WaitForChild("Action",15) :: RemoteEvent
assert(action,"Action remote missing")
local snapshotRemote=remotes:WaitForChild("GetSnapshot") :: RemoteFunction
local snapshot:any=nil
local lastProgress=0
local requestId=0
local function send(kind:string,fields:any?)
 if not snapshot then return end
 local payload=fields or {};payload.Version=1;payload.Action=kind
 if kind=="BuyVehicle" or kind=="EquipVehicle" or kind=="Hatch" or kind=="EquipPet" or kind=="UnequipPet" or kind=="EquipBest" or kind=="UnequipAll" then requestId+=1;payload.RequestId=requestId end
 action:FireServer(payload)
end
ui.OnMenu=function(name:string)
 if not snapshot and name~="Settings" then ui.message("Spielerdaten werden noch geladen.");return end
 ui.open(name)
end
ui.OnAction=function(kind:string,fields:any?)
 if not snapshot then return end
 if kind=="Rebirth" then
  if Presentation.rebirth(snapshot).Allowed then send("Rebirth") else ui.message("Noch nicht genug Energy oder maximales Rebirth-Level erreicht.") end
 else send(kind,fields) end
end
local function render(data:any):boolean
 if not Protocol.validSnapshot(data) or type(data.SelectedTreadmill)~="number" then return false end
 local merged=State.snapshot(snapshot,data)
 if not merged then return false end
 data=merged
 requestId=math.max(requestId,data.LastRequestId or 0)
 local first=snapshot==nil
 local ratio=Presentation.training(data).Ratio
 if snapshot and ratio>=1 and lastProgress<1 then audio.play("Unlock") end
 lastProgress=ratio;snapshot=data;ui.update(data)
 if first then progress("Spielerdaten und Remotes bereit") end
 return true
end
local snapshotEvent=remotes:WaitForChild("SnapshotChanged") :: RemoteEvent
snapshotEvent.OnClientEvent:Connect(render)
local errors={TrainingPositionBlocked="Trainingsposition blockiert. Auto Train wurde angehalten.",TreadmillUnavailable="Dieses Laufband ist hier nicht verfügbar.",NoAvailableTreadmill="Kein nutzbares Laufband in einer verfügbaren Welt.",ProductUnavailable="Dieses Robux-Angebot ist noch nicht konfiguriert.",NavigationBlocked="Automatik angehalten: Weg blockiert. Bitte manuell freifahren.",TooFar="Stelle dich auf dein Laufband.",Locked="Energy- oder Rebirth-Anforderung fehlt.",NotReady="Daten noch nicht bereit.",Saving="Speichern läuft – kurz warten.",NoTreadmill="Bitte zuerst ein Laufband auswählen.",NotEnoughEnergy="Nicht genug Energy.",NotAlive="Aktion nur mit lebendem Charakter.",AlreadyRacing="Während des Rennens nicht verfügbar.",RaceUnavailable="Gehe zur Race-Zone vorne auf der Insel.",NotEnoughCash="Nicht genug Cash.",AlreadyOwned="Dieses Fahrzeug gehört dir bereits.",InventoryFull="Pet-Inventar voll.",EquipLimit="Maximal drei Pets ausrüstbar.",DuplicateRequest="Diese Anfrage wurde bereits verarbeitet.",PetUnavailable="Dieses Pet ist nicht verfügbar oder noch gesperrt.",ServiceUnavailable="Aktion vorübergehend nicht verfügbar. Bitte erneut versuchen."}
local resultEvent=remotes:WaitForChild("ActionResult") :: RemoteEvent
resultEvent.OnClientEvent:Connect(function(result)
 if type(result)=="table" and result.Error=="Cooldown" and (result.Action=="StartRace" or result.Action=="Hatch") then ui.message("Bitte kurz warten und dann erneut versuchen.") end
 if type(result)=="table" and not result.Ok and result.Error~="Cooldown" then ui.message(errors[result.Error] or "Aktion nicht verfügbar.") end
end)
local feedbackEvent=remotes:WaitForChild("Feedback") :: RemoteEvent
feedbackEvent.OnClientEvent:Connect(function(event)
 if type(event)~="table" or type(event.Id)~="number" or not State.event(settings,event.Id) then return end
 if event.Kind=="Training" and type(event.Amount)=="number" then effects.training(event.Amount);audio.play("Training")
 elseif event.Kind=="Selected" then audio.play("Selected")
 elseif event.Kind=="Rebirth" and type(event.Rebirths)=="number" then effects.rebirth(event.Rebirths);audio.play("Rebirth")
 elseif event.Kind=="Hatched" then ui.HatchedId=event.SpeciesId;ui.open("Hatch");audio.play("Success")
 elseif event.Kind=="InteractionError" then ui.message(errors[event.Error] or "Station nicht verfügbar: "..tostring(event.Error))
 elseif event.Kind=="OpenEgg" then ui.EggId=event.EggId;ui.open("Egg")
 elseif event.Kind=="OpenMenu" then ui.open(event.Menu)
 elseif event.Kind=="PetEquipmentChanged" then audio.play("Success");ui.message(if event.Action=="EquipBest" then "Die besten verfügbaren Pets sind ausgerüstet." else "Alle Pets wurden abgelegt.")
 elseif event.Kind=="Purchase" then audio.play("Success")
 elseif event.Kind=="RaceStarted" then ui.LastRaceResult=nil
 elseif event.Kind=="RaceEnded" then
  if event.Reason=="Finished" then ui.LastRaceResult=event;if not snapshot or not snapshot.Automation or not snapshot.Automation.AutoRace then ui.open("Race") end;audio.play("Success")
  else ui.message(if event.Reason=="RewardUnavailable" then "Auszahlung nicht verfügbar – keine doppelte Forderung erzeugt." else "Rennen abgebrochen. Keine Belohnung.") end
 end
end)
task.spawn(function()
 while not snapshot do
  local ok,response=pcall(function() return snapshotRemote:InvokeServer({Version=1}) end)
  if ok and type(response)=="table" and response.Ok then
   render(response.Data)
  elseif not snapshot then
   ui.message("Ladeprofil: "..(if ok and type(response)=="table" then tostring(response.Error) else "Server nicht erreichbar"))
  end
  if not snapshot then task.wait(2) end
 end
end)
task.defer(function()
 local function optional(name:string,callback:()->())
  local ok,err=pcall(function():any callback();return true end);if not ok then warn("[BikeClient optional]",name,err);progress("Optionaler Effekt fehlgeschlagen: "..name) end
 end
 optional("Camera",function() require(script.Parent.RaceCamera).new(settings,ui) end)
 optional("Vehicles",function() visuals=require(script.Parent.Visuals).new(settings,ui) end)
 optional("Pets",function() require(script.Parent.PetFollowers).new(settings,ui.Gui) end)
 optional("Island",function() require(script.Parent.IslandEffects).new(settings,ui.Gui) end)
 optional("Signs",function() require(script.Parent.SignReadability).new(settings,ui) end)
 optional("Stations",function() require(script.Parent.StationEffects).new(settings,ui) end)
end)
require(script.Parent.BikeInput).new(ui,remotes:WaitForChild("Drive") :: RemoteEvent,remotes:WaitForChild("DriveState") :: RemoteEvent)
require(script.Parent.TrainingInput).new(ui,send)
end
return App
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="981">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
local TweenService=game:GetService("TweenService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format=require(Shared:WaitForChild("Format"))
local Effects={}
local energyColors={Color3.fromRGB(136,255,155),Color3.fromRGB(255,230,110),Color3.fromRGB(112,232,255)}
function Effects.new(gui:ScreenGui,settings:any):any
 local live: {TextLabel}={}
 local api={}
 local function clear()
  for _,label in ipairs(live) do label:Destroy() end;table.clear(live)
 end
 local function show(value:string,reward:boolean)
  if #live>=(if reward then 1 else 6) and reward then clear() end
  if #live>=6 then local first=table.remove(live,1);if first then first:Destroy() end end
  local label=Instance.new("TextLabel");label.Name="ConfirmedEffect";label.AnchorPoint=Vector2.new(1,0.5)
  label.Size=UDim2.fromOffset(if reward then 320 else 180,if reward then 80 else 42)
  label.Position=UDim2.new(1,-16,if reward then 0.2 else 0.55,-#live*32)
  label.Text=value;label.TextColor3=if reward then Color3.fromRGB(255,236,128) else energyColors[#live%#energyColors+1]
  label.TextStrokeTransparency=0.5;label.TextStrokeColor3=Color3.fromRGB(17,95,95);label.Font=Enum.Font.GothamBold
  label.TextSize=if reward then 24 else 23;label.TextWrapped=true;label.BackgroundTransparency=1;label.ZIndex=40;label.Parent=gui;table.insert(live,label)
  if reward then
   local gradient=Instance.new("UIGradient");gradient.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,214,85)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(129,255,155)),ColorSequenceKeypoint.new(1,Color3.fromRGB(105,227,255))});gradient.Parent=label
  end
  if settings.Animations then
   TweenService:Create(label,TweenInfo.new(if reward then 1.7 else 0.8,Enum.EasingStyle.Quad),{Position=label.Position-UDim2.fromOffset(0,45),TextTransparency=1,TextStrokeTransparency=1}):Play()
  end
  task.delay(if reward then 1.8 else 0.9,function() local i=table.find(live,label);if i then table.remove(live,i);label:Destroy() end end)
 end
 function api.training(amount:number) if settings.Popups then show("+"..Format.multiplier(amount).." Energy",false) end end
 function api.rebirth(rebirths:number) show("REBIRTH!\nMultiplikator ×"..Format.multiplier(1+rebirths*0.5),true) end
 function api.refresh() if not settings.Popups or not settings.Animations then clear() end end
 return api
end
return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="982">
          <Properties>
            <string name="Name">Icons</string>
            <string name="Source"><![CDATA[--!strict
-- Small vector-style widget icons: no external images or uploaded assets.
local Icons={}
function Icons.resource(parent:Instance,name:string):Frame
 local icon=Instance.new("Frame");icon.Name=name.."Icon";icon.Size=UDim2.fromOffset(36,36);icon.BackgroundTransparency=1;icon.BorderSizePixel=0;icon.Parent=parent
 local function shape(label:string,x:number,y:number,w:number,h:number,color:Color3,rotation:number?,round:boolean?):Frame
  local f=Instance.new("Frame");f.Name=label;f.Position=UDim2.fromScale(x,y);f.Size=UDim2.fromScale(w,h);f.Rotation=rotation or 0;f.BackgroundColor3=color;f.BorderSizePixel=0;f.Parent=icon
  if round then local c=Instance.new("UICorner");c.CornerRadius=UDim.new(1,0);c.Parent=f end
  return f
 end
 local gold=Color3.fromRGB(255,217,65);local orange=Color3.fromRGB(218,119,26)
 if name=="Cash" then
  shape("CoinShadow",.14,.18,.76,.76,Color3.fromRGB(117,70,25),0,true)
  shape("Coin",.1,.1,.76,.76,orange,0,true)
  local face=shape("CoinFace",.18,.14,.6,.6,gold,0,true)
  local gradient=Instance.new("UIGradient");gradient.Color=ColorSequence.new(Color3.fromRGB(255,244,153),gold);gradient.Rotation=55;gradient.Parent=face
  local stamp=Instance.new("TextLabel");stamp.Name="EmbossedDollar";stamp.Position=UDim2.fromScale(.18,.12);stamp.Size=UDim2.fromScale(.6,.66);stamp.BackgroundTransparency=1;stamp.Text="$";stamp.Font=Enum.Font.GothamBold;stamp.TextScaled=true;stamp.TextColor3=Color3.fromRGB(180,104,22);stamp.Parent=icon
  shape("CoinGlint",.23,.22,.2,.045,Color3.fromRGB(255,255,215),-35,true)
 elseif name=="Energy" then
  for _,layer in ipairs({{Name="BoltDepth",Offset=.045,Color=orange},{Name="BoltFace",Offset=0,Color=gold}}) do
   for _,p in ipairs({{.39,.08,.21,.44,30},{.25,.43,.47,.16,-7},{.4,.49,.2,.44,30}}) do
    shape(layer.Name,p[1]+layer.Offset,p[2]+layer.Offset,p[3],p[4],layer.Color,p[5])
   end
  end
  shape("BoltGlint",.43,.15,.055,.22,Color3.fromRGB(255,253,196),30,true)
 else
  local colors={Color3.fromRGB(67,227,220),Color3.fromRGB(157,112,249)}
  for arc=0,1 do
   for n=0,6 do
    local angle=math.rad(arc*180+20+n*19)
    local color=colors[arc+1]
    shape("RebirthArc",.46+math.cos(angle)*.31,.46+math.sin(angle)*.31,.18,.095,color,math.deg(angle)+90,true)
   end
   local a=math.rad(arc*180+146)
   local x,y=.46+math.cos(a)*.31,.46+math.sin(a)*.31
   shape("Arrowhead",x,y,.23,.12,colors[arc+1],arc*180+20)
   shape("Arrowhead",x+.04,y-.05,.12,.23,colors[arc+1],arc*180+20)
  end
 end
 return icon
end
function Icons.draw(parent:Instance,name:string):Frame
 if name=="Energy" or name=="Cash" or name=="Rebirths" then
  local icon=Icons.resource(parent,name);icon.Position=UDim2.fromOffset(10,7);icon.Size=UDim2.fromOffset(32,32);return icon
 end
 local icon=Instance.new("Frame");icon.Name="Icon";icon.Size=UDim2.fromOffset(32,32);icon.Position=UDim2.fromOffset(10,7);icon.BackgroundTransparency=1;icon.Parent=parent
 local function shape(x:number,y:number,w:number,h:number,round:boolean,outline:boolean?):Frame
  local f=Instance.new("Frame");f.Size=UDim2.fromScale(w,h);f.Position=UDim2.fromScale(x,y);f.BackgroundColor3=Color3.new(1,1,1);f.BorderSizePixel=0;f.Parent=icon
  if round then local c=Instance.new("UICorner");c.CornerRadius=UDim.new(1,0);c.Parent=f end
  if outline then f.BackgroundTransparency=1;local stroke=Instance.new("UIStroke");stroke.Thickness=2;stroke.Color=Color3.new(1,1,1);stroke.Parent=f end
  return f
 end
 if name=="Garage" then
  shape(0.02,0.48,0.4,0.4,true,true);shape(0.58,0.48,0.4,0.4,true,true)
  local a=shape(0.25,0.42,0.5,0.06,false);a.Rotation=-30
  local b=shape(0.4,0.27,0.06,0.42,false);b.Rotation=-30;shape(0.6,0.22,0.3,0.06,false)
 elseif name=="Shop" then
  shape(.15,.38,.7,.5,true,true);shape(.29,.18,.42,.32,true,true)
  shape(.32,.5,.1,.2,true);shape(.58,.5,.1,.2,true)
 elseif name=="Pets" then
  shape(0.22,0.47,0.58,0.4,true)
  for i=0,3 do shape(0.03+i*0.24,0.12+(if i==0 or i==3 then 0.1 else 0),0.19,0.25,true) end
 elseif name=="Race" then
  shape(0.12,0.1,0.07,0.85,false)
  for x=0,2 do for y=0,1 do if (x+y)%2==0 then shape(0.2+x*0.22,0.12+y*0.2,0.22,0.2,false) end end end
 elseif name=="Worlds" then
  shape(0.08,0.08,0.84,0.84,true,true);shape(0.3,0.08,0.4,0.84,true,true);shape(0.1,0.48,0.8,0.04,false)
 elseif name=="Settings" then
  shape(.28,.28,.44,.44,true,true)
  for i=0,7 do local a=i*math.pi/4;local tooth=shape(.44+math.sin(a)*.32,.44+math.cos(a)*.32,.12,.2,false);tooth.Rotation=-i*45 end
 else
  local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.TextColor3=Color3.new(1,1,1)
  text.Text=({Energy="ϟ",Cash="$",Rebirths="↻",Settings="⚙"})[name] or "•"
  text.Font=Enum.Font.GothamBold;text.TextSize=30;text.Parent=icon
 end
 return icon
end
return Icons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="983">
          <Properties>
            <string name="Name">IslandEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Local, distance-limited foam: built-in geometry only, no replicated updates or asset IDs.
local Effects={}
function Effects.new(settings:any,gui:ScreenGui)
 local island=workspace:WaitForChild("World1")
 local folder=Instance.new("Folder");folder.Name="LocalWaterfallFoam";folder.Parent=workspace
 local cascades:{{Source:BasePart,Foam:{BasePart}}}={}
 for _,source in ipairs(island:GetDescendants()) do
  if not source:IsA("BasePart") or source.Name~="Waterfall" then continue end
  local foam:{BasePart}={}
  for i=1,5 do
   local part=Instance.new("Part");part.Name="Foam";part.Anchored=true
   part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
   part.Material=Enum.Material.SmoothPlastic;part.Color=Color3.fromRGB(216,253,255)
   part.Size=Vector3.new(source.Size.X*0.85,0.14,0.08);part.Transparency=1;part.Parent=folder
   table.insert(foam,part)
  end
  table.insert(cascades,{Source=source,Foam=foam})
 end
 task.spawn(function()
  while gui.Parent do
   local active=false
   local camera=workspace.CurrentCamera
   local now=os.clock()
   for _,entry in ipairs(cascades) do
    local source=entry.Source
    local visible=settings.Animations and source.Parent~=nil and camera~=nil and (camera.CFrame.Position-source.Position).Magnitude<140
    for i,part in ipairs(entry.Foam) do
     if visible then
      active=true
      local phase=(now*0.38+i/#entry.Foam)%1
      part.CFrame=source.CFrame*CFrame.new(math.sin(i*2)*0.2,(0.5-phase)*source.Size.Y,source.Size.Z/2+0.05)
      part.Transparency=0.3+math.abs(phase-0.5)*0.8
     else part.Transparency=1 end
    end
   end
   task.wait(if active then 1/15 else 0.3)
  end
  folder:Destroy()
 end)
end
return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="984">
          <Properties>
            <string name="Name">PetFollowers</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Http=game:GetService("HttpService")
local RunService=game:GetService("RunService")
local Models=game:GetService("ReplicatedStorage"):WaitForChild("PetModels")
local Premium=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("PremiumConfig"))
local Followers={}
function Followers.new(settings:any,gui:ScreenGui)
 local entries:any={};local connection:RBXScriptConnection?=nil
 local folder=Instance.new("Folder");folder.Name="LocalPetFollowers";folder.Parent=workspace
 local function clear(entry:any) for _,model in ipairs(entry.Models) do model:Destroy() end;entry.Models={} end
 local function step()
  for player,entry in pairs(entries) do
   local root=if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
   local camera=workspace.CurrentCamera
   if not root or not root:IsA("BasePart") or camera and (root.Position-camera.CFrame.Position).Magnitude>180 then
    for _,model in ipairs(entry.Models) do model.Parent=nil end
    continue
   end
   for i,model in ipairs(entry.Models) do
    model.Parent=folder
    local bob=if settings.Animations then math.sin(os.clock()*2+i)*0.18 else 0
    local cf=root.CFrame*CFrame.new((i-(#entry.Models+1)/2)*2.3,-1.4+bob,3.5)
    model:PivotTo(cf)
   end
  end
 end
 local function sync()
  for _,player in ipairs(Players:GetPlayers()) do
   local raw=player:GetAttribute("PetFollowers") or "[]"
   local entry=entries[player]
   if not entry then entry={Raw=nil,Models={}};entries[player]=entry end
   local root=if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
   local camera=workspace.CurrentCamera
   local visible=root~=nil and root:IsA("BasePart") and (not camera or (root.Position-camera.CFrame.Position).Magnitude<=180)
   if not visible and #entry.Models>0 then clear(entry) end
   if visible and (entry.Raw~=raw or not entry.Visible) then
    clear(entry);entry.Raw=raw
    local ok,pets=pcall(function() return Http:JSONDecode(raw) end)
    if ok and type(pets)=="table" and #pets<=3 then
     for _,pet in ipairs(pets) do
      local exclusive=Premium.Exclusives[pet.ExclusiveId]
      local source=Models:FindFirstChild(if exclusive then exclusive.Model else "Pet"..tostring(pet.SpeciesId))
      if source and source:IsA("Model") then
       local model=source:Clone()
       for _,part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") then
        part.CanCollide=false;part.CanTouch=false;part.Anchored=true
        if pet.Variant=="Golden" and part.Name~="Eye" then part.Color=Color3.fromRGB(255,211,73)
        elseif pet.Variant=="Rainbow" and part.Name~="Eye" then part.Color=Color3.fromHSV((part.Position.Y*0.18)%1,0.65,1) end
       end end
       model.Parent=folder;table.insert(entry.Models,model)
      end
     end
    end
   end
   entry.Visible=visible
  end
  local active=false
  for player,entry in pairs(entries) do
   if player.Parent~=Players then clear(entry);entries[player]=nil elseif #entry.Models>0 then active=true end
  end
  if active and not connection then connection=RunService.PreSimulation:Connect(step)
  elseif not active and connection then connection:Disconnect();connection=nil end
 end
 task.spawn(function() while gui.Parent do sync();task.wait(0.3) end;if connection then connection:Disconnect() end;folder:Destroy() end)
end
return Followers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="985">
          <Properties>
            <string name="Name">RaceCamera</string>
            <string name="Source"><![CDATA[--!strict
-- Single camera owner. Native Roblox orbit/zoom for island; scripted chase only during a race.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Camera={}
function Camera.new(settings:any,ui:any)
 local player=Players.LocalPlayer
 local anchor=Instance.new("Part");anchor.Name="BikeCameraTarget";anchor.Size=Vector3.new(.1,.1,.1)
 anchor.Anchored=true;anchor.Transparency=1;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false;anchor.Parent=workspace
 local active:Camera?=nil;local saved:any=nil;local target:Vector3?=nil;local wasRace=false;local teleportSerial=player:GetAttribute("BikeTeleportSerial") or 0
 local function restore()
  if active and saved then active.CameraType=saved.Type;active.CameraSubject=saved.Subject;active.FieldOfView=saved.Fov end
  active=nil;saved=nil;target=nil
 end
 local function frame(dt:number)
  local camera=workspace.CurrentCamera
  local character=player.Character
  local hum=if character then character:FindFirstChildOfClass("Humanoid") else nil
  if not camera or not hum or hum.Health<=0 then return end
  if active~=camera then restore();active=camera;saved={Type=camera.CameraType,Subject=camera.CameraSubject,Fov=camera.FieldOfView} end
  local prediction=ui.Prediction
  local bike=if prediction and prediction.Active then prediction.Bike else nil
  if not bike then local folder=workspace:FindFirstChild("PlayerBikes");bike=if folder then folder:FindFirstChild("Rider_"..player.UserId) else nil end
  local root=if bike then bike:FindFirstChild("Root") else nil
  if not root or not root:IsA("BasePart") then return end
  local racing=player:GetAttribute("Racing")==true
  local desired=root.Position+Vector3.new(0,4,0)
  local serial=player:GetAttribute("BikeTeleportSerial") or 0
  if not target or (target-desired).Magnitude>20 or wasRace~=racing or serial~=teleportSerial then target=desired
  else target=target:Lerp(desired,1-math.exp(-math.min(dt,.1)*35)) end
  wasRace=racing;teleportSerial=serial
  anchor.CFrame=CFrame.new(target :: Vector3)
  if racing then
   camera.CameraType=Enum.CameraType.Scriptable
   local forward=root.CFrame.LookVector
   local chase=CFrame.lookAt((target :: Vector3)-forward*17+Vector3.new(0,5,0),(target :: Vector3)+forward*9)
   camera.CFrame=camera.CFrame:Lerp(chase,1-math.exp(-math.min(dt,.1)*14));camera.FieldOfView=65
  else
   camera.CameraType=Enum.CameraType.Custom;camera.CameraSubject=anchor
   camera.FieldOfView=if saved then saved.Fov else 70
  end
 end
 -- Presentation at Camera-2; subject at Camera-1; native orbit runs at Camera.
 Run:BindToRenderStep("BikeCameraSubject",Enum.RenderPriority.Camera.Value-1,frame)
 frame(0)
 local removing=player.CharacterRemoving:Connect(function() target=nil end)
 ui.Gui.Destroying:Connect(function()
  Run:UnbindFromRenderStep("BikeCameraSubject");removing:Disconnect();restore();anchor:Destroy()
 end)
end
return Camera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="986">
          <Properties>
            <string name="Name">RidePrediction</string>
            <string name="Source"><![CDATA[--!strict
-- Only the cosmetic local assembly is predicted; the replicated assembly is server-owned.
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Rep=game:GetService("ReplicatedStorage")
local Shared=Rep:WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Sim=require(Shared:WaitForChild("RideSimulation"))
local Surface=require(Shared:WaitForChild("BikeSurface"))
local Replay=require(Shared:WaitForChild("RideReconciliation"))
local Rig=require(Shared:WaitForChild("BikeRig"))
local Geometry=require(Shared:WaitForChild("RiderMount"))
local Content=require(Shared:WaitForChild("World1Content"))
local Prediction={}
function Prediction.new(ui:any,stateRemote:RemoteEvent):any
 local player=Players.LocalPlayer
 local reconciler=Replay.new()
 local folder=Instance.new("Folder");folder.Name="LocalBikePresentation";folder.Parent=workspace
 local hidden:{[BasePart]:number}={}
 local api:any={Active=false,Bike=nil,Character=nil,Epoch=0,Sequence=0}
 local rig:any=nil;local scene:any=nil;local rendered:CFrame?=nil;local vehicle=0
 local maxSpeed=Config.Bike.BaseSpeed
 local currentInput:any={Throttle=0,Steer=0,Brake=true,JumpId=0}
 local lastCommand=os.clock();local lastAck=os.clock()
 local function reset()
  api.Active=false
  for part,value in pairs(hidden) do if part.Parent then part.LocalTransparencyModifier=value end end;table.clear(hidden)
  if api.Bike then api.Bike:Destroy() end
  if api.Character then api.Character:Destroy() end
  api.Bike=nil;api.Character=nil;rig=nil;rendered=nil;vehicle=0
  -- Camera ownership belongs exclusively to RaceCamera (manual and race).
 end
 local function hide(model:Model)
  for _,part in ipairs(model:GetDescendants()) do
   if part:IsA("BasePart") then
    if hidden[part]==nil then hidden[part]=part.LocalTransparencyModifier end
    part.LocalTransparencyModifier=1
   end
  end
 end
 local function build(id:number,state:any):boolean
  reset()
  local character=player.Character
  if not character then return false end
  local asset=Rep:WaitForChild("Vehicles"):FindFirstChild(Content.Vehicles[id].Model) :: Model?
  if not asset then return false end
  local was=character.Archivable;character.Archivable=true
  local copy=character:Clone();character.Archivable=was
  local bike=asset:Clone();bike.Name="PredictedRider";copy.Name="PredictedAvatar"
  for _,node in ipairs(copy:GetDescendants()) do
   if node:IsA("Script") or node:IsA("LocalScript") or node:IsA("IKControl") or node.Name=="LocalRiderTarget" or node.Name=="LocalRiderPole" then node:Destroy()
   elseif node:IsA("Motor6D") then
    node.Transform=CFrame.identity
    local base=node:GetAttribute("RiderBaseC0")
    if typeof(base)=="CFrame" then
     local angle=if string.find(node.Name,"Hip") then -1.15 elseif string.find(node.Name,"Knee") then 1.3 elseif string.find(node.Name,"Shoulder") then -1.1 elseif string.find(node.Name,"Elbow") then -.55 elseif node.Name=="Waist" then -.25 else 0
     node.C0=base*CFrame.Angles(angle,0,0)
    end
   elseif node:IsA("BasePart") then node.Anchored=false;node.CanCollide=false;node.CanTouch=false;node.CanQuery=false;node.Massless=true;node.LocalTransparencyModifier=0 end
  end
  local root=copy:FindFirstChild("HumanoidRootPart") :: BasePart?
  local hum=copy:FindFirstChildOfClass("Humanoid")
  if not root or not hum then copy:Destroy();bike:Destroy();return false end
  hum.WalkSpeed=0;hum.AutoRotate=false;hum.PlatformStand=true;hum.Sit=true
  rig=Rig.prepare(bike)
  local cf=CFrame.new(state.X,state.Y,state.Z)*CFrame.Angles(0,state.Yaw,0)
  Geometry.place(rig,cf)
  local offset=Geometry.offset(bike,copy)
  local weld=Instance.new("Weld");weld.Name="PermanentRiderMount";weld.Part0=rig.Frame;weld.Part1=root;weld.C0=rig.FrameFromRoot:Inverse()*offset;weld.Parent=rig.Frame
  bike:SetAttribute("OwnerUserId",player.UserId);bike:SetAttribute("VehicleId",id);bike:SetAttribute("Pedaling",id<=6);bike:SetAttribute("WheelRadius",if id==3 or id==8 then 1.15 else 1.43)
  for _,part in ipairs(bike:GetDescendants()) do if part:IsA("BasePart") then part.CanQuery=false end end
  bike.Parent=folder;copy.Parent=folder
  api.Bike=bike;api.Character=copy;api.Active=true;vehicle=id;rendered=cf
  scene=Surface.new(workspace,{character,folder,workspace:WaitForChild("PlayerBikes")},math.max(5.8,offset.Position.Y+root.Size.Y+1))
  return true
 end
 function api.intent(input:any) currentInput=input end
 function api.command(sequence:number,input:any)
  if not api.Active or not scene then return end
  Replay.command(reconciler,sequence,input,maxSpeed,scene);lastCommand=os.clock()
 end
 local ack=stateRemote.OnClientEvent:Connect(function(message)
  if not Replay.valid(message) or not Content.Vehicles[message.VehicleId] then return end
  -- Ignore stale epochs before changing the currently visible assembly.
  if type(message.Epoch)~="number" or message.Epoch<math.max(reconciler.Epoch,player:GetAttribute("DriveEpoch") or 0) then return end
  if message.Epoch==reconciler.Epoch and (message.Ack<=reconciler.Ack or message.Sequence<reconciler.Sequence) then return end
  if message.Mode~="Manual" or message.Auto==true or player:GetAttribute("Racing")==true or player:GetAttribute("AutoDriving")==true then reset();return end
  local changed=not api.Active or vehicle~=message.VehicleId or message.Epoch~=reconciler.Epoch
  if changed and not build(message.VehicleId,message.State) then return end
  if Replay.accept(reconciler,message,scene) then
   lastAck=os.clock();api.Epoch=reconciler.Epoch;api.Sequence=message.Sequence;api.JumpId=message.State.JumpId;maxSpeed=message.MaxSpeed
  end
 end)
 Run:BindToRenderStep("BikePresentation",Enum.RenderPriority.Camera.Value-2,function(dt:number)
  if not api.Active or not rig or not reconciler.State or player:GetAttribute("Racing")==true then return end
  if os.clock()-lastAck>Config.Bike.InputTimeout+.2 then reset();return end
  local state=table.clone(reconciler.State)
  local left=math.clamp(os.clock()-lastCommand,0,Config.Bike.InputInterval)
  while left>1e-6 do local step=math.min(Config.Bike.Tick,left);state=Sim.step(state,currentInput,step,maxSpeed,scene);left-=step end
  local target=CFrame.new(state.X,state.Y,state.Z)*CFrame.Angles(0,state.Yaw,0)
  if rendered and (rendered.Position-target.Position).Magnitude<12 then rendered=rendered:Lerp(target,1-math.exp(-math.min(dt,.1)*40)) else rendered=target end
  rig.Root.CFrame=rendered :: CFrame
  api.Bike:SetAttribute("Distance",state.Distance);api.Bike:SetAttribute("RaceSpeed",if (player:GetAttribute("SelectedTreadmill") or 0)>0 then 10 else math.abs(state.Speed))
  local authority=workspace:FindFirstChild("PlayerBikes")
  if authority then local model=authority:FindFirstChild("Rider_"..player.UserId);if model and model:IsA("Model") then hide(model) end end
  if player.Character then hide(player.Character) end
  -- Camera reads the rendered bike AFTER this presentation update.
 end)
 local racing=player:GetAttributeChangedSignal("Racing"):Connect(function() if player:GetAttribute("Racing")==true then reset() end end)
 local removing=player.CharacterRemoving:Connect(function() reset();reconciler=Replay.new() end)
 ui.Gui.Destroying:Connect(function() ack:Disconnect();Run:UnbindFromRenderStep("BikePresentation");racing:Disconnect();removing:Disconnect();reset();folder:Destroy() end)
 return api
end
return Prediction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="987">
          <Properties>
            <string name="Name">SignReadability</string>
            <string name="Source"><![CDATA[--!strict
-- Studio/private diagnostics only. No automatic concealment, resizing or replacement of bad geometry.
local Sign={}
function Sign.inspect(gui:SurfaceGui):{string}
 local issues={}
 local part=gui.Parent
 if not part or not part:IsA("BasePart") or gui.Adornee~=part then table.insert(issues,"Adornee mismatch") end
 if gui.SizingMode~=Enum.SurfaceGuiSizingMode.PixelsPerStud or gui.PixelsPerStud<64 then table.insert(issues,"Incorrect canvas sizing") end
 if gui.Face~=Enum.NormalId.Front and gui.Face~=Enum.NormalId.Back then table.insert(issues,"Incorrect caption face") end
 local text=gui:FindFirstChild("Caption")
 if not text or not text:IsA("TextLabel") or text.Text=="" then table.insert(issues,"Missing caption");return issues end
 if not text.TextScaled or text.ClipsDescendants or text.TextStrokeTransparency>=1 or text.ZIndex<1 then table.insert(issues,"Incorrect caption properties") end
 -- Bounds/Fits are renderer measurements, not constants to fabricate in the asset generator.
 local bounds=text.TextBounds
 if bounds.X>0 and bounds.Y>0 then
  if not text.TextFits or bounds.X>text.AbsoluteSize.X+1 or bounds.Y>text.AbsoluteSize.Y+1 then table.insert(issues,"Caption does not fit") end
 end
 return issues
end
function Sign.new(_settings:any,ui:any)
 local runtime=game:GetService("ReplicatedStorage"):WaitForChild("BikeRuntime")
 if runtime:GetAttribute("Diagnostics")~=true then return end
 task.delay(1,function()
  if not ui.Gui.Parent then return end
  local checked=0;local measured=0;local failures={}
  for _,object in ipairs(workspace:GetDescendants()) do
   if object:IsA("SurfaceGui") and object.Name=="SignCaption" then
    checked+=1
    local caption=object:FindFirstChild("Caption")
    if caption and caption:IsA("TextLabel") and caption.TextBounds.X>0 and caption.TextBounds.Y>0 then measured+=1 end
    local issues=Sign.inspect(object)
    if #issues>0 then table.insert(failures,object:GetFullName()..": "..table.concat(issues,", ")) end
   end
  end
  runtime:SetAttribute("SignDiagnostics",tostring(checked).." captions / "..tostring(measured).." measured / "..tostring(checked-measured).." pending / "..tostring(#failures).." problems")
  if #failures>0 then
   local message=string.sub(table.concat(failures,"; "),1,1000)
   runtime:SetAttribute("SignError",message);warn("[SignDiagnostics]",message)
  else runtime:SetAttribute("SignError",nil) end
 end)
end
return Sign
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="988">
          <Properties>
            <string name="Name">StationEffects</string>
            <string name="Source"><![CDATA[--!strict
local Input=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules=require(Shared:WaitForChild("Rules"))
local Stations={}
function Stations.new(settings:any,ui:any)
 local training=workspace:WaitForChild("World1"):WaitForChild("Training")
 local entries:any={}
 local effects=Instance.new("Folder");effects.Name="LocalTrainingSparks";effects.Parent=workspace
 for id=1,5 do
  local model=training:WaitForChild("Treadmill_"..id)
  local parts={}
  for _,part in ipairs(model:GetChildren()) do
   if part:IsA("BasePart") and (string.find(part.Name,"^BeltStripe_") or part.Name=="NeonEdge") then
    table.insert(parts,{Part=part,Base=part.CFrame,Color=part.Color,Transparency=part.Transparency})
   end
  end
  local zone=model:WaitForChild("Zone") :: BasePart
  local sparks={}
  for j=1,(if Input.TouchEnabled then 2 else 4) do
   local p=Instance.new("Part");p.Name="TrainingSpark";p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(.2,.2,.2);p.Color=Color3.fromRGB(115,255,217)
   p.Material=Enum.Material.Neon;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Transparency=1;p.Parent=effects;table.insert(sparks,p)
  end
  entries[id]={Zone=zone,Parts=parts,Sparks=sparks}
 end
 task.spawn(function()
  while ui.Gui.Parent do
   local camera=workspace.CurrentCamera;local now=os.clock();local snap=ui.Snapshot;local active=false
   for id,entry in ipairs(entries) do
    local nearby=camera~=nil and (camera.CFrame.Position-entry.Zone.Position).Magnitude<90
    local allowed=snap and Rules.canUseTreadmill(id,snap.Energy,snap.Rebirths,snap.OwnedWorlds or {1})
    local animate=nearby and settings.Animations and allowed
    if animate then active=true end
    for _,record in ipairs(entry.Parts) do
     local part=record.Part
     part.Color=if allowed then record.Color else Color3.fromRGB(77,83,104)
     if animate and string.find(part.Name,"^BeltStripe_") then
      local offset=(record.Base.Position.Z-entry.Zone.Position.Z+now*4+6)%12-6
      part.CFrame=record.Base+Vector3.new(0,0,entry.Zone.Position.Z+offset-record.Base.Position.Z)
     else part.CFrame=record.Base end
     part.Transparency=record.Transparency
    end
    for j,spark in ipairs(entry.Sparks) do
     spark.Transparency=if animate then .2 else 1
     if animate then spark.Position=entry.Zone.Position+Vector3.new(math.sin(now+j*2)*4,1+(now+j*.6)%3,math.cos(now+j)*4) end
    end
   end
   task.wait(if active then 1/15 else .3)
  end
  effects:Destroy()
  for _,entry in ipairs(entries) do for _,r in ipairs(entry.Parts) do if r.Part.Parent then r.Part.CFrame=r.Base;r.Part.Color=r.Color;r.Part.Transparency=r.Transparency end end end
 end)
end
return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="989">
          <Properties>
            <string name="Name">TrainingInput</string>
            <string name="Source"><![CDATA[--!strict
local Input=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tap=require(Shared:WaitForChild("TrainingTap"))
local Binding={}
function Binding.new(ui:any,send:(string)->())
 local gate=Tap.new(os.clock)
 local function press(kind:string,processed:boolean,position:Vector2?)
  local playerGui=ui.Gui.Parent
  if position and playerGui and playerGui:IsA("PlayerGui") then
   for _,object in ipairs(playerGui:GetGuiObjectsAtPosition(position.X,position.Y)) do
    local current:Instance?=object
    while current and current~=playerGui do
     if current:IsA("GuiButton") then processed=true;break end
     current=current.Parent
    end
   end
  end
  if gate:accept(kind,processed or Input:GetFocusedTextBox()~=nil,ui.Snapshot,ui.isMenuOpen()) then send("Click") end
 end
 local mouse=Input.InputBegan:Connect(function(input:InputObject,processed:boolean)
  if input.UserInputType==Enum.UserInputType.MouseButton1 then press("Mouse",processed,if input.Position then Vector2.new(input.Position.X,input.Position.Y) else nil) end
 end)
 -- Touch InputBegan is deliberately ignored: TouchTap is the sole touch source.
 local touch=Input.TouchTap:Connect(function(positions:{Vector2},processed:boolean)
  if #positions==1 then press("Touch",processed,positions[1]) end
 end)
 ui.Gui.Destroying:Connect(function() mouse:Disconnect();touch:Disconnect() end)
end
return Binding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="990">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
local TweenService=game:GetService("TweenService")
local UserInputService=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format=require(Shared:WaitForChild("Format"))
local Presentation=require(Shared:WaitForChild("Presentation"))
local Catalog=require(Shared:WaitForChild("Catalog"))
local Content=require(Shared:WaitForChild("World1Content"))
local Premium=require(Shared:WaitForChild("PremiumConfig"))
local PetRules=require(Shared:WaitForChild("PetRules"))
local State=require(Shared:WaitForChild("ClientState"))
local Icons=require(script.Parent.Icons)
local UI={}
local white=Color3.new(1,1,1)
local palette={Rebirths=Color3.fromRGB(121,90,205),Garage=Color3.fromRGB(44,133,204),Pets=Color3.fromRGB(194,85,181),Race=Color3.fromRGB(231,94,55),Worlds=Color3.fromRGB(47,168,188),Shop=Color3.fromRGB(43,169,105),Settings=Color3.fromRGB(54,130,174)}
local function make(class:string,parent:Instance?,props:any):any
 local o:any=Instance.new(class);for k,v in pairs(props) do o[k]=v end;o.Parent=parent;return o
end
local function corner(o:Instance,r:number) make("UICorner",o,{CornerRadius=UDim.new(0,r)}) end
local function text(parent:Instance,value:string,height:number):any
 return make("TextLabel",parent,{Size=UDim2.new(1,-16,0,height),BackgroundTransparency=1,Text=value,TextWrapped=true,TextColor3=white,TextSize=16,Font=Enum.Font.GothamBold,LayoutOrder=0})
end
function UI.new(playerGui:Instance,settings:any,audio:any):any
 for _,name in ipairs({"PalmBaySidebar","BikeHUDV3","BikeHUDV4"}) do
  local old=playerGui:FindFirstChild(name);if old then old:Destroy() end
 end
 local gui=make("ScreenGui",playerGui,{Name="BikeHUDV4",ResetOnSpawn=false,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
 local root=make("Frame",gui,{Size=UDim2.new(1,-16,1,-16),Position=UDim2.fromOffset(8,8),BackgroundTransparency=1})
 local sidebar=make("Frame",root,{Name="MenuSidebar",Size=UDim2.fromOffset(160,400),AnchorPoint=Vector2.new(0,.5),Position=UDim2.new(0,0,.5,0),BackgroundTransparency=1,BorderSizePixel=0})
 local scale=make("UIScale",sidebar,{Scale=1})
 local toggle=make("TextButton",sidebar,{Name="MenuToggle",Size=UDim2.fromOffset(44,28),Text="☰",TextColor3=white,TextSize=22,Font=Enum.Font.GothamBold,BackgroundTransparency=1,BorderSizePixel=0})
 local list=make("Frame",sidebar,{Name="Navigation",Position=UDim2.fromOffset(0,32),Size=UDim2.new(1,0,1,-32),BackgroundTransparency=1,BorderSizePixel=0})
 local buttons:any={};local labels:any={};local scales:any={};local activeTweens:any={}
 local function tween(object:any,properties:any,duration:number?)
  if activeTweens[object] then activeTweens[object]:Cancel();activeTweens[object]=nil end
  if not settings.Animations then for key,value in pairs(properties) do object[key]=value end;return end
  local t=TweenService:Create(object,TweenInfo.new(duration or 0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties)
  activeTweens[object]=t;t.Completed:Once(function() if activeTweens[object]==t then activeTweens[object]=nil end end);t:Play()
 end
 local sidebarHeight=400
 local arrange:()->()=function() end
 local generation=0
 local api:any={Gui=gui,Settings=settings,Buttons=buttons,Snapshot=nil,Viewport=nil,OnAction=function() end,OnSetting=function() end,OnMenu=function() end,Difficulty="Easy"}
 -- V2 contract: this transparent container lays out free-standing icons and values only.
 local resourceCanvas=make("Frame",gui,{Name="SafeResourceCanvas",Position=UDim2.fromOffset(0,0),ZIndex=0,Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0})
 local resourceHUD=make("Frame",resourceCanvas,{Name="ResourceHUD",AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-10,1,-10),Size=UDim2.fromOffset(190,108),BackgroundTransparency=1,BorderSizePixel=0})
 local resourceValues:any={};local resourceRows:any={};local resourceIcons:any={}
 for i,name in ipairs({"Energy","Cash","Rebirths"}) do
  local holder=make("Frame",resourceHUD,{Name=name.."Status",Size=UDim2.new(1,0,0,36),Position=UDim2.fromOffset(0,(i-1)*36),BackgroundTransparency=1,BorderSizePixel=0})
  local icon=Icons.resource(holder,name);make("UIScale",icon,{Scale=1});resourceIcons[name]=icon;resourceRows[name]=holder
  resourceValues[name]=make("TextLabel",holder,{Name="Value",Position=UDim2.fromOffset(40,0),Size=UDim2.new(1,-40,1,0),BackgroundTransparency=1,BorderSizePixel=0,Text="—",TextColor3=white,TextSize=27,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right,TextStrokeColor3=Color3.fromRGB(14,45,61),TextStrokeTransparency=0.25,TextWrapped=false,TextScaled=true})
  make("UITextSizeConstraint",resourceValues[name],{MinTextSize=12,MaxTextSize=27})
 end
 api.ResourceHUD=resourceHUD;api.ResourceValues=resourceValues
 for i,name in ipairs({"Garage","Pets","Race","Worlds","Rebirths","Shop","Settings"}) do
  local button=make("TextButton",list,{Name=name,LayoutOrder=i,Size=UDim2.new(1,-4,0,47),BackgroundColor3=white,BackgroundTransparency=0.04,BorderSizePixel=0,Text="",AutoButtonColor=false})
  local ends={Garage={Color3.fromRGB(44,224,220),Color3.fromRGB(42,88,218)},Pets={Color3.fromRGB(247,118,206),Color3.fromRGB(136,69,217)},Race={Color3.fromRGB(255,179,68),Color3.fromRGB(232,65,74)},Worlds={Color3.fromRGB(65,222,243),Color3.fromRGB(36,174,114)},Rebirths={Color3.fromRGB(172,106,245),Color3.fromRGB(65,112,234)},Shop={Color3.fromRGB(172,234,72),Color3.fromRGB(39,195,176)},Settings={Color3.fromRGB(112,203,251),Color3.fromRGB(40,102,180)}}
  corner(button,12)
  make("Frame",button,{Name="ButtonDepth",Size=UDim2.new(1,-4,0,4),Position=UDim2.new(0,2,1,-1),BackgroundColor3=palette[name],BorderSizePixel=0})
  make("UIGradient",button,{Color=ColorSequence.new(ends[name][1],ends[name][2]),Rotation=30})
  make("UIStroke",button,{Color=white,Transparency=0.8,Thickness=1})
  Icons.draw(button,name)
  labels[name]=make("TextLabel",button,{Position=UDim2.fromOffset(48,0),Size=UDim2.new(1,-52,1,0),BackgroundTransparency=1,Text=name,TextColor3=white,TextSize=14,TextStrokeTransparency=0.65,TextStrokeColor3=Color3.fromRGB(16,72,95),TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold,TextWrapped=true})
  local hover=make("UIScale",button,{Scale=1});scales[name]=hover;buttons[name]=button
  button.MouseEnter:Connect(function() if settings.Animations then tween(hover,{Scale=1.025}) end end)
  button.MouseLeave:Connect(function() tween(hover,{Scale=1}) end)
  button.Activated:Connect(function()
   audio.play("Button");settings.Active=name
   for key,b in pairs(buttons) do local s=b:FindFirstChildOfClass("UIStroke");if s then tween(s,{Thickness=if key==name then 3 else 1,Transparency=if key==name then 0.1 else 0.8}) end end
   tween(button,{BackgroundTransparency=0},0.07);task.delay(0.1,function() if button.Parent then tween(button,{BackgroundTransparency=0.08}) end end)
   api.CurrentMenu=name;api.OnMenu(name)
  end)
 end
 local autoBar=make("Frame",root,{Name="AutomationControls",AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,0),Size=UDim2.fromOffset(270,38),BackgroundTransparency=1})
 local switches:any={}
 for index,key in ipairs({"AutoTrain","AutoRace","SlowMode"}) do
  local parent=if key=="SlowMode" then root else autoBar
  local b=make("TextButton",parent,{Name=key,Size=UDim2.fromOffset(128,38),Position=if key=="SlowMode" then UDim2.new(0,0,1,-42) else UDim2.fromOffset((index-1)*136,0),BackgroundColor3=white,TextColor3=white,TextStrokeTransparency=.45,TextStrokeColor3=Color3.fromRGB(15,65,85),TextSize=13,Font=Enum.Font.GothamBold,BorderSizePixel=0,Text="",AutoButtonColor=false})
  corner(b,12);make("UIGradient",b,{Color=ColorSequence.new(Color3.fromRGB(79,212,207),Color3.fromRGB(65,110,207)),Rotation=25})
  switches[key]=b
  b.Activated:Connect(function()
   if not api.Snapshot then return end
   local mode=api.Snapshot.Automation or {};api.OnAction("Automation",{Setting=key,Enabled=not mode[key],Difficulty=api.Difficulty})
  end)
 end
 local boostText=make("TextLabel",autoBar,{Name="ActiveBoosts",Size=UDim2.new(1,80,0,32),Position=UDim2.fromOffset(-40,39),BackgroundTransparency=1,Text="",TextColor3=white,TextStrokeTransparency=.25,TextStrokeColor3=Color3.fromRGB(15,55,75),TextSize=12,Font=Enum.Font.GothamBold})
 local noticeToast=make("TextLabel",root,{Name="ActionNotice",Visible=false,AnchorPoint=Vector2.new(0.5,0),Size=UDim2.new(0.7,0,0,58),Position=UDim2.fromScale(0.6,0.14),BackgroundTransparency=1,Text="",TextWrapped=true,TextColor3=white,TextStrokeColor3=Color3.fromRGB(15,55,68),TextStrokeTransparency=0.2,TextSize=15,Font=Enum.Font.GothamBold})
 local overlay=make("TextButton",root,{Visible=false,Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(12,51,68),BackgroundTransparency=0.3,Text="",AutoButtonColor=false,ZIndex=20})
 local window=make("Frame",overlay,{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.new(0.9,0,0.85,0),Position=UDim2.fromScale(0.5,0.5),BackgroundColor3=Color3.fromRGB(26,98,134),BorderSizePixel=0,ZIndex=21});corner(window,22)
 local windowStroke=make("UIStroke",window,{Color=Color3.fromRGB(140,242,255),Thickness=2,Transparency=.25})
 local windowGradient=make("UIGradient",window,{Color=ColorSequence.new(Color3.fromRGB(199,247,255),Color3.fromRGB(112,178,228)),Rotation=100})
 make("UISizeConstraint",window,{MaxSize=Vector2.new(560,560),MinSize=Vector2.new(240,200)})
 local titleIcon=make("Frame",window,{Name="MenuTitleIcon",Size=UDim2.fromOffset(40,40),Position=UDim2.fromOffset(8,4),BackgroundTransparency=1,ZIndex=22})
 local heading=make("TextLabel",window,{Size=UDim2.new(1,-110,0,48),Position=UDim2.fromOffset(48,0),Text="",BackgroundTransparency=1,TextColor3=white,TextSize=22,TextScaled=true,TextWrapped=false,Font=Enum.Font.GothamBold,ZIndex=22})
 make("UITextSizeConstraint",heading,{MinTextSize=12,MaxTextSize=22})
 local close=make("TextButton",window,{Size=UDim2.fromOffset(42,38),Position=UDim2.new(1,-50,0,6),Text="×",TextColor3=white,TextSize=28,BackgroundTransparency=1,ZIndex=22})
 local content=make("ScrollingFrame",window,{Size=UDim2.new(1,-24,1,-90),Position=UDim2.fromOffset(12,54),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ZIndex=22})
 local notice=make("TextLabel",window,{Size=UDim2.new(1,-20,0,26),Position=UDim2.new(0,10,1,-28),BackgroundTransparency=1,Text="",TextColor3=Color3.fromRGB(255,234,150),TextSize=12,TextWrapped=true,ZIndex=24,Font=Enum.Font.GothamBold})
 local function clear()
  api.Viewport=nil
  for object,t in pairs(activeTweens) do if object:IsDescendantOf(content) then t:Cancel();activeTweens[object]=nil end end
  for _,child in ipairs(content:GetChildren()) do child:Destroy() end
  make("UIListLayout",content,{Padding=UDim.new(0,12),HorizontalAlignment=Enum.HorizontalAlignment.Center,SortOrder=Enum.SortOrder.LayoutOrder})
 end
 local function row(value:string,height:number?):any
  local l=text(content,value,height or 52);l.ZIndex=23;l.TextSize=15;l.TextStrokeTransparency=.8
  return l
 end
 local function bar(ratio:number):any
  local frame=make("Frame",content,{Size=UDim2.new(1,-20,0,15),BackgroundColor3=Color3.fromRGB(13,76,98),BorderSizePixel=0,ZIndex=23});corner(frame,8)
  local fill=make("Frame",frame,{Size=UDim2.fromScale(0,1),BackgroundColor3=Color3.fromRGB(111,234,115),BorderSizePixel=0,ZIndex=24});corner(fill,8)
  tween(fill,{Size=UDim2.fromScale(math.clamp(ratio,0,1),1)},0.3);return fill
 end
 local function command(value:string,callback:()->()):any
  local b=make("TextButton",content,{Size=UDim2.new(1,-20,0,48),Text=value,TextColor3=white,TextSize=16,TextWrapped=true,Font=Enum.Font.GothamBold,BackgroundColor3=palette[api.CurrentMenu] or palette.Worlds,BorderSizePixel=0,ZIndex=23});corner(b,12)
  make("UIGradient",b,{Color=ColorSequence.new(Color3.fromRGB(207,255,242),Color3.fromRGB(114,189,245)),Rotation=22})
  make("UIStroke",b,{Color=white,Transparency=.7,Thickness=1})
  b.TextStrokeTransparency=.7;b.TextStrokeColor3=Color3.fromRGB(20,74,103)
  local scale=make("UIScale",b,{Scale=1})
  b.MouseEnter:Connect(function() tween(scale,{Scale=1.015},.12) end)
  b.MouseLeave:Connect(function() tween(scale,{Scale=1},.12) end)
  b.Activated:Connect(function() audio.play("Button");callback() end);return b
 end
 function api.preview(folder:Instance,modelName:string,pet:boolean):any
  local view=make("ViewportFrame",content,{Size=UDim2.new(1,-20,0,180),BackgroundColor3=Color3.fromRGB(26,76,100),BorderSizePixel=0,Ambient=Color3.fromRGB(200,220,230),LightColor=white,ZIndex=23});corner(view,14)
  local world=Instance.new("WorldModel");world.Parent=view
  local source=folder:FindFirstChild(modelName)
  local distance=if pet then 5 else 10
  if source and source:IsA("Model") then
   local model=source:Clone();model.Parent=world
   local bounds,size=model:GetBoundingBox()
   model:PivotTo(CFrame.new(-bounds.Position)*model:GetPivot())
   distance=math.max(3,math.max(size.X,size.Y,size.Z)*1.45)
  else row("Modell fehlt: "..modelName,35) end
  local camera=Instance.new("Camera");camera.FieldOfView=40;camera.CFrame=CFrame.lookAt(Vector3.new(distance*0.75,distance*0.4,distance),Vector3.zero);camera.Parent=view;view.CurrentCamera=camera
  api.Viewport={Camera=camera,Frame=view,Distance=distance,TargetY=0}
  return view
 end
 function api.collapse(value:boolean)
  State.setting(settings,"Collapsed",value)
  arrange()
  api.OnSetting()
 end
 toggle.Activated:Connect(function() audio.play("Button");api.collapse(not settings.Collapsed) end)
 local function hide()
  api.Closing=true
  local token=generation
  api.Viewport=nil
  tween(window,{Position=UDim2.fromScale(0.5,0.53)},0.12)
  task.delay(if settings.Animations then 0.12 else 0,function() if generation==token then overlay.Visible=false;api.Viewport=nil end end)
 end
 close.Activated:Connect(hide)
 function api.open(name:string)
  api.Closing=false
  content.CanvasPosition=Vector2.zero
  api.CurrentMenu=name
  generation+=1
  clear();notice.Text="";heading.Text=({Rebirths="REBIRTH",Pets="PETS",Garage="BIKE GARAGE",Eggs="EGGS",Egg="EGG HATCH",Hatch="NEUES PET",Race="RACE",Worlds="WORLDS",Shop="SHOP",Settings="SETTINGS"})[name] or name
  local accent=palette[name] or palette.Pets
  windowStroke.Color=accent
  windowGradient.Rotation=if name=="Race" then 25 else 100
  for _,child in ipairs(titleIcon:GetChildren()) do child:Destroy() end
  local icon=Icons.draw(titleIcon,if name=="Egg" or name=="Eggs" or name=="Hatch" then "Pets" else name);icon.Position=UDim2.fromOffset(0,0);icon.Size=UDim2.fromOffset(34,34)
  overlay.Visible=true;window.Position=UDim2.fromScale(0.5,0.53);tween(window,{Position=UDim2.fromScale(0.5,0.5)})
  local snap=api.Snapshot
  if name=="Settings" then
   for _,entry in ipairs({{Key="Animations",Label="Animationen"},{Key="Popups",Label="Energy-Pop-ups"},{Key="Sound",Label="Soundeffekte"},{Key="Collapsed",Label="Kompakte Sidebar"}}) do
    local b:any
    b=command(entry.Label..": "..(if settings[entry.Key] then "AN" else "AUS"),function()
     if entry.Key=="Collapsed" then api.collapse(not settings.Collapsed) else State.setting(settings,entry.Key,not settings[entry.Key]) end
     b.Text=entry.Label..": "..(if settings[entry.Key] then "AN" else "AUS");api.OnSetting()
    end)
   end
   local volume=row("Lautstärke: "..math.floor(settings.Volume*100).." %",30)
   command("− Leiser",function() State.setting(settings,"Volume",settings.Volume-0.1);volume.Text="Lautstärke: "..math.floor(settings.Volume*100).." %";api.OnSetting() end)
   command("+ Lauter",function() State.setting(settings,"Volume",settings.Volume+0.1);volume.Text="Lautstärke: "..math.floor(settings.Volume*100).." %";api.OnSetting() end)
  elseif name=="Shop" then
   row("PREMIUM SHOP",40)
   row("Roblox bestätigt Preis und Zahlung. Unkonfigurierte Angebote und Käufe im nicht persistenten Studio-Preview bleiben deaktiviert.",65)
   for _,category in ipairs({"Gamepasses","Cash Bundles","Boost Potions","Exclusive Pets"}) do
    row(category,32)
    local offers=if category=="Gamepasses" then Premium.Passes else Premium.Products
    local keys={};for key,def in pairs(offers) do if category=="Gamepasses" or def.Category==category then table.insert(keys,key) end end;table.sort(keys)
    for _,key in ipairs(keys) do
     local def=offers[key];local enabled=def.Id>0 and not def.Unavailable and snap and snap.PremiumAvailable==true
     if def.ExclusiveId then local pet=Premium.Exclusives[def.ExclusiveId];api.preview(game:GetService("ReplicatedStorage").PetModels,pet.Model,true);row("Energy ×"..pet.EnergyMultiplier.." / Cash ×"..pet.CashMultiplier,30) end
     local b=command(def.Name..(if enabled then " • Roblox-Kauf öffnen" elseif def.Id<=0 then " • NOCH NICHT KONFIGURIERT" else " • IM PREVIEW GESPERRT"),function() if enabled then api.OnAction("Premium",{Offer=key}) end end)
     b.Active=enabled;b.AutoButtonColor=enabled;b.BackgroundTransparency=if enabled then 0 else .4
    end
   end
   command("Fahrzeuge kaufen",function() api.open("Garage") end)
   command("Eier kaufen / öffnen",function() api.open("Eggs") end)
   command("Pet-Inventar",function() api.open("Pets") end)
  elseif name=="Worlds" and snap then
   row("WELTEN • "..#(snap.OwnedWorlds or {1}).." / 8 freigeschaltet",45)
   for id=1,8 do
    local owned=table.find(snap.OwnedWorlds or {1},id)~=nil
    row((if id==1 then "PALM BAY" else "WELT "..id).." • "..(if owned then "Freigeschaltet" else "Gesperrt")..(if id>1 then "\nMap noch nicht in diesem Build. Keine Reise/Käufe." else "\nAktuelle Insel"),60)
   end
   command("Rennen in Palm Bay",function() api.open("Race") end)
  elseif name=="Garage" and snap then
   local id=api.VehicleId or snap.ActiveVehicle or 1
   if not Content.Vehicles[id] then id=1 end
   local definition=Catalog.Vehicles[id]
   row(definition.Name.." • ID "..id.." • Tempo ×"..Format.multiplier(definition.SpeedMultiplier),45)
   api.preview(game:GetService("ReplicatedStorage").Vehicles,definition.Model,false)
   local owned=table.find(snap.OwnedVehicles or {1},id)~=nil
   row(if snap.ActiveVehicle==id then "✓ AKTIV AUSGERÜSTET" elseif owned then "In deinem Besitz" else Format.number(definition.CashCost).." Cash",30)
   if snap.ActiveVehicle~=id then command(if owned then "Ausrüsten" else "Kaufen",function() api.OnAction(if owned then "EquipVehicle" else "BuyVehicle",{VehicleId=id}) end) end
   for vehicleId=1,10 do local v=Catalog.Vehicles[vehicleId];command(v.Name.." • "..Format.number(v.CashCost).." Cash",function() api.VehicleId=vehicleId;api.open("Garage") end) end
  elseif name=="Pets" and snap then
   row("Pets • "..#(snap.EquippedPets or {}).." / 3 ausgerüstet\nEnergy ×"..Format.multiplier(snap.PetEnergyBonus or 1).." • Cash ×"..Format.multiplier(snap.PetCashBonus or 1),65)
   local best=command("⚡ EQUIP BEST",function() api.OnAction("EquipBest") end)
   best.BackgroundColor3=Color3.fromRGB(19,162,127)
   make("UIGradient",best,{Color=ColorSequence.new(Color3.fromRGB(132,255,137),Color3.fromRGB(87,210,255)),Rotation=20})
   row("Einmalig die drei besten Pets • Energy und Cash gleich gewichtet",35)
   command("UNEQUIP ALL",function() api.OnAction("UnequipAll") end)
   local activeNames={}
   for _,id in ipairs(snap.EquippedPets or {}) do local pet=snap.Pets[id];if pet then table.insert(activeNames,PetRules.definition(pet).Name or "Unbekannt") end end
   row("Slots: "..(if #activeNames==0 then "leer / leer / leer" else table.concat(activeNames," / ")),50)
   command("Eier öffnen",function() api.open("Eggs") end)
   command("Pet-Index",function() api.open("Index") end)
   local ids={};for id in pairs(snap.Pets or {}) do table.insert(ids,id) end;table.sort(ids)
   if #ids==0 then row("Noch keine Pets. Verdiene Cash im Rennen und öffne ein Ei.",65) end
   local page=math.clamp(api.PetPage or 1,1,math.max(1,math.ceil(#ids/20)));api.PetPage=page
   row("Inventarseite "..page.." / "..math.max(1,math.ceil(#ids/20)),25)
   for i=(page-1)*20+1,math.min(page*20,#ids) do
    local id=ids[i];local pet=snap.Pets[id];local d=PetRules.definition(pet)
    local b=command((if table.find(snap.EquippedPets,id) then "✓ " else "")..(d.Name or "Unbekannte Art").." • "..pet.Variant..(if d.Playable then "\nEnergy ×"..Format.multiplier(1+(d.EnergyMultiplier-1)*Content.Variants[pet.Variant]).." • Cash ×"..Format.multiplier(1+(d.CashMultiplier-1)*Content.Variants[pet.Variant]) else ""),function() api.PetId=id;api.open("Pet") end)
    b.TextSize=14;b.TextWrapped=true;b.Size=UDim2.new(1,-20,0,58)
    local rarity=b:FindFirstChildOfClass("UIStroke");if rarity then rarity.Color=if d.Rarity=="Legendary" then Color3.fromRGB(255,222,109) elseif d.Rarity=="Rare" then Color3.fromRGB(194,149,255) else Color3.fromRGB(135,240,217) end
   end
   if page>1 then command("← Vorherige Seite",function() api.PetPage=page-1;api.open("Pets") end) end
   if page*20<#ids then command("Nächste Seite →",function() api.PetPage=page+1;api.open("Pets") end) end
  elseif name=="Pet" and snap then
   local id=api.PetId;local pet=snap.Pets[id]
   if pet then
    local d=PetRules.definition(pet);local factor=Content.Variants[pet.Variant]
    row((d.Name or "Unbekannte Art").." • "..pet.Variant.." • "..(d.Rarity or "Offen"),45)
    if d.Playable then api.preview(game:GetService("ReplicatedStorage").PetModels,d.Model or "Pet"..pet.SpeciesId,true);row("Energy ×"..Format.multiplier(1+(d.EnergyMultiplier-1)*factor).." • Cash ×"..Format.multiplier(1+(d.CashMultiplier-1)*factor),35) end
    local equipped=table.find(snap.EquippedPets,id)~=nil
    command(if equipped then "Ablegen" else "Ausrüsten",function() api.OnAction(if equipped then "UnequipPet" else "EquipPet",{PetId=id}) end)
   end
   command("Zurück zum Inventar",function() api.open("Pets") end)
  elseif name=="Index" and snap then
   local found=0;for _,id in ipairs(snap.DiscoveredPets or {}) do if id<=12 then found+=1 end end
   row("Welt-1-Sammlung: "..found.." / 12",35)
   for eggId=1,3 do
    row(Catalog.Eggs[eggId].Name,30)
    for _,id in ipairs(Catalog.Eggs[eggId].Species) do local pet=Catalog.Pets[id];row((if table.find(snap.DiscoveredPets or {},id) then "✓ "..pet.Name else "???").." • "..pet.Rarity,32) end
   end
  elseif name=="Eggs" then
   row("Drei Eier • Je vier mögliche Pet-Arten",40)
   for eggId=1,3 do local e=Catalog.Eggs[eggId];command(e.Name.." • "..Format.number(e.CashCost).." Cash",function() api.EggId=eggId;api.open("Egg") end) end
  elseif name=="Egg" then
   local id=api.EggId or 1;local egg=Catalog.Eggs[id]
   row(egg.Name.." • "..Format.number(egg.CashCost).." Cash",40)
   for i,species in ipairs(egg.Species) do local d=Catalog.Pets[species];row(d.Name.." • "..d.Rarity.." • "..egg.Weights[i]/100 .." %\nEnergy ×"..Format.multiplier(d.EnergyMultiplier).." • Cash ×"..Format.multiplier(d.CashMultiplier),54) end
   command("Ei öffnen",function() api.OnAction("Hatch",{EggId=id}) end)
   command("Alle Eier",function() api.open("Eggs") end)
  elseif name=="Hatch" then
   local id=api.HatchedId;local d=Catalog.Pets[id]
   row("ERHALTEN: "..d.Name.." • "..d.Rarity,45)
   local view=api.preview(game:GetService("ReplicatedStorage").PetModels,"Pet"..id,true)
   if settings.Animations then local reveal=make("UIScale",view,{Scale=0.35});tween(reveal,{Scale=1},0.45) end
   command("Zum Pet-Inventar",function() api.open("Pets") end)
  elseif name=="Rebirths" and snap then
   local p=Presentation.rebirth(snap)
   api.RebirthInfo=row("",110);api.RebirthBar=bar(p.Ratio)
   api.RebirthConfirm=command("Rebirth bestätigen",function() if api.Snapshot and Presentation.rebirth(api.Snapshot).Allowed then api.OnAction("Rebirth");hide() end end)
   command("Abbrechen",hide)
  elseif name=="Race" then
   row("WORLD 1 • 800 Studs • 5 Bots\nEnergy wird nicht verbraucht.",55)
   for _,tier in ipairs({"Easy","Medium","Hard"}) do command((if api.Difficulty==tier then "✓ " else "")..tier,function() api.Difficulty=tier;if api.Snapshot and api.Snapshot.Automation and api.Snapshot.Automation.AutoRace then api.OnAction("Automation",{Setting="AutoRace",Enabled=true,Difficulty=tier}) end;api.open("Race") end) end
   local tier=Content.Difficulties[api.Difficulty]
   row("Bot-Tempo: "..table.concat(tier.Speeds," / ").."\nCash Plätze 1–6: "..table.concat(tier.Rewards," / "),60)
   api.RaceInfo=row("",70);api.RaceBar=bar(0)
   if api.LastRaceResult then row("Ergebnis "..(api.LastRaceResult.Difficulty or "")..": Platz "..(api.LastRaceResult.Place or "—").." • +"..Format.number(api.LastRaceResult.Reward or 0).." Cash",50) end
   command("Rennen starten / erneut starten",function() api.OnAction("StartRace",{Difficulty=api.Difficulty});hide() end)
   command("Rennen abbrechen",function() api.OnAction("AbortRace");hide() end)
  else row(name.." • VORSCHAU\nDieser Bereich ist noch nicht spielbar. Keine Käufe oder Belohnungen.",90) end
  api.update(api.Snapshot)
 end
 function api.update(snap:any)
  if not snap then return end
  local oldRevision=if api.Snapshot then api.Snapshot.InventoryRevision else nil
  api.Snapshot=snap
  if oldRevision~=nil and snap.InventoryRevision~=oldRevision and overlay.Visible and not api.Closing and (api.CurrentMenu=="Garage" or api.CurrentMenu=="Pets" or api.CurrentMenu=="Pet" or api.CurrentMenu=="Index") then
   api.open(api.CurrentMenu)
  end
  for _,name in ipairs({"Energy","Cash","Rebirths"}) do
   local old=resourceValues[name]:GetAttribute("ConfirmedValue")
   resourceValues[name].Text=Format.number(snap[name]);resourceValues[name]:SetAttribute("ConfirmedValue",snap[name])
   if old and snap[name]>old and settings.Animations then
    local glint=resourceIcons[name]:FindFirstChild(if name=="Energy" then "BoltGlint" else "CoinGlint")
    if glint then glint.BackgroundTransparency=0;task.delay(.12,function() if glint.Parent then tween(glint,{BackgroundTransparency=.75},.25) end end) end
    local pop=resourceIcons[name]:FindFirstChildOfClass("UIScale");if pop then tween(pop,{Scale=1.17},.08);task.delay(.1,function() if pop.Parent then tween(pop,{Scale=1},.17) end end) end
   end
  end
  local mode=snap.Automation or {}
  for key,b in pairs(switches) do
   local label=({AutoTrain="AUTO TRAIN",AutoRace="AUTO RACE",SlowMode="SLOW MODE"})[key]
   b.Text=label..(if mode[key] then " • ON" else " • OFF")
  end
  local boosts=snap.Boosts or {};local active={}
  for _,kind in ipairs({"Energy","Cash"}) do if (boosts[kind] or 0)>0 then table.insert(active,kind.." ×2 • "..math.ceil(boosts[kind]).."s") end end
  boostText.Text=table.concat(active,"  /  ")
  if api.RebirthInfo and api.RebirthInfo.Parent then
   local r=Presentation.rebirth(snap);api.RebirthInfo.Text="Rebirths: "..Format.number(r.Current).."\nMultiplikator ×"..Format.multiplier(r.Multiplier).." → ×"..Format.multiplier(r.NextMultiplier).."\nBenötigt: "..Format.number(r.Requirement).." Energy\nEnergy wird auf 0 gesetzt. Laufbandzugang kann entfallen."
   tween(api.RebirthBar,{Size=UDim2.fromScale(r.Ratio,1)});api.RebirthConfirm.Text=if r.Allowed then "Rebirth bestätigen" else "Noch nicht genug Energy";api.RebirthConfirm.Active=r.Allowed;api.RebirthConfirm.AutoButtonColor=r.Allowed
  end
  if api.RaceInfo and api.RaceInfo.Parent then
   local race=snap.Race or {Phase="Idle",Progress=0};api.RaceInfo.Text=(race.Difficulty or "Easy").." • "..(Catalog.Vehicles[snap.ActiveVehicle or 1].Name or "Fahrzeug").."\n"..race.Phase.." • Platz "..(race.Place or "—").." / 6 • "..math.floor(race.Progress*100).." %"
   tween(api.RaceBar,{Size=UDim2.fromScale(race.Progress,1)})
  end
 end
 api.Notice=noticeToast;api.Sidebar=sidebar;api.Navigation=list
 function api.isMenuOpen():boolean return overlay.Visible end
 local toastSequence=0
 function api.message(value:string)
  toastSequence+=1;local token=toastSequence
  noticeToast.Text=value;noticeToast.Visible=true;notice.Text=value
  task.delay(4,function() if token==toastSequence then noticeToast.Visible=false end end)
 end
 function api.refreshSettings()
  if not settings.Animations then
   for object,t in pairs(activeTweens) do t:Cancel();activeTweens[object]=nil end
   for _,s in pairs(scales) do s.Scale=1 end
   arrange()
   window.Position=UDim2.fromScale(0.5,0.5)
  end
 end
 local function layout()
  local size=root.AbsoluteSize
  arrange()
  local touch=UserInputService.TouchEnabled
  local compact=touch or size.X<600
  local rowHeight=if compact then 30 else 36
  local hudWidth=if compact then 136 else 160
  -- Exact 10px inset from the unpadded CoreUISafeInsets canvas, on every device.
  -- The owned touch jump button moves above this HUD instead of pushing resources inward.
  resourceHUD.Position=UDim2.new(1,-10,1,-10)
  resourceHUD.Size=UDim2.fromOffset(hudWidth,rowHeight*3)
  for i,name in ipairs({"Energy","Cash","Rebirths"}) do
   resourceRows[name].Position=UDim2.fromOffset(0,(i-1)*rowHeight)
   resourceRows[name].Size=UDim2.new(1,0,0,rowHeight)
   resourceIcons[name].Size=UDim2.fromOffset(rowHeight,rowHeight)
   resourceValues[name].TextSize=if compact then 22 else 27
   resourceValues[name]:FindFirstChildOfClass("UITextSizeConstraint").MaxTextSize=if compact then 22 else 27
   resourceValues[name].Position=UDim2.fromOffset(rowHeight+6,0)
   resourceValues[name].Size=UDim2.new(1,-rowHeight-6,1,0)
  end
 end
 arrange=function()
  local size=root.AbsoluteSize
  local short=size.Y<420
  local columns=1
  local compact=settings.Collapsed or short or size.X<320
  local width=if compact then 48 else 158
  local height=44;local gap=6
  local rows=math.ceil(7/columns)
  sidebarHeight=32+rows*(height+gap)-gap
  local available=math.max(100,size.Y-126)
  scale.Scale=math.min(1,available/sidebarHeight)
  sidebar.Size=UDim2.fromOffset(columns*(width+gap)-gap,sidebarHeight)
  for i,name in ipairs({"Garage","Pets","Race","Worlds","Rebirths","Shop","Settings"}) do
   buttons[name].Size=UDim2.fromOffset(width,height)
   buttons[name].Position=UDim2.fromOffset(((i-1)%columns)*(width+gap),math.floor((i-1)/columns)*(height+gap))
   labels[name].Visible=not compact
  end
 end
 resourceCanvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
 root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout);layout();api.collapse(settings.Collapsed)
 return api
end
return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="991">
          <Properties>
            <string name="Name">Visuals</string>
            <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Pose=require(script.Parent.AvatarPose)
local Visuals={}
function Visuals.new(settings:any,ui:any):any
 local poses:any={};local bikes:any={};local connection:RBXScriptConnection?=nil
 local api:any={}
 local function restore()
  for player,pose in pairs(poses) do Pose.destroy(pose.Record);poses[player]=nil end
  for bike,record in pairs(bikes) do
   for motor,base in pairs(record.Bases) do if motor.Parent then motor.C0=base end end
   bikes[bike]=nil
  end
 end
 local function visible(character:Model?):boolean
  if not character then return false end
  local root=character:FindFirstChild("HumanoidRootPart")
  local camera=workspace.CurrentCamera
  return root~=nil and root:IsA("BasePart") and (not camera or (root.Position-camera.CFrame.Position).Magnitude<230)
 end
 local function frame(dt:number)
  local folder=workspace:FindFirstChild("ActiveRaceBikes")
  local riderBikes:any={}
  local models=if folder then folder:GetChildren() else {}
  local persistent=workspace:FindFirstChild("PlayerBikes")
  if persistent then for _,bike in ipairs(persistent:GetChildren()) do table.insert(models,bike) end end
  if ui.Prediction and ui.Prediction.Active then table.insert(models,ui.Prediction.Bike) end
  do
   for _,bike in ipairs(models) do
    if not bike:IsA("Model") or not bike.PrimaryPart then continue end
    if bike:GetAttribute("Bot") and bike:GetAttribute("RaceOwnerUserId")~=Players.LocalPlayer.UserId then
     if not bike:GetAttribute("LocallyHidden") then
      for _,part in ipairs(bike:GetDescendants()) do if part:IsA("BasePart") then part.LocalTransparencyModifier=1 end end
      bike:SetAttribute("LocallyHidden",true)
     end
     continue
    end
    local camera=workspace.CurrentCamera
    if camera and (bike.PrimaryPart.Position-camera.CFrame.Position).Magnitude>230 then continue end
    if ui.Prediction and ui.Prediction.Active and bike:GetAttribute("OwnerUserId")==Players.LocalPlayer.UserId and bike~=ui.Prediction.Bike then continue end
    local owner=bike:GetAttribute("OwnerUserId");if type(owner)=="number" then riderBikes[owner]=bike end
    if not settings.Animations then continue end
    local record=bikes[bike]
    if not record then
     record={Bases={},Wheel=0,Crank=0,Yaw=nil,Steer=0}
     for _,motor in ipairs(bike:GetDescendants()) do if motor:IsA("Motor6D") then record.Bases[motor]=motor.C0 end end
     bikes[bike]=record
    end
    local distance=bike:GetAttribute("Distance") or 0
    local speed=bike:GetAttribute("RaceSpeed") or 0
    local target=distance/(bike:GetAttribute("WheelRadius") or 1.43)
    record.Wheel+=(target-record.Wheel)*math.min(1,dt*18)
    if speed==0 then record.Wheel=target end
    record.Crank=record.Wheel/2.2
    local _,yaw=bike.PrimaryPart.CFrame:ToEulerAnglesYXZ()
    local change=if record.Yaw then math.atan2(math.sin(yaw-record.Yaw),math.cos(yaw-record.Yaw))/math.max(dt,0.001) else 0
    record.Yaw=yaw;record.Steer+=(math.clamp(change*0.1,-0.18,0.18)-record.Steer)*math.min(1,dt*9)
    for motor,base in pairs(record.Bases) do
     if motor.Name=="SteeringMotor" then motor.C0=base*CFrame.Angles(0,record.Steer,0)
     elseif motor.Name=="CrankMotor" then motor.C0=base*CFrame.Angles(-record.Crank,0,0)
     elseif motor.Name=="FrameMotor" then motor.C0=base*CFrame.new(0,if bike:GetAttribute("Pedaling")==false and speed>0 then math.sin(os.clock()*28)*0.015 else 0,0)*CFrame.Angles(0,0,-record.Steer*0.4)
     elseif motor.Name=="FrontWheelMotor" or motor.Name=="RearWheelMotor" then motor.C0=base*CFrame.Angles(-record.Wheel,0,0) end
    end
    -- A small visual roll of the frame group, without moving authoritative root/path.
   end
  end
  for bike in pairs(bikes) do if not bike.Parent then bikes[bike]=nil end end
  for _,player in ipairs(Players:GetPlayers()) do
   local character=if player==Players.LocalPlayer and ui.Prediction and ui.Prediction.Active then ui.Prediction.Character else player.Character
   local bike=riderBikes[player.UserId]
   local training=(player:GetAttribute("SelectedTreadmill") or 0)>0
   local wanted=visible(character) and bike~=nil
   local current=poses[player]
   if current and (current.Character~=character or current.Record.Dirty or wanted and current.Bike~=bike) then Pose.destroy(current.Record);poses[player]=nil;current=nil end
   if current and not wanted then
    current.Exit=(current.Exit or 0)+dt;Pose.fade(current.Record,math.min(1,dt*18))
    if current.Exit>=0.2 then Pose.destroy(current.Record);poses[player]=nil;current=nil end
   end
   if wanted and character then
    if not current then local record=Pose.new(character,bike);if record then current={Record=record,Character=character,Bike=bike};poses[player]=current end end
    if current then
     current.Exit=nil
     local phase=if not settings.Animations or bike and bike:GetAttribute("Pedaling")==false then 0 elseif bike and bikes[bike] then bikes[bike].Crank else os.clock()*7
     Pose.update(current.Record,phase,bike~=nil or training,math.min(1,dt*12))
    end
   end
  end
  for player,pose in pairs(poses) do if player.Parent~=Players then Pose.destroy(pose.Record);poses[player]=nil end end
  if ui.Viewport and ui.Viewport.Frame.Parent and settings.Animations then
   local angle=os.clock()*0.22
   ui.Viewport.Camera.CFrame=CFrame.lookAt(Vector3.new(math.sin(angle)*(ui.Viewport.Distance or 10),(ui.Viewport.TargetY or 2)+3,math.cos(angle)*(ui.Viewport.Distance or 10)),Vector3.new(0,ui.Viewport.TargetY or 2,0))
  end
 end
 function api.refresh()
  -- Seated pose is mandatory even when decorative animations are disabled.
  -- One shared connection; idle when no avatars, bikes or garage are active.
 end
 local function updateConnection()
  local active=ui.Viewport~=nil or next(poses)~=nil
  for _,player in ipairs(Players:GetPlayers()) do if visible(player.Character) and (player:GetAttribute("Mounted")) then active=true;break end end
  local folder=workspace:FindFirstChild("ActiveRaceBikes")
  local camera=workspace.CurrentCamera
  if not active and folder and camera then
   for _,model in ipairs(folder:GetChildren()) do if model:IsA("Model") and model.PrimaryPart and (model.PrimaryPart.Position-camera.CFrame.Position).Magnitude<230 and (model:GetAttribute("RaceSpeed") or 0)>0 then active=true;break end end
  end
  if active and not connection then connection=RunService.PreSimulation:Connect(frame)
  elseif not active and connection then connection:Disconnect();connection=nil;restore() end
 end
 task.spawn(function() while ui.Gui.Parent do updateConnection();task.wait(0.2) end;if connection then connection:Disconnect() end;restore() end)
 return api
end
return Visuals
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
