      <Item class="ModuleScript" referent="182">
        <Properties>
          <string name="Name">AutoNavigation</string>
          <string name="Source"><![CDATA[--!strict
local N={}
function N.input(state:any,target:any):(any,number)
 local dx,dz=target.X-state.X,target.Z-state.Z
 local distance=math.sqrt(dx*dx+dz*dz)
 local desired=math.atan2(-dx,-dz)
 local error=math.atan2(math.sin(desired-state.Yaw),math.cos(desired-state.Yaw))
 -- At very tight angles reverse briefly instead of orbiting an unreachable waypoint.
 local reverse=math.abs(error)>2.1 and distance<7
 return {Throttle=if distance<.8 then 0 elseif reverse then -.35 else math.clamp(distance/10,.18,.65),Steer=math.clamp(-error*1.8,-1,1),Brake=distance<.8,JumpId=state.JumpId},distance
end
function N.path(state:any,target:any):{any}
 local path={}
 -- Fixed authored clear corridors on World 1; never a teleport. Collision sweeps remain active.
 if state.Z< -38 then table.insert(path,{X=state.X,Z=-31}) end
 if state.X< -30 and state.Z> -20 and state.Z<28 then table.insert(path,{X=-29,Z=state.Z}) end
 table.insert(path,{X=0,Z=if target.Z<0 then -28 else 32})
 if target.Z<0 then table.insert(path,{X=target.X,Z=-33}) end
 table.insert(path,target)
 return path
end
return table.freeze(N)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="183">
        <Properties>
          <string name="Name">AutoTraining</string>
          <string name="Source"><![CDATA[--!strict
local Catalog=require(script.Parent.Catalog)
local Rules=require(script.Parent.Rules)
local Access={}
function Access.allowed(profile:any,id:number,vipOnly:boolean,vip:boolean):boolean
 return profile~=nil and Rules.canUseTreadmill(id,profile.Energy,profile.Rebirths,profile.OwnedWorlds) and (not vipOnly or vip)
end
function Access.best(profile:any,available:{[number]:boolean},restricted:{[number]:boolean},vip:boolean):number
 local best=0;local power=0
 if not profile then return 0 end
 for id,definition in ipairs(Catalog.Treadmills) do
  if available[id] and Access.allowed(profile,id,restricted[id]==true or definition.VIPOnly==true,vip) and definition.TrainingMultiplier>power then
   best=id;power=definition.TrainingMultiplier
  end
 end
 return best
end
return table.freeze(Access)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="184">
        <Properties>
          <string name="Name">BikeMotion</string>
          <string name="Source"><![CDATA[--!strict
-- Pure manual-driving integrator. Clients never supply position, speed or elapsed time.
local Config=require(script.Parent.Config)
local Motion={}
function Motion.step(speed:number,yaw:number,throttle:number,steer:number,brake:boolean,dt:number,maxSpeed:number):any
 local cfg=Config.Bike
 dt=math.clamp(dt,0,.1)
 local target=if brake then 0 else throttle*maxSpeed*(if throttle<0 then .35 else 1)
 local rate=if brake or speed*target<0 then cfg.Braking elseif throttle==0 then cfg.Drag else cfg.Acceleration
 local change=math.clamp(target-speed,-rate*dt,rate*dt)
 speed+=change
 yaw=(yaw-steer*cfg.TurnRate*dt*math.clamp(math.abs(speed)/1.5,0,1)*(if speed<-.1 then -1 else 1))% (math.pi*2)
 return {Speed=speed,Yaw=yaw,DX=-math.sin(yaw)*speed*dt,DZ=-math.cos(yaw)*speed*dt}
end
function Motion.inGarage(x:number,y:number,z:number,cx:number,cy:number,cz:number,radius:number):boolean
 local dx,dz=x-cx,z-cz
 return dx>=0 and dx*dx+dz*dz<=radius*radius and math.abs(y-cy)<=8
end
return table.freeze(Motion)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="185">
        <Properties>
          <string name="Name">BikeRig</string>
          <string name="Source"><![CDATA[--!strict
-- Authored geometry -> one anchored root with motorized welded groups, no manual vehicle physics.
local Rig={}
function Rig.prepare(model: Model): any
 local root=model:FindFirstChild("Root") :: BasePart
 assert(root and root:IsA("BasePart"),"Mountainbike root missing")
 model.PrimaryPart=root
 local motors: {[string]: Motor6D}={}
 local function group(name:string,parent:BasePart)
  local container=model:FindFirstChild(name) :: Model
  local pivot=container:FindFirstChild("Pivot") :: BasePart?
  local base=pivot or root
  for _,part in ipairs(container:GetDescendants()) do
   if part:IsA("BasePart") then
    part.Anchored=false;part.Massless=true;part.CanCollide=false;part.CanTouch=false
    if part~=base then local weld=Instance.new("Weld");weld.Part0=base;weld.Part1=part;weld.C0=base.CFrame:ToObjectSpace(part.CFrame);weld.Parent=part end
   end
  end
  if pivot then
   local motor=Instance.new("Motor6D");motor.Name=name.."Motor";motor.Part0=parent;motor.Part1=pivot
   motor.C0=parent.CFrame:ToObjectSpace(pivot.CFrame);motor.Parent=parent;motors[name]=motor
  end
  return base
 end
 local frame=group("Frame",root)
 local steering=group("Steering",frame)
 group("FrontWheel",steering);group("RearWheel",frame);if model:FindFirstChild("Crank") then group("Crank",frame) end
 root.Anchored=true
 return {Root=root,Frame=frame,FrameFromRoot=root.CFrame:ToObjectSpace(frame.CFrame),Motors=motors}
end
return Rig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="186">
        <Properties>
          <string name="Name">BikeSurface</string>
          <string name="Source"><![CDATA[--!strict
local Config=require(script.Parent.Config)
local Surface={}
function Surface.new(world:Workspace,excluded:{Instance},height:number):any
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances=excluded;params.RespectCanCollide=true
 local api={}
 function api.floor(x:number,y:number,z:number):(number?,number?)
  local hit=world:Raycast(Vector3.new(x,y+Config.Bike.StepHeight+.4,z),Vector3.new(0,-Config.Bike.FloorProbe,0),params)
  if not hit then return nil,nil end
  return hit.Position.Y,if hit.Normal then hit.Normal.Y else 1
 end
 function api.clear(x:number,y:number,z:number,yaw:number):boolean
  local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude
  overlap.FilterDescendantsInstances=excluded;overlap.RespectCanCollide=true
  local hits=world:GetPartBoundsInBox(CFrame.new(x,y+height/2+.2,z)*CFrame.Angles(0,yaw,0),Vector3.new(2.8,height,6.4),overlap)
  for _,part in ipairs(hits) do if part.CanCollide then return false end end
  return true
 end
 function api.block(x:number,y:number,z:number,yaw:number,dx:number,dy:number,dz:number,ground:number?,grounded:boolean?):boolean
  local delta=Vector3.new(dx,dy,dz)
  if delta.Magnitude<1e-5 then return false end
  local cf=CFrame.new(x,y+height/2,z)*CFrame.Angles(0,yaw,0)
  if world:Blockcast(cf,Vector3.new(2.8,height,6.4),delta,params) then return true end
  if grounded and ground then
   local low=world:Blockcast(CFrame.new(x,ground+.5,z)*CFrame.Angles(0,yaw,0),Vector3.new(2.4,.7,6),delta,params)
   if low then
    if low.Normal and low.Normal.Y>=Config.Bike.MinGroundNormal then return false end
    local part=low.Instance
    if part and part:IsA("BasePart") then
     local name=part.Name
     local driveable=name=="AccessRamp" or name=="Deck" or name=="Belt" or name=="Platform" or name=="IslandSpawn" or string.find(name,"^Grass_") or string.find(name,"^Sand_") or name=="CoastGrass" or name=="CoastSand"
     if driveable and part.Position.Y+part.Size.Y/2<=ground+Config.Bike.StepHeight then return false end
    end
    return true
   end
  end
  return false
 end
 return api
end
return table.freeze(Surface)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="187">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--!strict
local Config = require(script.Parent.Config)
local Numbers = require(script.Parent.Numbers)
local Content = require(script.Parent.World1Content)
local Progression = require(script.Parent.Progression)
local Metadata = require(script.Parent.CatalogMetadata)
local Catalog: { Worlds: {any}, Vehicles: {any}, Treadmills: {any}, Eggs: {any}, Pets: {any} } = { Worlds = {}, Vehicles = {}, Treadmills = {}, Eggs = {}, Pets = {} }
local function vehicleClass(id: number): string
 if id <= 6 then return "Bicycle" end
 if id <= 15 then return "Moped" end
 if id <= 27 then return "Motorcycle" end
 if id <= 34 then return "Supersport" end
 return "RaceMachine"
end
for id = 1, Config.Rules.WorldCount do
 Catalog.Worlds[id] = table.freeze({ Id = id, CashCost = if id == 1 then 0 else Config.Economy.WorldBaseCash * (id - 1), Currency = "Cash" })
end
for id = 1, Config.Rules.VehicleCount do
 Catalog.Vehicles[id] = table.freeze({ Id = id, Class = vehicleClass(id), CashCost = if id == 1 then 0 else Config.Economy.VehicleBaseCash * (id - 1) })
end
for id = 1, Config.Rules.TreadmillCount do
 Catalog.Treadmills[id] = table.freeze({ Id = id, WorldId = math.ceil(id / 5), TrainingMultiplier = Numbers.power(2, id - 1), CashCost = 0,
  EnergyRequirement = Progression.energy(id),
  RebirthRequirement = if id == 1 then 0 else Numbers.multiply(Config.Treadmills.RebirthBase, Numbers.power(Config.Treadmills.RebirthFactor, id - 2)) })
end
for id = 1, Config.Rules.EggCount do
 local species = {}
 for offset = 1, 4 do species[offset] = (id - 1) * 4 + offset end
 Catalog.Eggs[id] = table.freeze({ Id = id, WorldId = math.ceil(id / 3), Species = table.freeze(species) })
end
for id = 1, Config.Rules.PetSpeciesCount do
 Catalog.Pets[id] = table.freeze({ Id = id, EggId = math.ceil(id / 4) })
end
-- Explicit pending fields can be replaced per stable ID without inventing content.
for _, group in ipairs({ {Items=Catalog.Vehicles,Metadata=Metadata.Vehicles}, {Items=Catalog.Eggs,Metadata=Metadata.Eggs}, {Items=Catalog.Pets,Metadata=Metadata.Pets} }) do
 for id, entry in ipairs(group.Items) do
  local enriched = table.clone(entry)
  for key, value in pairs(Metadata.resolve(group.Metadata[id])) do enriched[key] = value end
  group.Items[id] = table.freeze(enriched)
 end
end
for id, content in ipairs(Content.Vehicles) do
 local v=table.clone(Catalog.Vehicles[id]);v.Name=content.Name;v.CashCost=content.Price;v.SpeedMultiplier=content.Speed;v.Model=content.Model;v.Playable=true;v.ContentStatus="Configured";v.Design=table.freeze({ModelPath="ReplicatedStorage/Vehicles/"..content.Model})
 Catalog.Vehicles[id]=table.freeze(v)
end
for id,content in ipairs(Content.Eggs) do
 local e=table.clone(Catalog.Eggs[id]);e.Name=content.Name;e.CashCost=content.Price;e.Weights=Content.Weights;e.Playable=true;e.ContentStatus="Configured";Catalog.Eggs[id]=table.freeze(e)
end
for id,content in ipairs(Content.Pets) do
 local p=table.clone(Catalog.Pets[id]);p.Name=content.Name;p.Rarity=Content.Rarities[(id-1)%4+1];p.EnergyMultiplier=content.Energy;p.CashMultiplier=content.Cash;p.Playable=true;p.ContentStatus="Configured";p.Model="Pet"..id;p.HatchWeight=Content.Weights[(id-1)%4+1];p.HatchChance=p.HatchWeight/10000;p.Design=table.freeze({ModelPath="ReplicatedStorage/PetModels/Pet"..id});Catalog.Pets[id]=table.freeze(p)
end
for _, category in ipairs({Catalog.Worlds,Catalog.Vehicles,Catalog.Treadmills,Catalog.Eggs,Catalog.Pets}) do table.freeze(category) end
return table.freeze(Catalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="188">
        <Properties>
          <string name="Name">CatalogMetadata</string>
          <string name="Source"><![CDATA[--!strict
-- Author entries by stable ID here once design decisions exist. false means unresolved.
local Metadata = {}
export type Entry = { Name: string?, Rarity: string?, Multiplier: number?,
 Design: { AssetId: string?, IconId: string?, Description: string? }? }
Metadata.Vehicles = {[1]={Name="Mountainbike"}} :: {[number]: Entry}
Metadata.Eggs = {} :: {[number]: Entry}
Metadata.Pets = {} :: {[number]: Entry}
function Metadata.resolve(entry: Entry?): any
 local source: Entry = entry or {}
 assert(source.Multiplier == nil or (source.Multiplier == source.Multiplier and source.Multiplier >= 0 and source.Multiplier <= 1e300), "Invalid content multiplier")
 local design: { AssetId: string?, IconId: string?, Description: string? } = source.Design or {}
 return {
  Name = source.Name or false, Rarity = source.Rarity or false, Multiplier = source.Multiplier or false,
  Design = table.freeze({ AssetId = design.AssetId or false, IconId = design.IconId or false, Description = design.Description or false }),
  ContentStatus = if source.Name and source.Rarity and source.Multiplier and design.AssetId and design.IconId and design.Description then "Configured" else "Pending",
 }
end
for _, entries in ipairs({ Metadata.Vehicles, Metadata.Eggs, Metadata.Pets }) do table.freeze(entries) end
return table.freeze(Metadata)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="189">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--!strict
local State={}
local Numbers=require(script.Parent.Numbers)
function State.new(phone: boolean): any
 return {Collapsed=phone,Animations=true,Popups=true,Sound=true,Volume=0.35,LastEvent=0,Active="Garage"}
end
function State.setting(state: any, name: string, value: any): boolean
 if name=="Volume" then
  if type(value)~="number" or value~=value or math.abs(value)==math.huge then return false end
  state.Volume=math.clamp(value,0,1);return true
 end
 if name~="Collapsed" and name~="Animations" and name~="Popups" and name~="Sound" then return false end
 if type(value)~="boolean" then return false end
 state[name]=value;return true
end
function State.event(state: any, id: number): boolean
 if type(id)~="number" or not Numbers.validRebirth(id) or id<=state.LastEvent then return false end
 state.LastEvent=id;return true
end
-- RemoteFunction responses can arrive after newer SnapshotChanged events.
-- Never roll back a revision, and never attach older inventory to a newer revision.
function State.snapshot(previous:any,incoming:any):any
 if type(incoming)~="table" or type(incoming.Revision)~="number" or not Numbers.validRebirth(incoming.Revision) then return nil end
 if previous and incoming.Revision<previous.Revision then return nil end
 if incoming.SnapshotId~=nil then
  if type(incoming.SnapshotId)~="number" or not Numbers.validRebirth(incoming.SnapshotId) then return nil end
  if previous and previous.SnapshotId and incoming.SnapshotId<=previous.SnapshotId then return nil end
 end
 local merged=table.clone(incoming)
 for _,key in ipairs({"Pets","EquippedPets","DiscoveredPets","OwnedVehicles"}) do
  if merged[key]==nil then
   if not previous or previous.InventoryRevision~=incoming.InventoryRevision then return nil end
   merged[key]=previous[key]
   if merged[key]==nil then return nil end
  end
 end
 return merged
end
return table.freeze(State)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="190">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
local Numbers = require(script.Parent.Numbers)
local Config = {
 Data = { Store = "BikeEvolution_Player_v1", SchemaVersion = 3, AutosaveSeconds = 60,
  LeaseSeconds = 180, Attempts = 3, MaxPets = 500 },
 Rules = { WorldCount = 8, VehicleCount = 40, TreadmillCount = 40, TreadmillsPerWorld = 5,
  EggCount = 24, PetSpeciesCount = 96, EquipSlots = 3, BaseTraining = 1,
  RebirthBonus = 0.5, GoldenIngredients = 5, RainbowIngredients = 3 },
 Numbers = { MaxBalance = Numbers.Max, MaxRebirths = Numbers.MaxRebirths },
 Treadmills = { EnergyBase = 21, Difficulty = 4, RebirthBase = 1, RebirthFactor = 3 },
 Training = { AutoTeleportCooldown = .4, AutoSeconds = 1, ClickCooldown = 0.2, SelectCooldown = 0.4, RebirthCooldown = 1,
  RemoteCapacity = 12, RemoteRefillPerSecond = 8, MaxDistance = 10, MaxVerticalDistance = 6 },
 Bike = { Tick = 1/60, CommandSteps = 2, InputInterval = 1/30, InputTimeout = .45, BaseSpeed = 18, MaxSpeed = 46,
  Acceleration = 40, Braking = 90, Drag = 35, TurnRate = 2.8, StepHeight = 1.6,
  Gravity = 80, JumpVelocity = 28, JumpCooldown = .65, GroundTolerance = .22, MinGroundNormal = .7,
  FloorProbe = 18, QueueLimit = 8, AckInterval = .1, PendingLimit = 90 },
 Network = { Folder = "BikeRemotes", ProtocolVersion = 1, SnapshotCooldown = 1 },
 -- Economy values are provisional configuration, not implemented purchase systems.
 Economy = { RebirthBaseEnergy = 1000, RebirthHardFrom = 2, RebirthHardFactor = 4, WorldBaseCash = 1000, VehicleBaseCash = 100 },
 Race = { Automatic = true, OpponentType = "Bot", EnergyCost = 0,
  Test = { BaseSpeed = 24, EnergyFactor = 4, SpeedBonusCap = 28, Countdown = 3, Timeout = 150 } },
 RaceDifficulties = { "Easy", "Medium", "Hard" },
}
local function freezeDeep(value)
 for _, child in pairs(value) do
  if type(child) == "table" then freezeDeep(child) end
 end
 return table.freeze(value)
end
return freezeDeep(Config)
]]></string>
