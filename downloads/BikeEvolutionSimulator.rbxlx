  <Item class="ServerScriptService" referent="962">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="963">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Publish diagnostics before any dependency is required. A failed stage is visible to clients.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local status=Instance.new("Folder");status.Name="BikeRuntime";status.Parent=ReplicatedStorage
status:SetAttribute("State","Starting")
local studio=RunService:IsStudio()
local preview=studio and workspace:GetAttribute("StudioPreviewData")~=false
local diagnostic=studio or (game.PrivateServerId~="" and game.PrivateServerOwnerId~=0 and script:GetAttribute("DiagnosticsEnabled")==true)
status:SetAttribute("Diagnostics",diagnostic)
status:SetAttribute("DataMode",if preview then "STUDIO PREVIEW • NICHT DAUERHAFT" elseif studio then "ISOLIERTER STUDIO-TESTSTORE" else "PERSISTENT")
local function stage(name:string,callback:()->())
 status:SetAttribute("Stage",name)
 local ok,err=pcall(function():any callback();return true end)
 if not ok then
  warn("[BikeBootstrap] "..name..": "..tostring(err))
  status:SetAttribute("State","Failed")
  status:SetAttribute("Error",if diagnostic then string.sub(tostring(err),1,1200) else "Initialisierung fehlgeschlagen: "..name)
  error("Bike bootstrap failed at "..name,0)
 end
 status:SetAttribute(name,"OK")
end
stage("WorldContract",function()
 local contract=require(ReplicatedStorage.Shared.RuntimeContract)
 local missing=contract.inspect(game)
 assert(#missing==0,"Missing world components: "..table.concat(missing,", "))
end)
local data:any;local gameplay:any
stage("Dependencies",function()
 data=require(script.PlayerDataService)
 local Gameplay=require(script.GameplayService)
 data.configure({Preview=preview,StoreName=if studio and not preview then "BikeEvolution_StudioTest_v2" else nil})
 gameplay=Gameplay.new(data)
end)
stage("Remotes",function() require(script.RemoteService).start(gameplay) end)
stage("Interactions",function() gameplay.start() end)
stage("Profiles",function() data.start() end)
status:SetAttribute("State","Ready")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="964">
        <Properties>
          <string name="Name">AutomationService</string>
          <string name="Source"><![CDATA[--!strict
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Catalog=require(Shared:WaitForChild("Catalog"))
local Access=require(Shared:WaitForChild("AutoTraining"))
local Nav=require(Shared:WaitForChild("AutoNavigation"))
local Service={}
function Service.new(data:any,mounts:any,race:any,training:any,zones:any,emit:any,hasVIP:((Player)->boolean)?):any
 local states:{[Player]:any}={};local api:any={}
 function api.state(player:Player):any
  if not states[player] then states[player]={AutoTrain=false,AutoRace=false,SlowMode=false,Difficulty="Easy",Phase="Manual",PauseUntil=0,NextTeleportAt=0} end
  return states[player]
 end
 local function fail(player:Player,s:any,reason:string)
  s.AutoTrain=false;s.PendingTraining=nil;s.Phase="Blocked";mounts.auto(player,nil)
  training:stop(player);emit(player,{Kind="InteractionError",Error=reason})
 end
 local function train(player:Player,s:any,profile:any,record:any)
  local available:{[number]:boolean}={};local restricted:{[number]:boolean}={}
  for id,zone in pairs(zones) do
   available[id]=zone:IsDescendantOf(workspace)
   restricted[id]=zone:GetAttribute("VIPOnly")==true or Catalog.Treadmills[id].VIPOnly==true
  end
  local best=Access.best(profile,available,restricted,if hasVIP then hasVIP(player) else false)
  if best==0 then
   if s.Phase~="TrainingUnavailable" then emit(player,{Kind="InteractionError",Error="NoAvailableTreadmill"}) end
   s.Phase="TrainingUnavailable";s.PendingTraining=nil;training:stop(player);mounts.auto(player,nil);return
  end
  local placed=s.TrainTarget==best and s.TrainCharacter==record.Character and mounts.onBelt(player,zones[best])
  mounts.auto(player,{Throttle=0,Steer=0,Brake=true,JumpId=record.State.JumpId})
  if not placed then
   if os.clock()<s.NextTeleportAt then s.Phase="TrainingPending";return end
   s.NextTeleportAt=os.clock()+Config.Training.AutoTeleportCooldown
   local ok,reason=mounts.trainTeleport(player,best)
   if not ok then fail(player,s,reason or "TrainingPositionBlocked");return end
   s.TrainTarget=best;s.TrainCharacter=record.Character;s.Path=nil
  end
  s.PendingTraining=nil
  if training:selection(player)~=best then
   local ok,reason=training:select(player,best)
   if not ok then
    if reason=="Cooldown" or reason=="Saving" then s.Phase="TrainingPending";return end
    fail(player,s,reason or "Locked");return
   end
  end
  s.Phase="Training"
 end
 local function raceNavigate(player:Player,s:any,record:any)
  s.Phase="NavigatingRace"
  if not s.Path or s.RouteCharacter~=record.Character then
   s.Path=Nav.path(record.State,{X=0,Z=63});s.RouteCharacter=record.Character;s.Index=1;s.Stuck=0;s.Last=nil
  end
  if math.abs(record.State.X)<5 and math.abs(record.State.Z-63)<6 then
   mounts.auto(player,{Throttle=0,Steer=0,Brake=true,JumpId=record.State.JumpId})
   local ok,err=race.start(player,s.Difficulty)
   if not ok and err~="Cooldown" then s.AutoRace=false;s.Phase="Blocked";mounts.auto(player,nil);emit(player,{Kind="InteractionError",Error=err}) end
   return
  end
  local input,distance=Nav.input(record.State,s.Path[s.Index])
  if distance<2 and s.Index<#s.Path then s.Index+=1;local nextInput=Nav.input(record.State,s.Path[s.Index]);input=nextInput end
  mounts.auto(player,input)
  if s.Last and math.abs(record.State.X-s.Last.X)+math.abs(record.State.Z-s.Last.Z)<.015 then s.Stuck=(s.Stuck or 0)+.2 else s.Stuck=0 end
  s.Last={X=record.State.X,Z=record.State.Z}
  if s.Stuck>12 then s.AutoRace=false;s.Phase="Blocked";mounts.auto(player,nil);emit(player,{Kind="InteractionError",Error="NavigationBlocked"}) end
 end
 function api.tick(player:Player)
  local s=api.state(player)
  local profile=data.context(player);local record=mounts.ensure(player)
  if not record or not profile or record.Humanoid.Health<=0 then mounts.auto(player,nil);return end
  -- Absolute race exclusion: no training teleports, even on unlock/reset/enable/respawn requests.
  if race.active(player) or record.Mode~="Manual" then s.Phase="Racing";s.WasRace=true;mounts.auto(player,nil);return end
  if s.WasRace then
   s.WasRace=nil;s.PauseUntil=os.clock()+3;s.Path=nil;s.TrainTarget=nil;s.PendingTraining=s.AutoTrain
  end
  -- Resume training once immediately after a race, then retain the normal three-second restart pause.
  if s.AutoTrain and (s.PendingTraining or not s.AutoRace or os.clock()<s.PauseUntil) then train(player,s,profile,record);return end
  if os.clock()<s.PauseUntil then s.Phase="Pause";mounts.auto(player,nil);return end
  if s.AutoRace then raceNavigate(player,s,record);return end
  s.Phase="Manual";s.Path=nil;mounts.auto(player,nil)
 end
 function api.toggle(player:Player,key:string,value:boolean,difficulty:string?):boolean
  local s=api.state(player);local previous=s[key];s[key]=value
  if difficulty then s.Difficulty=difficulty end
  if key=="AutoRace" and previous~=value then s.Path=nil;s.Stuck=0;s.Last=nil end
  if key=="AutoTrain" then
   if value and not previous then s.PendingTraining=true end
   if not value then s.PendingTraining=nil end
  end
  player:SetAttribute("SlowMode",s.SlowMode)
  api.tick(player) -- Activation does not wait for a route or the next input packet.
  return true
 end
 function api.remove(player:Player) states[player]=nil end
 return api
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="965">
        <Properties>
          <string name="Name">GameplayService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Controller = require(Shared:WaitForChild("TrainingController"))
local Limiter = require(Shared:WaitForChild("RateLimiter"))
local Protocol = require(Shared:WaitForChild("Protocol"))
local Economy=require(Shared:WaitForChild("EconomyController"))
local PetRules=require(Shared:WaitForChild("PetRules"))
local Numbers=require(Shared:WaitForChild("Numbers"))
local Http=game:GetService("HttpService")
local RaceService=require(script.Parent.RaceService)
local MountedBikes=require(script.Parent.MountedBikeService)
local BikeMotion=require(Shared:WaitForChild("BikeMotion"))
local PremiumService=require(script.Parent.PremiumService)
local AutomationService=require(script.Parent.AutomationService)
local Service = {}
function Service.new(dataService: any): any
 local training = workspace:WaitForChild("World1"):WaitForChild("Training")
 local zones: {[number]: BasePart} = {}
 for id=1,5 do zones[id] = training:WaitForChild("Treadmill_"..id):WaitForChild("Zone") :: BasePart end
 local function alive(player: Player): boolean
  local character = player.Character
  local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
  return humanoid ~= nil and humanoid.Health > 0 and character ~= nil and character:IsDescendantOf(workspace)
 end
 local mounts:any=nil
 local premium:any=nil
 local function near(player: Player, id: number): boolean
  if not alive(player) or player:GetAttribute("Racing")==true or not zones[id] then return false end
  if (zones[id]:GetAttribute("VIPOnly")==true or Catalog.Treadmills[id].VIPOnly==true) and (not premium or not premium.entitled(player,"VIP")) then return false end
  return mounts~=nil and mounts.onBelt(player,zones[id])
 end
 local sink: any=function() end
 local sequence: {[Player]:number}={}
 local function emit(player:Player,event:any)
  sequence[player]=(sequence[player] or 0)+1;event.Id=sequence[player]
  local ok,err=pcall(sink,player,event);if not ok then warn("[Feedback]",player.UserId,tostring(err)) end
 end
 premium=PremiumService.new(dataService)
 local controller = Controller.new(dataService, os.clock, near,emit)
 controller.Premium=premium.bonus
 mounts=MountedBikes.new(dataService)
 mounts.setTrainingZones(zones,function(player:Player) return premium.entitled(player,"VIP") end)
 mounts.cashPass=function(player:Player) return premium.bonus(player,{Boosts={}},"Cash")>1 end
 local race=RaceService.new(dataService,function(player) controller:stop(player) end,emit,mounts)
 local automation=AutomationService.new(dataService,mounts,race,controller,zones,emit,function(player:Player) return premium.entitled(player,"VIP") end)
 local rng=Random.new()
 local economy=Economy.new(dataService,os.clock,function() return rng:NextInteger(1,10000) end,function() return Http:GenerateGUID(false) end,emit,function(player,event,reason) warn("[Economy]",event,player.UserId,reason) end)
 local limiter = Limiter.new(Config.Training.RemoteCapacity, Config.Training.RemoteRefillPerSecond, os.clock)
 local inventorySent: {[Player]:number}={}
 local inventoryCache: {[Player]:any}={}
 local snapshotSequence: {[Player]:number}={}
 local autoBlocked: {[Player]:boolean}={}
 local result: any = {}
 function result.setDriveState(callback:any) mounts.setStateSink(callback) end
 function result.drive(player:Player,payload:any):boolean return mounts.input(player,payload) end
 function result.setFeedback(callback:any) sink=callback end
 function result.status(player:Player):string return dataService.status(player) end
 function result.handle(player: Player, payload: any): (boolean, string?)
  if player.Parent~=Players then return false,"NotReady" end
  -- Shared gate for UI remotes AND proximity prompts, before inspecting untrusted payloads.
  if not limiter:allow(player) then return false, "RateLimited" end
  if not Protocol.validAction(payload) then return false, "BadRequest" end
  if not alive(player) then controller:stop(player); return false, "NotAlive" end
  if payload.Action=="Automation" then
   if not dataService.snapshot(player) then return false,"NotReady" end
   if payload.Setting=="AutoTrain" and payload.Enabled then autoBlocked[player]=nil end
   return automation.toggle(player,payload.Setting,payload.Enabled,payload.Difficulty),nil
  end
  if payload.Action=="Premium" then return premium.prompt(player,payload.Offer) end
  if payload.Action=="AbortRace" then race.abort(player);return true,nil end
  if race.active(player) then return false,"AlreadyRacing" end
  if payload.Action=="StartRace" then return race.start(player,payload.Difficulty or "Easy") end
  if payload.RequestId then return economy:handle(player,payload) end
  if payload.Action == "Select" then autoBlocked[player]=nil;return controller:select(player, payload.TreadmillId) end
  if payload.Action == "Click" then return controller:impulse(player, true) end
  if payload.Action == "Stop" then autoBlocked[player]=true;controller:stop(player); return true, nil end
  return controller:rebirth(player)
 end
 function result.interact(player:Player,payload:any)
  local ok,reason=result.handle(player,payload)
  if not ok and reason~="RateLimited" and reason~="Cooldown" then emit(player,{Kind="InteractionError",Error=reason}) end
 end
 function result.snapshot(player: Player, forceInventory: boolean?): any
  local snapshot = dataService.snapshot(player)
  if not snapshot then return nil end
  local selected = controller:selection(player)
  snapshot.SelectedTreadmill = selected
  player:SetAttribute("SelectedTreadmill",selected)
  snapshot.Race=race.snapshot(player)
  local mode=automation.state(player)
  snapshot.Automation={AutoTrain=mode.AutoTrain,AutoRace=mode.AutoRace,SlowMode=mode.SlowMode,Phase=mode.Phase}
  local inventoryRevision=dataService.inventoryRevision(player)
  local cached=inventoryCache[player]
  if not cached or cached.Revision~=inventoryRevision then
   local profile=dataService.read(player)
   if not profile then return nil end
   cached={Revision=inventoryRevision,Profile=profile};inventoryCache[player]=cached
  end
  -- Only the counters above change while training. Avoid cloning up to 500 pets at 4 Hz.
  local profile=cached.Profile
  snapshot.ActiveVehicle=profile.ActiveVehicle
  snapshot.OwnedWorlds=profile.OwnedWorlds
  snapshotSequence[player]=(snapshotSequence[player] or 0)+1
  snapshot.SnapshotId=snapshotSequence[player]
  snapshot.InventoryRevision=inventoryRevision
  snapshot.LastRequestId=economy.Requests[player] or 0
  if forceInventory or inventorySent[player]~=inventoryRevision then
   snapshot.OwnedVehicles=profile.OwnedVehicles;snapshot.Pets=profile.Pets
   snapshot.EquippedPets=profile.EquippedPets;snapshot.DiscoveredPets=profile.DiscoveredPets
   inventorySent[player]=inventoryRevision
   local followers={}
   for _,id in ipairs(profile.EquippedPets) do table.insert(followers,profile.Pets[id]) end
   player:SetAttribute("PetFollowers",Http:JSONEncode(followers))
  end
  snapshot.PetEnergyBonus=PetRules.bonus(profile,"Energy");snapshot.PetCashBonus=PetRules.bonus(profile,"Cash")
  local live=dataService.context(player)
  snapshot.Boosts=if live then live.Boosts else {Energy=0,Cash=0}
  snapshot.PremiumAvailable=dataService.status(player)=="Ready"
  snapshot.PremiumEnergy=if live then premium.bonus(player,live,"Energy") else 1
  snapshot.PremiumCash=if live then premium.bonus(player,live,"Cash") else 1
  snapshot.Revision=dataService.revision(player)
  snapshot.TrainingMultiplier = Numbers.multiply(Rules.trainingGain(snapshot.Rebirths),Numbers.multiply(snapshot.PetEnergyBonus,snapshot.PremiumEnergy))
  local impulse = if selected == 0 then 0 else Numbers.multiply(Rules.trainingGain(snapshot.Rebirths, Catalog.Treadmills[selected].TrainingMultiplier),Numbers.multiply(snapshot.PetEnergyBonus,snapshot.PremiumEnergy))
  snapshot.ImpulseGain=Numbers.add(snapshot.Energy,impulse)-snapshot.Energy
  snapshot.RebirthRequirement = Rules.rebirthRequirement(snapshot.Rebirths)
  return snapshot
 end
 function result.start()
  premium.start()
  local island=workspace:WaitForChild("World1")
  local function menuPrompt(part:BasePart,title:string,event:any)
   local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Öffnen";prompt.ObjectText=title;prompt.MaxActivationDistance=12;prompt.Parent=part
   prompt.Triggered:Connect(function(player)
    local root=if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
    if limiter:allow(player) and alive(player) and root and root:IsA("BasePart") and (root.Position-part.Position).Magnitude<=14 then emit(player,table.clone(event)) end
   end)
  end
  for id=1,3 do menuPrompt(island:WaitForChild("EggStation_"..id):WaitForChild("Egg") :: BasePart,Catalog.Eggs[id].Name,{Kind="OpenEgg",EggId=id}) end
  mounts.start()
  menuPrompt(island:WaitForChild("ShopArea"):WaitForChild("Platform") :: BasePart,"Shop",{Kind="OpenMenu",Menu="Shop"})
  menuPrompt(island:WaitForChild("WorldPreview"):WaitForChild("Platform") :: BasePart,"Worlds",{Kind="OpenMenu",Menu="Worlds"})
  race.request=function(player) result.interact(player,{Version=1,Action="StartRace"}) end
  race.run()
  local function added(player: Player)
   player.CharacterRemoving:Connect(function() controller:stop(player) end)
  end
  Players.PlayerAdded:Connect(added)
  for _, player in ipairs(Players:GetPlayers()) do added(player) end
  Players.PlayerRemoving:Connect(function(player) controller:remove(player); limiter:remove(player);sequence[player]=nil;inventorySent[player]=nil;inventoryCache[player]=nil;snapshotSequence[player]=nil;autoBlocked[player]=nil;economy:remove(player);automation.remove(player) end)
  task.spawn(function()
   local entered:{[Player]:number}={}
   local garageEntered:{[Player]:boolean}={}
   local garage=island:WaitForChild("GaragePreview"):WaitForChild("EntryZone") :: BasePart
   local retry:{[Player]:number}={}
   Players.PlayerRemoving:Connect(function(player) entered[player]=nil;retry[player]=nil;garageEntered[player]=nil end)
   while true do
    task.wait(0.2)
    for _,player in ipairs(Players:GetPlayers()) do
     automation.tick(player)
     local root=if player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
     local inside=root and root:IsA("BasePart") and alive(player) and player:GetAttribute("Racing")~=true and BikeMotion.inGarage(root.Position.X,root.Position.Y,root.Position.Z,garage.Position.X,garage.Position.Y,garage.Position.Z,garage.Size.Z/2)
     if not inside then garageEntered[player]=nil
     elseif not garageEntered[player] and dataService.snapshot(player) and limiter:allow(player) then
      garageEntered[player]=true;emit(player,{Kind="OpenMenu",Menu="Garage"})
     end
     local onBelt=0
     for id=1,5 do if near(player,id) then onBelt=id;break end end
     if onBelt==0 then entered[player]=nil;retry[player]=nil;autoBlocked[player]=nil
     elseif not autoBlocked[player] and controller:selection(player)~=onBelt and (entered[player]~=onBelt or os.clock()>=(retry[player] or 0)) then
      entered[player]=onBelt;retry[player]=os.clock()+1
      -- Stepping onto the belt uses the same authority/limiter as a prompt, never client touch events.
      result.handle(player,{Version=1,Action="Select",TreadmillId=onBelt})
     end
    end
    controller:tick()
   end
  end)
 end
 return result
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="966">
        <Properties>
          <string name="Name">MountedBikeService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Rep=game:GetService("ReplicatedStorage")
local Shared=Rep:WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Content=require(Shared:WaitForChild("World1Content"))
local Sim=require(Shared:WaitForChild("RideSimulation"))
local Surface=require(Shared:WaitForChild("BikeSurface"))
local Geometry=require(Shared:WaitForChild("RiderMount"))
local Rig=require(Shared:WaitForChild("BikeRig"))
local Protocol=require(Shared:WaitForChild("Protocol"))
local Limiter=require(Shared:WaitForChild("RateLimiter"))
local Progression=require(Shared:WaitForChild("Progression"))
local Access=require(Shared:WaitForChild("AutoTraining"))
local Catalog=require(Shared:WaitForChild("Catalog"))
local Service={}
function Service.new(data:any):any
 local folder=Instance.new("Folder");folder.Name="PlayerBikes";folder.Parent=workspace
 local records:{[Player]:any}={}
 local sequence:{[Player]:number}={}
 local gate=Limiter.new(16,40,os.clock)
 local epoch:{[Player]:number}={}
 local stateSink:any=function() end
 local api:any={}
 local trainingZones:{[number]:BasePart}={}
 local hasVIP:(Player)->boolean=function() return false end
 function api.setTrainingZones(zones:any,entitlement:(Player)->boolean) trainingZones=table.clone(zones);hasVIP=entitlement end
 local function poseNode(node:Instance)
  if node:IsA("BasePart") then node.CanCollide=false
  elseif node:IsA("LocalScript") and node.Name=="Animate" then node.Disabled=true
  elseif node:IsA("Motor6D") and node:GetAttribute("RiderBaseC0")==nil then
   local base=node.C0;node:SetAttribute("RiderBaseC0",base)
   local angle=if string.find(node.Name,"Hip") then -1.15 elseif string.find(node.Name,"Knee") then 1.3 elseif string.find(node.Name,"Shoulder") then -1.1 elseif string.find(node.Name,"Elbow") then -.55 elseif node.Name=="Waist" then -.25 else 0
   node.C0=base*CFrame.Angles(angle,0,0)
  end
 end
 local function seated(record:any)
  local hum=record.Humanoid
  hum.WalkSpeed=0;hum.AutoRotate=false;hum.PlatformStand=true;hum.Sit=true;hum.Jump=false
  local animator=hum:FindFirstChildOfClass("Animator")
  if animator then
   for _,track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
  end
  record.Root.Anchored=false;record.Rig.Root.Anchored=true
  hum:Move(Vector3.zero,false);hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
  -- Replicated fallback pose also works before client IK loads and with effects disabled.
  for _,node in ipairs(record.Character:GetDescendants()) do poseNode(node) end
 end
 local function drop(player:Player)
  local r=records[player];if r then for _,c in ipairs(r.Connections) do c:Disconnect() end;r.Bike:Destroy();records[player]=nil end
  player:SetAttribute("Mounted",false)
 end
 function api.ensure(player:Player):any
  local char=player.Character
  local root=if char then char:FindFirstChild("HumanoidRootPart") else nil
  local hum=if char then char:FindFirstChildOfClass("Humanoid") else nil
  if not char or not root or not root:IsA("BasePart") or not hum or hum.Health<=0 or not char:IsDescendantOf(workspace) then return nil end
  local old=records[player]
  if old and old.Character~=char then drop(player);old=nil end
  local ready=data.snapshot(player)~=nil
  local revision=if ready then data.inventoryRevision(player) else -1
  local profile=if ready and (not old or old.InventoryRevision~=revision) then data.read(player) else nil
  local id=if profile then profile.ActiveVehicle or 1 elseif old then old.VehicleId else 1
  if not Content.Vehicles[id] then id=1 end
  if old and old.Bike.Parent and old.Rig.Root.Parent and old.Weld.Parent and (old.VehicleId==id or player:GetAttribute("Racing")==true) then
   old.InventoryRevision=revision
   if old.SizingDirty then
    old.Offset=Geometry.offset(old.Bike,char);old.Weld.C0=old.Rig.FrameFromRoot:Inverse()*old.Offset;old.SizingDirty=false
   end
   return old
  end
  -- Construct the replacement before removing the old model: never unmount the rider.
  local definition=Content.Vehicles[id]
  local asset=Rep:WaitForChild("Vehicles"):FindFirstChild(definition.Model)
  assert(asset and asset:IsA("Model"),"Mounted vehicle missing: "..definition.Model)
  local bike=asset:Clone();bike.Name="Rider_"..player.UserId;bike.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
  local rig=Rig.prepare(bike)
  local record:any={Character=char,Root=root,Humanoid=hum,Bike=bike,Rig=rig,VehicleId=id,InventoryRevision=revision,Mode="Manual",Connections={},Speed=0,Yaw=if old then old.Yaw else 0,Distance=if old then old.Distance else 0,Input={Throttle=0,Steer=0,Brake=true,At=0}}
  record.Offset=Geometry.offset(bike,char)
  local initial=if old then old.Frame else CFrame.new(root.Position.X,root.Position.Y-record.Offset.Position.Y,root.Position.Z-record.Offset.Position.Z)
  if not old then
   local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={char,folder};params.RespectCanCollide=true
   local floor=workspace:Raycast(root.Position+Vector3.new(0,6,0),Vector3.new(0,-24,0),params)
   if floor then initial=CFrame.new(initial.Position.X,floor.Position.Y+.05,initial.Position.Z) end
  end
  Geometry.place(rig,initial);record.Frame=initial
  epoch[player]=(epoch[player] or 0)+1;record.Epoch=epoch[player];record.Queue={};record.Processed=sequence[player] or 0;record.AckAt=0
  record.State=if old and old.State then table.clone(old.State) else Sim.new(initial.Position.X,initial.Position.Y,initial.Position.Z,record.Yaw)
  record.State.JumpId=player:GetAttribute("DriveJumpId") or 0
  player:SetAttribute("DriveEpoch",record.Epoch)
  -- Only the vehicle root is anchored and positioned. The avatar is a passenger joint.
  local weld=Instance.new("Weld");weld.Name="PermanentRiderMount"
  weld.Part0=rig.Frame;weld.Part1=root;weld.C0=rig.FrameFromRoot:Inverse()*record.Offset
  record.Weld=weld;seated(record)
  weld.Parent=rig.Frame
  bike:SetAttribute("VehicleId",id);bike:SetAttribute("OwnerUserId",player.UserId);bike:SetAttribute("Pedaling",id<=6)
  bike:SetAttribute("WheelRadius",if id==3 or id==8 then 1.15 else 1.43)
  bike:SetAttribute("RaceSpeed",0);bike:SetAttribute("Distance",record.Distance);bike.Parent=folder
  records[player]=record;player:SetAttribute("Mounted",true)
  local watched:{[Instance]:boolean}={}
  local function watchSize(part:Instance)
   if part:IsA("BasePart") and not watched[part] and (part.Name=="HumanoidRootPart" or part.Name=="LowerTorso" or part.Name=="Torso") then
    watched[part]=true
    table.insert(record.Connections,part:GetPropertyChangedSignal("Size"):Connect(function() record.SizingDirty=true end))
   end
   if part:IsA("Animator") then
    table.insert(record.Connections,part.AnimationPlayed:Connect(function(track) track:Stop(0) end))
   end
  end
  for _,part in ipairs(char:GetDescendants()) do watchSize(part) end
  table.insert(record.Connections,char.DescendantAdded:Connect(function(node)
   if records[player]==record then poseNode(node);watchSize(node);record.SizingDirty=true end
  end))
  player.CameraMinZoomDistance=10;player.CameraMaxZoomDistance=60
  if old then for _,c in ipairs(old.Connections) do c:Disconnect() end;old.Bike:Destroy() end
  return record
 end
 function api.setStateSink(callback:any) stateSink=callback end
 local function maxSpeed(player:Player,r:any):number
  local snap=data.snapshot(player)
  return Progression.islandSpeed(if snap then snap.Energy else 0,Content.Vehicles[r.VehicleId].Speed,player:GetAttribute("SlowMode")==true)
 end
 function api.auto(player:Player,input:any)
  local r=records[player];if not r then return end
  local changed=(r.Auto~=nil)~=(input~=nil)
  r.Auto=input;player:SetAttribute("AutoDriving",input~=nil)
  if changed then r.Queue={};r.LastCommand=nil;r.Speed=0;r.State.Speed=0 end
 end
 local function sendState(player:Player,r:any)
  if not r.State then return end
  r.Ack=(r.Ack or 0)+1
  stateSink(player,{Ack=r.Ack,Epoch=r.Epoch,Sequence=r.Processed,State=table.clone(r.State),Mode=r.Mode,Auto=r.Auto~=nil,VehicleId=r.VehicleId,MaxSpeed=maxSpeed(player,r)})
 end
 function api.input(player:Player,payload:any):boolean
  if player.Parent~=Players or not gate:allow(player) or not Protocol.validDrive(payload) then return false end
  local r=records[player]
  if not r or r.Mode~="Manual" or player:GetAttribute("Racing")==true or not data.snapshot(player) then return false end
  if payload.Epoch~=nil and payload.Epoch~=r.Epoch or payload.Sequence<=(sequence[player] or 0) or #r.Queue>=Config.Bike.QueueLimit then return false end
  sequence[player]=payload.Sequence;player:SetAttribute("DriveSequence",payload.Sequence)
  table.insert(r.Queue,{Throttle=payload.Throttle,Steer=payload.Steer,Brake=payload.Brake,JumpId=payload.JumpId or r.State.JumpId,Sequence=payload.Sequence})
  r.Input.At=os.clock()
  return true
 end
 function api.onBelt(player:Player,zone:BasePart):boolean
  local r=records[player]
  if not r or r.Mode~="Manual" then return false end
  local relative=zone.CFrame:ToObjectSpace(CFrame.new(r.State.X,r.State.Y,r.State.Z)*CFrame.Angles(0,r.State.Yaw,0))
  local _,yaw=relative:ToEulerAnglesYXZ()
  local state=table.clone(r.State);state.X=relative.Position.X;state.Y=relative.Position.Y;state.Z=relative.Position.Z;state.Yaw=yaw
  return Sim.onBelt(state,0,0,0,zone.Size.X,zone.Size.Z)
 end
 function api.race(player:Player):any
  local record=api.ensure(player);assert(record,"Mounted rider unavailable")
  record.Mode="Race";record.Queue={};record.Speed=0;record.Input={Throttle=0,Steer=0,Brake=true,At=0}
  sendState(player,record)
  return record
 end
 function api.move(record:any,cf:CFrame,speed:number,distance:number)
  record.Frame=cf
  record.Rig.Root.CFrame=cf
  record.Rig.Root.AssemblyLinearVelocity=Vector3.zero;record.Rig.Root.AssemblyAngularVelocity=Vector3.zero
  record.Distance=distance
  record.Bike:SetAttribute("RaceSpeed",speed);record.Bike:SetAttribute("Distance",distance)
 end
 function api.teleport(player:Player,cf:CFrame):boolean
  local record=api.ensure(player);if not record or record.Mode~="Manual" or player:GetAttribute("Racing")==true or not data.snapshot(player) then return false end
  record.Speed=0;local _,yaw=cf:ToEulerAnglesYXZ();record.Yaw=yaw
  local scene=Surface.new(workspace,{record.Character,folder},6)
  local floor=scene.floor(cf.Position.X,cf.Position.Y,cf.Position.Z)
  if floor and math.abs(cf.Position.Y-floor-.05)<=Config.Bike.StepHeight then cf=CFrame.new(cf.Position.X,floor+.05,cf.Position.Z)*CFrame.Angles(0,yaw,0) end
  record.State=Sim.new(cf.Position.X,cf.Position.Y,cf.Position.Z,yaw)
  record.State.Distance=record.Distance;record.State.JumpId=player:GetAttribute("DriveJumpId") or 0;record.Queue={};record.LastCommand=nil
  record.Input={Throttle=0,Steer=0,Brake=true,At=0};record.CommandPhase=0
  epoch[player]=(epoch[player] or 0)+1;record.Epoch=epoch[player];record.Processed=sequence[player] or 0
  player:SetAttribute("DriveEpoch",record.Epoch)
  api.move(record,cf,0,record.Distance)
  local serial=player:GetAttribute("BikeTeleportSerial")
  player:SetAttribute("BikeTeleportSerial",if type(serial)=="number" then serial+1 else 1)
  sendState(player,record)
  return true
 end
 -- Takes only a stable catalogue ID. Positions come exclusively from registered server world objects.
 function api.trainTeleport(player:Player,id:number):(boolean,string?)
  if type(id)~="number" or id%1~=0 or id<1 or id>Config.Rules.TreadmillCount then return false,"BadRequest" end
  local zone=trainingZones[id]
  if not zone or not zone:IsDescendantOf(workspace) or not Catalog.Treadmills[id] then return false,"TreadmillUnavailable" end
  if zone.Size.X<4.8 or zone.Size.Z<8 or zone.CFrame.UpVector.Y<.9999 then return false,"TrainingPositionBlocked" end
  local profile=data.context(player)
  if not Access.allowed(profile,id,zone:GetAttribute("VIPOnly")==true or Catalog.Treadmills[id].VIPOnly==true,hasVIP(player)) then return false,"Locked" end
  local record=api.ensure(player)
  if not record or record.Mode~="Manual" or player:GetAttribute("Racing")==true then return false,"AlreadyRacing" end
  local target=zone.CFrame*CFrame.new(0,.05,0)
  local scene=Surface.new(workspace,{record.Character,folder},math.max(5.8,record.Offset.Position.Y+record.Root.Size.Y+1))
  local p=target.Position;local _,yaw=target:ToEulerAnglesYXZ()
  for _,value in ipairs({p.X,p.Y,p.Z,yaw}) do if value~=value or math.abs(value)>1e6 then return false,"TrainingPositionBlocked" end end
  local floor,normal=scene.floor(p.X,p.Y,p.Z)
  if not floor or not normal or normal<Config.Bike.MinGroundNormal or math.abs(p.Y-floor-.05)>.25 or not scene.clear(p.X,p.Y,p.Z,yaw) then return false,"TrainingPositionBlocked" end
  if not api.teleport(player,target) or not api.onBelt(player,zone) then return false,"TrainingPositionBlocked" end
  return true,nil
 end
 function api.finish(player:Player,record:any,reason:string)
  if records[player]~=record then return end
  record.Mode="Manual";record.Speed=0;record.Yaw=0;record.Input={Throttle=0,Steer=0,Brake=true,At=0}
  if player.Character==record.Character and record.Root.Parent and record.Humanoid.Health>0 and reason~="Disconnect" and reason~="Shutdown" then
   epoch[player]=(epoch[player] or 0)+1;record.Epoch=epoch[player];player:SetAttribute("DriveEpoch",record.Epoch)
   record.Queue={};record.Processed=sequence[player] or 0
   record.State=Sim.new(0,8.05,50,0);record.State.Distance=record.Distance;record.State.JumpId=player:GetAttribute("DriveJumpId") or 0
   api.move(record,CFrame.new(0,8.05,50),0,record.Distance);seated(record);sendState(player,record)
  end
 end
 function api.tick(dt:number):boolean
  local ran=false
  for _,player in ipairs(Players:GetPlayers()) do
   local record=api.ensure(player)
   if not record then if records[player] then drop(player) end;continue end
   if record.Mode~="Manual" or player:GetAttribute("Racing")==true then continue end
   record.Humanoid.Sit=true;record.Humanoid.Jump=false;record.Humanoid.WalkSpeed=0;record.Humanoid.AutoRotate=false;record.Humanoid.PlatformStand=true
   record.Root.Anchored=false;record.Rig.Root.Anchored=true
   record.Humanoid:Move(Vector3.zero,false)
   local height=math.max(5.8,record.Offset.Position.Y+record.Root.Size.Y+1)
   local scene=Surface.new(workspace,{record.Character,folder},height)
   record.CommandPhase=(record.CommandPhase or 0)+1
   if record.CommandPhase>=Config.Bike.CommandSteps then
    record.CommandPhase=0
    local command:any=table.remove(record.Queue,1)
    if command then record.LastCommand=command
    elseif record.LastCommand and os.clock()-record.Input.At<Config.Bike.InputTimeout then command=table.clone(record.LastCommand :: {[string]:any});command.Sequence=nil
    else command={Throttle=0,Steer=0,Brake=true,JumpId=record.State.JumpId} end
    if record.Auto then
     if command.Sequence then record.Processed=command.Sequence end
     record.State.JumpId=math.max(record.State.JumpId,command.JumpId or record.State.JumpId)
     command=record.Auto
    end
    ran=true
    record.State=Sim.command(record.State,command,maxSpeed(player,record),scene)
    if command.Sequence then record.Processed=command.Sequence end
    player:SetAttribute("DriveJumpId",record.State.JumpId)
    record.Speed=record.State.Speed;record.Yaw=record.State.Yaw
    if record.State.Y< -35 then record.Humanoid.Health=0 end
    local training=(player:GetAttribute("SelectedTreadmill") or 0)>0 and record.State.Grounded
    local distance=record.State.Distance
    if training then distance+=10*Config.Bike.InputInterval;record.State.Distance=distance end
    api.move(record,CFrame.new(record.State.X,record.State.Y,record.State.Z)*CFrame.Angles(0,record.State.Yaw,0),if training then 10 else math.abs(record.Speed),distance)
   end
   if os.clock()-record.AckAt>=Config.Bike.AckInterval then record.AckAt=os.clock();sendState(player,record) end
  end
  return ran
 end
 function api.start()
  local function added(player:Player)
   player.CharacterAdded:Connect(function(character)
    -- Freeze as soon as the root exists; the normal movement controller cannot walk away.
    local root=character:WaitForChild("HumanoidRootPart",15)
    if root and root:IsA("BasePart") then root.Anchored=true end
    character:WaitForChild("Humanoid",15)
    if player.Character==character then api.ensure(player) end
   end)
   player.CharacterRemoving:Connect(function() drop(player) end)
   api.ensure(player)
  end
  Players.PlayerAdded:Connect(added);for _,p in ipairs(Players:GetPlayers()) do added(p) end
  Players.PlayerRemoving:Connect(function(player) drop(player);sequence[player]=nil;epoch[player]=nil;gate:remove(player) end)
  task.spawn(function()
   local last=os.clock();local failed=false
   while true do
    task.wait(Config.Bike.Tick);local now=os.clock()
    local ok,err=pcall(api.tick,math.min(now-last,.1));last=now
    if not ok and not failed then warn("[PermanentBike]",tostring(err)) end
    if (not ok or err==true) and failed~=not ok then
     failed=not ok
     local runtime=Rep:FindFirstChild("BikeRuntime")
     if runtime then
      runtime:SetAttribute("BikeState",if failed then "Failed" else "Ready")
      runtime:SetAttribute("BikeError",if failed then (if runtime:GetAttribute("Diagnostics")==true then string.sub(tostring(err),1,600) else "Fahrzeugsteuerung nicht verfügbar") else nil)
     end
    end
   end
  end)
 end
 return api
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="967">
        <Properties>
          <string name="Name">Persistence</string>
          <string name="Source"><![CDATA[--!strict
-- Pure adapter: store, clock, retry wait and session id are injected for deterministic tests.
local Persistence: any = {}
Persistence.__index = Persistence
function Persistence.new(store: any, profile: any, settings: any, sessionId: string, clock: () -> number, waitRetry: (number) -> (), log: ((any) -> ())?): any
 return setmetatable({ store = store, profile = profile, settings = settings,
  sessionId = sessionId, clock = clock, waitRetry = waitRetry, log = log or function() end, sequence = 0, releases = {} }, Persistence)
end
function Persistence.update(self: any, key: string, transform: (any) -> any): (boolean, any)
 local lastError
 for attempt = 1, self.settings.Attempts do
  local ok, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
  if ok then return true, result end
  lastError = result
  self.log({ Event = "DataStoreRetry", Key = key, Attempt = attempt, Attempts = self.settings.Attempts, Error = tostring(result) })
  if attempt < self.settings.Attempts then self.waitRetry(attempt) end
 end
 return false, tostring(lastError)
end
function Persistence.load(self: any, key: string): (any, string?, number?)
 local ok, record = self:update(key, function(old: any): any
  if old == nil then old = { Data = self.profile.new() } end
  -- Reject corrupt/future schemas; never silently replace existing data with defaults.
  if type(old) ~= "table" then return nil end
  local migrated=self.profile.migrate(old.Data)
  if not migrated then return nil end
  if old.Lock ~= nil then
   if type(old.Lock) ~= "table" or type(old.Lock.Id) ~= "string" or type(old.Lock.Expires) ~= "number"
    or old.Lock.Expires ~= old.Lock.Expires or old.Lock.Expires == math.huge or old.Lock.Expires < 0 then return nil end
   if old.Lock.Id ~= self.sessionId and old.Lock.Expires > self.clock() then return nil end
  end
  return { Data = self.profile.copy(migrated), Lock = { Id = self.sessionId, Expires = self.clock() + self.settings.LeaseSeconds } }
 end)
 if not ok then return nil, "DataStoreUnavailable" end
 if type(record) ~= "table" or not record.Lock or record.Lock.Id ~= self.sessionId then return nil, "LockedOrInvalidProfile" end
 return self.profile.copy(record.Data), nil, record.Lock.Expires
end
function Persistence.save(self: any, key: string, data: any, release: boolean): (boolean, string?, number?)
 if not self.profile.validate(data) then return false, "InvalidProfile", nil end
 self.sequence += 1
 local pending = if release then self.releases[key] else nil
 local writeId = if pending then pending.WriteId else self.sessionId .. ":" .. tostring(self.sequence)
 local snapshot = if pending then pending.Data else self.profile.copy(data)
 if release then self.releases[key] = { WriteId = writeId, Data = snapshot } end
 local ok, result = self:update(key, function(old: any): any
  -- A committed release whose response was lost is safe to acknowledge again.
  if release and type(old) == "table" and old.WriteId == writeId and old.Lock == nil then return old end
  if type(old) ~= "table" or type(old.Lock) ~= "table" or old.Lock.Id ~= self.sessionId
   or old.Lock.Expires <= self.clock() then return nil end
  return { Data = snapshot, WriteId = writeId, Lock = if release then nil else { Id = self.sessionId, Expires = self.clock() + self.settings.LeaseSeconds } }
 end)
 if not ok then return false, "DataStoreUnavailable", nil end
 if release then self.releases[key] = nil end
 if result == nil then return false, "SessionLost", nil end
 return true, nil, if release then 0 else result.Lock.Expires
end
return Persistence
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="968">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Profile = require(Shared:WaitForChild("Profile"))
local Persistence = require(script.Parent.Persistence)
local SavePolicy = require(script.Parent.SavePolicy)
local shutdownDeadline = math.huge
local options:any={}
local started=false
local statuses: {[Player]:string}={}
local StudioStore=require(script.Parent.StudioStore)
local previewStore:any=nil
local function log(event: any)
 warn("[BikeData] " .. HttpService:JSONEncode(event))
end
local function newBackend()
 local store=if options.Preview then previewStore else DataStoreService:GetDataStore(options.StoreName or Config.Data.Store)
 return Persistence.new(store, Profile, Config.Data,
  game.JobId .. ":" .. HttpService:GenerateGUID(false), os.time, function(attempt: number) task.wait(attempt * 2) end, log)
end
local Service = {}
function Service.configure(value:any)
 assert(not started,"Data service already started")
 options=value
 if options.Preview then previewStore=StudioStore.new() end
end
function Service.status(player:Player):string return statuses[player] or "Loading" end
type Session = { Data: Profile.Data, Expires: number, Saving: boolean, Backend: any, Closing: boolean, Revision: number, InventoryRevision: number, PendingReceipt: boolean? }
local sessions: {[Player]: Session} = {}
local closing = false
local loading = 0
local function key(player: Player): string return "Player_" .. player.UserId end
local function save(player: Player, release: boolean)
 local session = sessions[player]
 if not session then return end
 if release then session.Closing = true end
 -- Serialize all writes, including leave during an autosave.
 while session.Saving and os.time() < math.min(session.Expires, shutdownDeadline) do task.wait() end
 if session.Saving then return end
 if sessions[player] ~= session then return end
 session.Saving = true
 local ok, reason = SavePolicy.flush(session, key(player), release, function() return shutdownDeadline end, os.time,
  function() task.wait(2) end, log)
 session.Saving = false
 if ok then session.PendingReceipt=nil end
 if ok and release or not ok and reason ~= "DataStoreUnavailable" then
  sessions[player] = nil
  if not ok then
   log({ Event = "ProfileRecoveryExhausted", UserId = player.UserId, Reason = reason })
   warn("Profile save failed", player.UserId, reason)
   player:Kick("Deine Daten konnten nicht sicher gespeichert werden. Bitte später erneut verbinden.")
  end
 end
end
function Service.snapshot(player: Player): Profile.Snapshot?
 local session = sessions[player]
 if closing or not session or session.Closing or session.Expires <= os.time() then return nil end
 return Profile.snapshot(session.Data)
end
-- Trusted server callbacks only; copy/validate/commit forms a single synchronous transaction.
function Service.change(player: Player, transform: (Profile.Data) -> boolean, inventory: boolean?): (boolean, string?)
 local session = sessions[player]
 if closing or not session or session.Closing or player.Parent ~= Players or session.Expires <= os.time() then return false, "NotReady" end
 if session.Saving or session.PendingReceipt then return false, "Saving" end
 local revision = session.Revision
 local candidate = Profile.copy(session.Data)
 local ok, accepted = pcall(transform, candidate)
 if not ok then log({ Event = "TransactionError", UserId = player.UserId }); return false, "InternalError" end
 if not accepted then return false, "Rejected" end
 if not Profile.validate(candidate) then return false, "InvalidProfile" end
 if sessions[player] ~= session or closing or session.Closing or session.Saving or session.Revision ~= revision or session.Expires <= os.time() then return false, "NotReady" end
 session.Data = candidate
 session.Revision += 1
 if inventory then session.InventoryRevision+=1 end
 return true, nil
end
-- Durable single-profile receipt transaction; no grant acknowledgement before UpdateAsync succeeds.
function Service.receipt(player:Player,transform:(Profile.Data)->boolean):boolean
 local session=sessions[player]
 if closing or not session or session.Closing or session.Saving or player.Parent~=Players or session.Expires<=os.time() then return false end
 local candidate=Profile.copy(session.Data)
 local accepted,result=pcall(transform,candidate)
 if not accepted or not result or not Profile.validate(candidate) then return false end
 session.Saving=true
 -- Keep this identical receipt-marked candidate even if the response is lost. No rollback/re-grant.
 session.Data=candidate;session.Revision+=1;session.InventoryRevision+=1;session.PendingReceipt=true
 local ok,reason,expires=session.Backend:save(key(player),candidate,false)
 if ok then session.Expires=expires;session.PendingReceipt=nil
 else log({Event="ReceiptSavePending",UserId=player.UserId,Reason=reason}) end
 session.Saving=false
 return ok
end
function Service.revision(player: Player): number
 local session=sessions[player];return if session then session.Revision else 0
end
function Service.inventoryRevision(player: Player): number
 local session=sessions[player];return if session then session.InventoryRevision else 0
end
function Service.read(player: Player): Profile.Data?
 local session=sessions[player]
 if closing or not session or session.Closing or session.Expires<=os.time() then return nil end
 return Profile.copy(session.Data)
end
-- Small server-only view for automation/boost snapshots; never clone 500 pets/2000 receipts at 4–5Hz.
function Service.context(player:Player):any
 local session=sessions[player]
 if closing or not session or session.Closing or session.Expires<=os.time() then return nil end
 local value=session.Data
 return {Energy=value.Energy,Rebirths=value.Rebirths,OwnedWorlds=table.clone(value.OwnedWorlds),Boosts=table.clone(value.Boosts)}
end
function Service.ownsVehicle(player: Player, id: number): boolean
 local session=sessions[player]
 return not closing and session~=nil and not session.Closing and session.Expires>os.time() and table.find(session.Data.OwnedVehicles,id)~=nil
end
function Service.start()
 assert(not started,"Data service started twice");started=true
 local function added(player: Player)
  if closing then return end
  loading += 1
  statuses[player]="Loading"
  local created,backend=pcall(newBackend)
  if not created then
   loading-=1;statuses[player]="DataStoreInitializationFailed"
   log({Event="DataStoreInitializationFailed",UserId=player.UserId,Error=tostring(backend)})
   player:Kick("Datenspeicher konnte nicht initialisiert werden. In Studio: StudioPreviewData aktivieren oder separate Test-Experience konfigurieren.")
   return
  end
  local data, reason, expires = backend:load(key(player))
  if not data then
   loading -= 1
   statuses[player]=reason or "LoadFailed"
   warn("Profile load rejected", player.UserId, reason)
   player:Kick("Spielerdaten sind momentan nicht verfügbar. Bitte später erneut versuchen.")
   return
  end
  if closing or player.Parent ~= Players then
   local orphan = { Data = data, Expires = expires, Backend = backend }
   SavePolicy.flush(orphan, key(player), true, function() return shutdownDeadline end, os.time, function() task.wait(2) end, log)
   loading -= 1
   return
  end
  sessions[player] = { Data = data, Expires = expires, Saving = false, Backend = backend, Closing = false, Revision = 0, InventoryRevision = 0 }
  statuses[player]=if options.Preview then "StudioPreviewReady" else "Ready"
  loading -= 1
 end
 Players.PlayerAdded:Connect(added)
 Players.PlayerRemoving:Connect(function(player) save(player, true);statuses[player]=nil end)
 for _, player in ipairs(Players:GetPlayers()) do task.spawn(added, player) end
 task.spawn(function()
  while not closing do
   task.wait(Config.Data.AutosaveSeconds)
   if closing then break end
   for player in pairs(sessions) do task.spawn(save, player, false) end
  end
 end)
 -- Stop serving a profile as soon as its lease expires, even if a save is yielding.
 task.spawn(function()
  while not closing do
   task.wait(1)
   for player, session in pairs(sessions) do
    if session.Expires <= os.time() then player:Kick("Datensitzung abgelaufen. Bitte erneut verbinden.") end
   end
  end
 end)
 game:BindToClose(function()
  closing = true
  shutdownDeadline = os.time() + 24
  local pending = 0
  for player in pairs(sessions) do
   pending += 1
   task.spawn(function() save(player, true); pending -= 1 end)
  end
  local deadline = os.clock() + 25
  while (pending > 0 or loading > 0) and os.clock() < deadline do task.wait(0.1) end
  if pending > 0 or loading > 0 then warn("Shutdown save deadline reached; remaining locks expire automatically") end
 end)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="969">
        <Properties>
          <string name="Name">PremiumService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Market=game:GetService("MarketplaceService")
local Http=game:GetService("HttpService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared:WaitForChild("PremiumConfig"))
local Rules=require(Shared:WaitForChild("PremiumRules"))
local Service={}
function Service.new(data:any):any
 assert(Rules.registryValid(Config),"Invalid/duplicate Roblox product or pass IDs in PremiumConfig")
 local owned:{[Player]:{[string]:boolean}}={}
 local checked:{[Player]:number}={}
 local api:any={}
 function api.entitled(player:Player,kind:string):boolean return owned[player]~=nil and owned[player][kind]==true end
 function api.bonus(player:Player,profile:any,kind:string):number
  return Rules.bonus(profile,kind,owned[player] and owned[player][kind])
 end
 function api.receipt(receipt:any):any
  if type(receipt)~="table" or type(receipt.PlayerId)~="number" or type(receipt.PurchaseId)~="string" then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local player=Players:GetPlayerByUserId(receipt.PlayerId)
  local product=Rules.product(receipt.ProductId)
  if not player or not product or data.status(player)=="StudioPreviewReady" then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local saved=data.receipt(player,function(profile:any):boolean
   return Rules.grant(profile,receipt.PurchaseId,receipt.ProductId,product,Http:GenerateGUID(false))
  end)
  return if saved then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
 end
 function api.prompt(player:Player,key:string): (boolean,string?)
  local pass=Config.Passes[key];local product=Config.Products[key]
  local def=pass or product
  if not def or def.Id<=0 or def.Unavailable or not data.snapshot(player) or data.status(player)=="StudioPreviewReady" then return false,"ProductUnavailable" end
  local profile=data.read(player)
  if not profile then return false,"NotReady" end
  if product then
   local receipts=0;for _ in pairs(profile.Receipts) do receipts+=1 end
   if receipts>=Config.ReceiptLimit then return false,"ProductUnavailable" end
   if product.Cash and (profile.Cash+product.Cash)-profile.Cash~=product.Cash then return false,"ProductUnavailable" end
   if product.ExclusiveId then local count=0;for _ in pairs(profile.Pets) do count+=1 end;if count>=500 then return false,"InventoryFull" end end
   if product.Boost and profile.Boosts[product.Boost]+product.Seconds>Config.MaxBoostSeconds then return false,"ProductUnavailable" end
  end
  local ok=pcall(function()
   if pass then Market:PromptGamePassPurchase(player,def.Id) else Market:PromptProductPurchase(player,def.Id) end
  end)
  return ok,if ok then nil else "ServiceUnavailable"
 end
 local function check(player:Player)
  if checked[player] and os.clock()-checked[player]<5 then return end
  checked[player]=os.clock();local flags=owned[player] or {};owned[player]=flags
  for kind,pass in pairs(Config.Passes) do
   if pass.Id>0 and not pass.Unavailable then
    local ok,result=pcall(function() return Market:UserOwnsGamePassAsync(player.UserId,pass.Id) end)
    if player.Parent~=Players then return end
    flags[kind]=ok and result==true
    if not ok then warn("[Premium] Gamepass check failed",player.UserId,kind) end
   end
  end
 end
 function api.start()
  Market.ProcessReceipt=api.receipt
  Players.PlayerAdded:Connect(function(player) task.spawn(check,player) end)
  Players.PlayerRemoving:Connect(function(player) owned[player]=nil;checked[player]=nil end)
  Market.PromptGamePassPurchaseFinished:Connect(function(player,id,_purchased)
   -- Do not trust a client callback as ownership. Re-query Marketplace even after the prompt.
   if player.Parent==Players then checked[player]=nil;task.spawn(check,player) end
  end)
  for _,player in ipairs(Players:GetPlayers()) do task.spawn(check,player) end
  task.spawn(function()
   local last=os.clock()
   while true do
    task.wait(1);local now=os.clock();local elapsed=math.min(2,math.max(0,now-last));last=now
    for _,player in ipairs(Players:GetPlayers()) do
     local profile=data.context(player)
     if profile and profile.Boosts and (profile.Boosts.Energy>0 or profile.Boosts.Cash>0) then
      data.change(player,function(candidate:any):boolean
       for _,kind in ipairs({"Energy","Cash"}) do candidate.Boosts[kind]=math.max(0,candidate.Boosts[kind]-elapsed) end
       return true
      end)
     end
     if not checked[player] or now-checked[player]>=60 then task.spawn(check,player) end
    end
   end
  end)
 end
 return api
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="970">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared:WaitForChild("Config"))
local Course=require(Shared:WaitForChild("RaceCourse"))
local Logic=require(Shared:WaitForChild("RaceController"))
local BikeRig=require(Shared:WaitForChild("BikeRig"))
local RaceRules=require(Shared:WaitForChild("RaceRules"))
local Http=game:GetService("HttpService")
local Race={}
function Race.new(data:any,stopTraining:(Player)->(),feedback:(Player,any)->(),mounts:any):any
 local prototype=game:GetService("ReplicatedStorage"):WaitForChild("Vehicles"):WaitForChild("Mountainbike") :: Model
 local bikes=Instance.new("Folder");bikes.Name="ActiveRaceBikes";bikes.Parent=workspace
 local adapter:any={}
 function adapter.profile(player:Player):any
  local profile=if data.read then data.read(player) else data.snapshot(player)
  if not profile or not data.ownsVehicle(player,1) then return nil end
  return {Energy=profile.Energy,OwnedVehicles=profile.OwnedVehicles or {1},ActiveVehicle=profile.ActiveVehicle or 1}
 end
 local function character(player:Player): (BasePart?,Humanoid?)
  local model=player.Character
  local root=if model then model:FindFirstChild("HumanoidRootPart") else nil
  local hum=if model then model:FindFirstChildOfClass("Humanoid") else nil
  return if root and root:IsA("BasePart") then root else nil,hum
 end
 function adapter.nearStart(player:Player):boolean
  local root,hum=character(player)
  return root~=nil and hum~=nil and hum.Health>0 and (root.Position-Vector3.new(0,11,63)).Magnitude<=16
 end
 function adapter.begin(player:Player,state:any)
  stopTraining(player)
  local root,hum=character(player);assert(root and hum,"Missing rider")
  state.Character=player.Character;state.Root=root;state.Humanoid=hum;state.Lane=0
  state.RewardId=if state.Difficulty=="Test" then "test" else Http:GenerateGUID(false)
  local mounted=mounts.race(player);state.Mount=mounted;state.Bike=mounted.Bike;state.Rig=mounted.Rig;state.VisualStart=mounted.Distance
  state.BotModels={}
  for i,bot in ipairs(state.Bots) do
   local botAsset=game:GetService("ReplicatedStorage"):WaitForChild("Vehicles"):FindFirstChild("Vehicle2") or prototype
   local model=botAsset:Clone();table.insert(state.BotModels,model)
   local rig=BikeRig.prepare(model);model.Name="Bot_"..player.UserId.."_"..i;model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic;model:SetAttribute("RaceOwnerUserId",player.UserId)
   model:SetAttribute("RaceSpeed",0);model:SetAttribute("Distance",0);model:SetAttribute("Bot",true)
   model.Parent=bikes;bot.Rig=rig;bot.Model=model;bot.Lane=({-8,-5,-2,3,7})[i]
  end
  player:SetAttribute("Racing",true)
  hum.AutoRotate=false;hum.WalkSpeed=0;hum.PlatformStand=true
  adapter.move(player,state,Course.sample(0))
  feedback(player,{Kind="RaceStarted",RaceId=state.Id})
 end
 function adapter.reward(player:Player,state:any): (boolean,number)
  local amount=0
  if mounts.cashPass then state.CashPass=mounts.cashPass(player) end
  local ok=data.change(player,function(profile:any):boolean
   local accepted
   accepted,amount=RaceRules.pay(profile,state)
   return accepted
  end)
  return ok,amount
 end
 function adapter.valid(player:Player,state:any):boolean
  return player.Parent==Players and player.Character==state.Character and state.Humanoid and state.Humanoid.Health>0
   and state.Root and state.Root.Parent~=nil and state.Bike and state.Bike.Parent~=nil and state.Mount.Mode=="Race" and data.snapshot(player)~=nil
 end
 function adapter.move(player:Player,state:any,point:any)
  local position=Vector3.new(point.X+point.DZ*state.Lane,point.Y,point.Z-point.DX*state.Lane)
  local cf=CFrame.lookAt(position,position+Vector3.new(point.DX,point.DY or 0,point.DZ))
  mounts.move(state.Mount,cf,state.Speed,state.VisualStart+state.Distance)
  for _,bot in ipairs(state.Bots) do
   local p=Course.sample(bot.Distance);local pos=Vector3.new(p.X+p.DZ*bot.Lane,p.Y,p.Z-p.DX*bot.Lane)
   bot.Rig.Root.CFrame=CFrame.lookAt(pos,pos+Vector3.new(p.DX,p.DY or 0,p.DZ))
   bot.Model:SetAttribute("RaceSpeed",if state.Phase=="Countdown" or bot.FinishedAt then 0 else bot.Speed);bot.Model:SetAttribute("Distance",bot.Distance)
  end
 end
 function adapter.cleanup(player:Player,state:any,reason:string)
  local ok,err=pcall(function() if state.Mount then mounts.finish(player,state.Mount,reason) end end)
  if state.Root and not state.Root.Parent and reason~="Disconnect" and reason~="Shutdown" and player.Parent==Players and player.Character==state.Character and state.Humanoid.Health>0 then
   task.defer(function()
    if player.Parent==Players and player.Character==state.Character then
     local spawned,spawnError=pcall(function() player:LoadCharacterAsync() end)
     if not spawned then warn("[RaceRespawn]",player.UserId,tostring(spawnError)) end
    end
   end)
  end
  for _,model in ipairs(state.BotModels or {}) do model:Destroy() end
  player:SetAttribute("Racing",false)
  if player.Parent==Players then feedback(player,{Kind="RaceEnded",Reason=reason,RaceId=state.Id,Place=state.Place,Reward=state.Reward,Difficulty=state.Difficulty}) end
  if not ok then warn("[RaceRestore]",player.UserId,tostring(err)) end
 end
 function adapter.log(event:string,err:string) warn("[Race]",event,err) end
 local controller=Logic.new(adapter,os.clock)
 local api:any={}
 function api.active(player:Player):boolean return controller.States[player]~=nil end
 function api.start(player:Player,difficulty:string?): (boolean,string?) return controller:start(player,difficulty) end
 function api.abort(player:Player) controller:finish(player,"Aborted") end
 function api.snapshot(player:Player):any
  local state=controller.States[player]
  return {Phase=if state then state.Phase else "Idle",Progress=if state then state.Distance/Course.Length else 0,
   Countdown=if state then math.max(0,Config.Race.Test.Countdown-math.floor(os.clock()-state.Started)) else 0,Speed=if state then state.Speed else 0,Place=if state then RaceRules.position(state) else 0,Difficulty=if state then state.Difficulty else "Easy",Opponents=if state then #state.Bots else 5}
 end
 function api.run()
  Players.PlayerRemoving:Connect(function(player) controller:remove(player) end)
  local function added(player:Player) player.CharacterRemoving:Connect(function() controller:finish(player,"Aborted") end) end
  Players.PlayerAdded:Connect(added);for _,p in ipairs(Players:GetPlayers()) do added(p) end
  local zone=workspace:WaitForChild("World1"):WaitForChild("RacePreview"):WaitForChild("Platform")
  local prompt=Instance.new("ProximityPrompt");prompt.Name="StartTestRace";prompt.ActionText="Easy-Rennen starten";prompt.ObjectText="5 Bots • Cash gewinnen"
  prompt.MaxActivationDistance=12;prompt.HoldDuration=0.5;prompt.Parent=zone
  -- Runtime installs the shared limiter handler; prompts cannot bypass it.
  prompt.Triggered:Connect(function(player) if api.request then api.request(player) end end)
  task.spawn(function() while true do task.wait(1/15);controller:tick() end end)
  game:BindToClose(function() for p in pairs(controller.States) do controller:finish(p,"Shutdown") end end)
 end
 return api
end
return Race
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="971">
        <Properties>
          <string name="Name">RemoteService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Protocol = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Protocol"))
local RemoteService = {}
function RemoteService.start(gameplay: any)
 local folder = Instance.new("Folder")
 folder.Name = Config.Network.Folder
 local remotes: {[string]: any} = {}
 for name, className in pairs(Protocol.Remotes) do
  local remote = Instance.new(className)
  remote.Name = name
  remote.Parent = folder
  remotes[name] = remote
 end
 gameplay.setDriveState(function(player:Player,state:any) remotes.DriveState:FireClient(player,state) end)
 gameplay.setFeedback(function(player:Player,event:any) remotes.Feedback:FireClient(player,event) end)
 remotes.Drive.OnServerEvent:Connect(function(player:Player,payload:any) gameplay.drive(player,payload) end)
 local lastRequest: {[Player]: number} = {}
 remotes.GetSnapshot.OnServerInvoke = function(player: Player, payload: any): any
  if player.Parent~=Players then return {Ok=false,Error="NotReady"} end
  local now, previousRequest = os.clock(), lastRequest[player]
  if previousRequest and now - previousRequest < Config.Network.SnapshotCooldown then return { Ok=false, Error="RateLimited" } end
  lastRequest[player] = now
  if not Protocol.validRequest(payload) then return { Ok=false, Error="BadRequest" } end
  local snapshot = gameplay.snapshot(player,true)
  return if snapshot then {Ok=true,Data=snapshot} else {Ok=false,Error=gameplay.status(player)}
 end
 local lastFeedback: {[Player]: number} = {}
 local previous: {[Player]: any} = {}
 remotes.Action.OnServerEvent:Connect(function(player: Player, payload: any)
  local ok, reason = gameplay.handle(player, payload)
  -- No amplification: silently drop floods, throttle negative feedback too.
  if reason == "RateLimited" then return end
  if not ok and lastFeedback[player] and os.clock() - (lastFeedback[player] or 0) < 0.5 then return end
  lastFeedback[player] = os.clock()
  local actionName=if type(payload)=="table" and type(payload.Action)=="string" and #payload.Action<=20 then payload.Action else ""
  if ok and (actionName=="EquipBest" or actionName=="UnequipAll" or actionName=="EquipPet" or actionName=="UnequipPet" or actionName=="Hatch") then
   local snapshot=gameplay.snapshot(player,true)
   if snapshot then previous[player]=snapshot;remotes.SnapshotChanged:FireClient(player,snapshot) end
  end
  remotes.ActionResult:FireClient(player, {Ok=ok,Error=reason,Action=actionName})
 end)
 Players.PlayerRemoving:Connect(function(player) lastRequest[player]=nil;lastFeedback[player]=nil;previous[player]=nil end)
 -- SnapshotChanged and ActionResult deliberately have no OnServerEvent handlers.
 folder.Parent = ReplicatedStorage
 task.spawn(function()
  while true do
   task.wait(0.25)
   for _, player in ipairs(Players:GetPlayers()) do
    local snapshot, old = gameplay.snapshot(player), previous[player]
    if snapshot and (not old or old.Revision~=snapshot.Revision or old.Energy~=snapshot.Energy or old.Cash~=snapshot.Cash or old.Rebirths~=snapshot.Rebirths or old.PremiumEnergy~=snapshot.PremiumEnergy or old.PremiumCash~=snapshot.PremiumCash or old.Automation.Phase~=snapshot.Automation.Phase or old.Automation.AutoTrain~=snapshot.Automation.AutoTrain or old.Automation.AutoRace~=snapshot.Automation.AutoRace or old.Automation.SlowMode~=snapshot.Automation.SlowMode or old.SelectedTreadmill~=snapshot.SelectedTreadmill or old.Race.Phase~=snapshot.Race.Phase or old.Race.Countdown~=snapshot.Race.Countdown or old.Race.Place~=snapshot.Race.Place or math.abs(old.Race.Progress-snapshot.Race.Progress)>0.005) then
     previous[player]=snapshot
     remotes.SnapshotChanged:FireClient(player,snapshot)
    end
   end
  end
 end)
end
return RemoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="972">
        <Properties>
          <string name="Name">SavePolicy</string>
          <string name="Source"><![CDATA[--!strict
-- Injected clocks make disconnect/shutdown recovery testable without Roblox.
local SavePolicy = {}
function SavePolicy.flush(session: any, key: string, release: boolean, deadline: number | (() -> number),
 clock: () -> number, pause: () -> (), log: (any) -> ()): (boolean, string?)
 local function cutoff(): number
  local current = if type(deadline) == "function" then deadline() else deadline
  return math.min(current, session.Expires)
 end
 repeat
  if clock() >= cutoff() then return false, "DeadlineExceeded" end
  local ok, reason, expires = session.Backend:save(key, session.Data, release)
  if ok then
   session.Expires = expires
   return true, nil
  end
  log({ Event = "ProfileSaveFailed", Key = key, Reason = reason, Release = release, LeaseExpires = session.Expires })
  if reason ~= "DataStoreUnavailable" or not release then return false, reason end
  pause()
 until clock() >= cutoff()
 return false, "DeadlineExceeded"
end
return table.freeze(SavePolicy)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="973">
        <Properties>
          <string name="Name">StudioStore</string>
          <string name="Source"><![CDATA[--!strict
-- Explicit Studio preview only. Never a fallback for a failed live DataStore.
local Store={}
function Store.new():any
 local records:any={}
 local function copy(value:any):any
  if type(value)~="table" then return value end
  local result:any={};for key,child in pairs(value) do result[key]=copy(child) end;return result
 end
 return {UpdateAsync=function(_:any,key:string,transform:(any)->any):any
  local nextValue=transform(copy(records[key]))
  if nextValue~=nil then records[key]=copy(nextValue) end
  return copy(nextValue)
 end}
end
return Store
]]></string>
        </Properties>
